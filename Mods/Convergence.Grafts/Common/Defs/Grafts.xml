      <partEfficiency>1.1</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <statOffsets><DrugSynthesisSpeed>0.3</DrugSynthesisSpeed><DrugCookingSpeed>0.3</DrugCookingSpeed><MedicalTendQuality>0.05</MedicalTendQuality><CVG_CelestialDissonance>0.1</CVG_CelestialDissonance></statOffsets>
      </li>
    </stages>
  </HediffDef>

