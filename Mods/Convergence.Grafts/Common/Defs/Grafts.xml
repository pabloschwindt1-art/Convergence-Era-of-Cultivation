  <HediffDef ParentName="AddedBodyPartBase">
    <defName>CVG_Graft_FarmerArm</defName>
    <label>divine farmer's arm</label>
    <labelNoun>a divine farmer's arm</labelNoun>
    <description>Shennong tasted a hundred herbs in a single day to teach mortals which plants heal and which kill. Sects of Jiuxiao say a sliver of his patience lives in the bone grown from the root of a thousand-year spirit tree. The arm knows when a seed wants water before the farmer does.\n\nPlant work +100%, harvest yield +15%.\n\nReplaces the whole arm, hand included.\nCelestial dissonance +0.1.</description>
    <descriptionHyperlinks><ThingDef>CVG_Graft_FarmerArm</ThingDef></descriptionHyperlinks>
    <spawnThingOnRemoved>CVG_Graft_FarmerArm</spawnThingOnRemoved>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1.05</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <statOffsets><PlantWorkSpeed>1.0</PlantWorkSpeed><PlantHarvestYield>0.15</PlantHarvestYield><CVG_CelestialDissonance>0.1</CVG_CelestialDissonance></statOffsets>
      </li>
    </stages>
  </HediffDef>

