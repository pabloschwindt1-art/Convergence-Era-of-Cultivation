<Defs>
  <!-- Part 3 of docs/modulos/DIA_A_DIA.md ("life furniture"): the wuxia version of each vanilla piece, on the same classes. Textures are tinted vanilla; final art Things/Building/CVG/Furniture/<Name>. -->
  <ThingDef ParentName="BedBase">
    <defName>CVG_SectDoubleBed</defName>
    <label>sect double bed</label>
    <description>A wide bed of dark wood for two, with a red quilt for the wedding night and a hard pillow for every other. Dao partners of the Silent Lotus share one bed and one retreat, and say the second is the harder. The headboard carries two carved cranes, as the marriage contracts of Jiuxiao require.</description>
    <graphicData>
      <texPath>Things/Building/CVG/Furniture/SectDoubleBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <designationCategory>Furniture</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.40</fillPercent>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>1800</WorkToBuild>
      <Mass>50</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>4</Beauty>
      <Comfort>0.65</Comfort>
      <BedRestEffectiveness>1</BedRestEffectiveness>
      <ImmunityGainSpeedFactor>1.07</ImmunityGainSpeedFactor>
      <SurgerySuccessChanceFactor>1</SurgerySuccessChanceFactor>
    </statBases>
    <costList>
      <WoodLog>90</WoodLog>
      <Cloth>40</Cloth>
    </costList>
    <building><bed_showSleeperBody>False</bed_showSleeperBody><bed_healPerDay>4</bed_healPerDay></building>
