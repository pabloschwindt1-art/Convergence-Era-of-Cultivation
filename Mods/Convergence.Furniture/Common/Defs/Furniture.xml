  <ThingDef ParentName="BuildingBase">
    <defName>CVG_RitualBrazier</defName>
    <label>ritual brazier</label>
    <description>A bronze brazier where a ritual fire burns. Gives light and warmth and raises the qi concentration of the room a little. Burns wood and needs refueling. Before the Blood Moon Cult learned to burn souls, every sect lit a ritual fire to call its ancestors. The flame in a brazier like this one never goes out at the sound of a prayer, only of a lie.</description>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/CVG/Furniture/RitualBrazier</texPath><drawSize>(1,1)</drawSize>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
    </graphicData>
    <designationCategory>Furniture</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.20</fillPercent>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Mass>8</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>3</Beauty>
      <MeditationFocusStrength>0.0</MeditationFocusStrength>
    </statBases>
    <costList>
      <Steel>20</Steel>
      <WoodLog>20</WoodLog>
    </costList>
    <selectable>true</selectable>
    <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets><CVG_WorkRoomQuality>0.15</CVG_WorkRoomQuality></statOffsets>
        <maxSimultaneous>2</maxSimultaneous>
        <maxDistance>8</maxDistance>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>6.0</fuelConsumptionRate>
        <fuelCapacity>20.0</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0006</fuelConsumptionPerTickInRain>
        <fuelFilter><thingDefs><li>WoodLog</li></thingDefs></fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>10</heatPerSecond>
        <heatPushMaxTemperature>24</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.7</fireSize>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
    </comps>
    <placeWorkers><li>PlaceWorker_GlowRadius</li><li>PlaceWorker_ShowFacilitiesConnections</li></placeWorkers>
    <modExtensions>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>2</qi>
        <element>CVG_Element_Fire</element>
      </li>
    </modExtensions>
  </ThingDef>

