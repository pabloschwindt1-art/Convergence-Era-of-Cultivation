<Defs>

  <ThingDef ParentName="FurnitureBase">
    <defName>CVG_CarvedScreen</defName>
    <label>carved wood screen</label>
    <description>A folding screen of carved wood that breaks up a room and lets the qi flow around it. Raises the qi concentration of the room a little. The screens of the Formless Sword Sect guest hall are carved with the story of Qing Feng splitting a mountain in a single stroke. Guests are expected to read it in silence before speaking to their host.</description>
    <graphicData>
      <texPath>Things/Building/CVG/Furniture/CarvedScreen</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <designationCategory>Furniture</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>42</pathCost>
    <fillPercent>0.20</fillPercent>
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>12</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>6</Beauty>
    </statBases>
    <costList>
      <WoodLog>60</WoodLog>
    </costList>
    <modExtensions>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>2</qi>
        <element>CVG_Element_Wood</element>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="FurnitureBase">
    <defName>CVG_PorcelainVase</defName>
    <label>porcelain vase</label>
    <description>A tall vase of fine blue-and-white porcelain. Calms the room and raises its qi concentration a little. Porcelain fired in the kilns of the mountain temples is said to hold the echo of the last prayer spoken near it. An empty vase is not empty, monks say, it is only listening.</description>
