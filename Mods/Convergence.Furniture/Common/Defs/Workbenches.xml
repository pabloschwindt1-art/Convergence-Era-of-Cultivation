<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Day-to-day, part 2 (docs/modulos/DIA_A_DIA.md): wuxia versions of the everyday vanilla workbenches. Each one copies ALL
    the recipes of its vanilla counterpart (Convergence.DefModExtension_CopyRecipes), including those added by other mods,
    so nothing is lost by building the sect version. No electricity, no industrial research.
    Art: Things/Building/CVG/Bench/<Name>_north/_east/_south (made from the official art source of the vanilla bench).
  -->

  <ThingDef Name="CVG_WuxiaBenchBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <paintable>true</paintable>
    </building>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="CVG_WuxiaBenchBase">
    <defName>CVG_SectKitchen</defName>
    <defaultPlacingRot>South</defaultPlacingRot><!-- el frente del arte es la vista sur: el trabajador queda del lado del frente -->
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <label>sect kitchen</label>
    <description>A brick stove with two iron woks and a chopping counter, fed with firewood. It cooks everything a stove cooks. Every sect has a kitchen before it has a library: the old masters said that a disciple who eats badly cultivates badly, and the cooks of the Heavenly Cauldron Pavilion were feared more than its elders.</description>
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/CVG/Bench/SectKitchen</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3,3)</drawSize>
    </graphicData>
    <constructEffect>ConstructDirt</constructEffect>
    <costList>
      <Steel>50</Steel>
    </costList>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.5</Flammability>
    </statBases>
    <uiOrder>2111</uiOrder>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li MayRequire="prospero1088.convergence.furniture">CVG_GrainJar</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>160.0</fuelConsumptionRate>
        <fuelCapacity>50.0</fuelCapacity>
        <fuelFilter><thingDefs><li>WoodLog</li></thingDefs></fuelFilter>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>3</heatPerSecond>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(255,180,90,0)</glowColor>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CopyRecipes"><from><li>FueledStove</li></from></li>
    </modExtensions>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="CVG_WuxiaBenchBase">
    <defName>CVG_ButcherBlock</defName>
    <defaultPlacingRot>South</defaultPlacingRot><!-- el frente del arte es la vista sur: el trabajador queda del lado del frente -->
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <label>butcher's block</label>
    <description>A thick slab of ironwood with a rack of cleavers, scored by ten thousand cuts. It butchers every creature a butcher table can, spirit beasts included. Butchers of the beast-taming sects learn where the meridians run before they learn to cut, so that the qi of the beast stays in the meat.</description>
    <graphicData>
      <texPath>Things/Building/CVG/Bench/ButcherBlock</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3,3)</drawSize>
    </graphicData>
    <costStuffCount>75</costStuffCount>
    <costList><WoodLog>20</WoodLog></costList>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-15</Cleanliness>
    </statBases>
    <uiOrder>2101</uiOrder>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CopyRecipes"><from><li>TableButcher</li></from></li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="CVG_WuxiaBenchBase">
    <defName>CVG_StonecutterWorkshop</defName>
    <defaultPlacingRot>South</defaultPlacingRot><!-- el frente del arte es la vista sur: el trabajador queda del lado del frente -->
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <label>stonecutter's workshop</label>
    <description>A heavy stone bench with chisels, mallets and a water-fed saw. It cuts every stone an ordinary stonecutter cuts, the rocks of Jiuxiao included. The masons who built the floating stairs of Jiuxiao said that every stone has a grain, and that a good cut follows it like a river follows its bed.</description>
    <thingClass>Building_WorkTable_HeatPush</thingClass>
    <graphicData>
      <texPath>Things/Building/CVG/Bench/StonecutterWorkshop</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3,3)</drawSize>
    </graphicData>
    <costStuffCount>75</costStuffCount>
    <costList><WoodLog>30</WoodLog></costList>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-5</Cleanliness>
    </statBases>
    <uiOrder>2301</uiOrder>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <building>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <researchPrerequisites><li>Stonecutting</li></researchPrerequisites>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CopyRecipes"><from><li>TableStonecutter</li></from></li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="CVG_WuxiaBenchBase">
    <defName>CVG_JadeCarvingTable</defName>
    <defaultPlacingRot>South</defaultPlacingRot><!-- el frente del arte es la vista sur: el trabajador queda del lado del frente -->
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <label>jade carver's table</label>
    <description>A low lacquered table with carving knives, jade dust bowls and a lamp on a long arm. Everything made on an art bench can be made here: statues, reliefs, the small jade beasts that sect elders give their favourite disciples. Legend says the first jade carver of the old courts carved a dragon so perfect it flew away the night it was finished.</description>
    <graphicData>
      <texPath>Things/Building/CVG/Bench/JadeCarvingTable</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3,3)</drawSize>
    </graphicData>
    <costStuffCount>75</costStuffCount>
    <costList><Jade>5</Jade></costList>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <statBases>
      <CVG_WorkRoomQuality>0</CVG_WorkRoomQuality>
      <WorkToBuild>2500</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Cleanliness>-5</Cleanliness>
      <Beauty>2</Beauty>
    </statBases>
    <building>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CopyRecipes"><from><li>TableSculpting</li></from></li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li MayRequire="prospero1088.convergence.furniture">CVG_SpiritStoneLantern</li>
          <li MayRequire="prospero1088.convergence.furniture">CVG_PaintingScroll</li>
        </linkableFacilities>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

  <ThingDef ParentName="CVG_WuxiaBenchBase">
    <defName>CVG_SpiritWinery</defName>
    <defaultPlacingRot>South</defaultPlacingRot><!-- el frente del arte es la vista sur: el trabajador queda del lado del frente -->
    <interactionCellOffset>(0,0,1)</interactionCellOffset>
    <label>spirit winery</label>
    <description>Clay jars, a rice-steaming basket and a stone mash trough under a bamboo awning. It mixes every wort a brewery mixes. The wine-immortals of the southern lakes swore that the best spirit wine is brewed by someone slightly drunk, and that the jar knows the difference.</description>
    <graphicData>
      <texPath>Things/Building/CVG/Bench/SpiritWinery</texPath><graphicClass>Graphic_Multi</graphicClass><drawSize>(3,3)</drawSize>
    </graphicData>
    <constructEffect>ConstructWood</constructEffect>
    <costList>
      <WoodLog>120</WoodLog>
      <Steel>10</Steel>
    </costList>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <uiOrder>2302</uiOrder>
    <building>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <researchPrerequisites><li>Brewing</li></researchPrerequisites>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CopyRecipes"><from><li>Brewery</li></from></li>
    </modExtensions>
  </ThingDef>
</Defs>
