  <ScenarioDef ParentName="ScenarioBase">
    <defName>CVG_Scenario_LoneSurvivor</defName>
    <label>Lone survivor</label>
    <description>Every wall of the sect is gone and every master is dead. You walked out of the ash with a robe, a sword and a breath of qi, and you never looked back. Someone, somewhere, knows there was a survivor.</description>
    <scenario>
      <summary>One cultivator who survived the Calamity that destroyed their sect.</summary>
      <playerFaction>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>1</pawnCount>
          <pawnChoiceCount>3</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MedicineHerbal</thingDef><count>12</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Pemmican</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Silver</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MeleeWeapon_LongSword</thingDef><count>1</count><stuff>Steel</stuff></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>CVG_JadeSlip</thingDef><count>1</count></li>
        <li Class="ScenPart_StartingThing_Defined" MayRequire="prospero1088.convergence.apparel"><def>StartingThing_Defined</def><thingDef>CVG_Apparel_RobeOuter</thingDef><count>1</count><stuff>Cloth</stuff></li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart"><def>ScatterThingsNearPlayerStart</def><thingDef>WoodLog</thingDef><count>250</count></li>
        <li Class="ScenPart_ScatterThingsAnywhere"><def>ScatterThingsAnywhere</def><thingDef>Steel</thingDef><count>300</count></li>

        <li Class="Convergence.Stories.ScenPart_StoryOrigin">
          <def>CVG_StoryOrigin</def>
          <visible>false</visible>
          <origin>LoneSurvivor</origin>
          <followUps><li><key>assassin</key><days>6~12</days></li></followUps>
        </li>
        <li Class="Convergence.Stories.ScenPart_ConvergenceOccurred">
          <def>CVG_ConvergenceOccurred</def>
        </li>
        <li Class="Convergence.Stories.ScenPart_StartingCultivators">
          <def>CVG_StartingCultivators</def>
          <realm>CVG_Realm_QiRefining</realm>
          <stage>2~4</stage>
          <count>99</count>
          <techniques>true</techniques>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <textKey>CVG_Scenario_LoneSurvivor_Start</textKey>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

