  <ScenarioDef ParentName="ScenarioBase">
    <defName>CVG_Scenario_BeastHunters</defName>
    <label>Beast hunters</label>
    <description>You hunt what others flee from. Wind wolves, jade spiders, things that have grown too clever. You carry bows, ropes, and a ledger of kills with the price of each. A guild you do not belong to has been asking about you.</description>
    <scenario>
      <summary>Three hunters of spirit beasts, with bows and a taste for trouble.</summary>
      <playerFaction>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>6</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
