<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <LetterDef>
    <defName>CVG_StoryLetter</defName>
    <letterClass>Convergence.Stories.ChoiceLetter_Story</letterClass>
    <color>(150, 190, 230)</color>
    <flashColor>(120, 170, 230)</flashColor>
    <flashInterval>40</flashInterval>
    <arriveSound>LetterArrive</arriveSound>
  </LetterDef>

  <HediffDef>
    <defName>CVG_DamagedDantian</defName>
    <label>damaged dantian</label>
    <description>The sea of qi below the navel has been cracked like a jar. A damaged dantian cannot gather or hold qi, so the cultivator cannot cultivate the path of qi until it is mended. Old masters say the body remembers what the heart refuses to forget: an elixir of mending can still fill the crack.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <defaultLabelColor>(0.7, 0.5, 0.85)</defaultLabelColor>
    <stages>
      <li>
        <becomeVisible>true</becomeVisible>
      </li>
    </stages>
    <modExtensions>
      <li Class="Convergence.DefModExtension_BlocksCultivation">
        <paths><li>CVG_Path_Qi</li></paths>
      </li>
    </modExtensions>
  </HediffDef>

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_DantianElixir</defName>
    <label>dantian mending elixir</label>
    <description>A greenish elixir brewed by a hermit whose own dantian was shattered a century ago. He claims to have mended it with nine hundred tears and one spring of jade. Drunk by a cultivator with a damaged dantian, it closes the crack.</description>
    <descriptionHyperlinks><HediffDef>CVG_DamagedDantian</HediffDef></descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/CVG/CVG_DantianElixir</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>600</MarketValue>
      <Mass>0.3</Mass>
      <Flammability>0.4</Flammability>
      <MaxHitPoints>60</MaxHitPoints>
    </statBases>
    <thingCategories><li>ItemsMisc</li></thingCategories>
    <tradeability>Sellable</tradeability>
    <ingestible>
      <foodType>Fluid</foodType>
      <preferability>NeverForNutrition</preferability>
      <ingestCommandString>Drink {0}</ingestCommandString>
      <ingestReportString>Drinking {0}.</ingestReportString>
      <ingestSound>Ingest_Drink</ingestSound>
      <outcomeDoers>
        <li Class="Convergence.Stories.IngestionOutcomeDoer_RemoveHediffs">
          <hediffs><li>CVG_DamagedDantian</li></hediffs>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <ThoughtDef>
    <defName>CVG_Thought_Cursed</defName>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>cursed by the refugees</label>
        <description>Something cold sits at the back of my neck since the cultists came.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThingDef ParentName="BuildingBase">
    <defName>CVG_LightPillar</defName>
    <label>pillar of light</label>
    <description>A column of pale light rising from the earth where a treasure is being born. Its light pulls every sect for a hundred li.</description>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/CVG/LightPillar</texPath>
      <graphicClass>Graphic_Single</graphicClass><drawRotated>false</drawRotated>
      <drawSize>(1.6,1.6)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <useHitPoints>false</useHitPoints>
    <tickerType>Normal</tickerType>
    <statBases><Flammability>0</Flammability></statBases>
    <building><claimable>false</claimable><deconstructible>false</deconstructible></building>
    <comps>
      <li Class="CompProperties_Glower"><glowRadius>12</glowRadius><glowColor>(255,235,140,0)</glowColor></li>
      <li Class="CompProperties_Lifespan"><lifespanTicks>300000</lifespanTicks></li>
    </comps>
  </ThingDef>

