<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Secret realms (docs/dev/EVENTOS_SECRETOS.md, "Secret realms"): pocket-map dungeons, work without any DLC (vanilla MapPortal).
       Entrances: mining the mountain, an incident, or a world site (quest). The forgotten sect sanctuary replaces the interior of the vanilla ancient temple.
       Final art (provisional: tinted vanilla): Things/Building/CVG/RealmGate, CVG/RealmExit, CVG/RealmLantern, CVG/FormationTrap, CVG/ForgottenSarcophagus. -->

  <!-- ================= Buildings ================= -->
  <ThingDef ParentName="BuildingBase">
    <defName>CVG_RealmGate</defName>
    <label>sealed gate</label>
    <description>A door of black jade set in the living rock, sealed with a formation nobody alive can read. The sects that closed it did not do so to keep something in, but to keep it for themselves. Those who step through enter a pocket of the world cut off from time, and it will not stay open forever.</description>
    <thingClass>Convergence.Stories.Building_RealmGate</thingClass>
    <size>(1,1)</size>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <canOverlapZones>false</canOverlapZones>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/CVG/RealmGate</texPath>
      <graphicClass>Graphic_Single</graphicClass><drawRotated>false</drawRotated>
      <drawSize>(1.7, 1.7)</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>1</fillPercent>
    <passability>Impassable</passability>
    <holdsRoof>true</holdsRoof>
    <destroyable>true</destroyable>
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <isTargetable>false</isTargetable>
      <isInert>true</isInert>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
    </building>
    <portal>
      <pocketMapGenerator>CVG_SecretRealmMap</pocketMapGenerator>
      <exitDef>CVG_RealmExit</exitDef>
      <pocketMapSize>61</pocketMapSize>
      <enteredLetterLabel>A realm out of time</enteredLetterLabel>
      <enteredLetterText>The air beyond the gate is thick with qi and the silence of centuries. The corridors are lit by lanterns that were never lit by anyone, and the formations that guard them are still faithful to their masters.\n\nThe realm cannot hold itself together for long: when it falls apart, everyone inside is cast back to the surface, and whatever is left behind is lost.</enteredLetterText>
      <enteredLetterDef>NeutralEvent</enteredLetterDef>
    </portal>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <inspectorTabs>
      <li>ITab_ContentsMapPortal</li>
    </inspectorTabs>
  </ThingDef>

  <ThingDef ParentName="PocketMapExit">
    <defName>CVG_RealmExit</defName>
    <label>way out of the realm</label>
    <description>A ring of pale light where the realm's seal gives way to the surface world. It is the only certain way out before the realm collapses.</description>
    <size>(2,2)</size>
    <drawerType>MapMeshAndRealTime</drawerType>
    <graphicData>
      <texPath>Things/Building/CVG/RealmExit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.6, 2.6)</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(150,210,200,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>CVG_RealmLantern</defName>
    <label>spirit lantern</label>
    <description>A stone lantern burning a cold green flame that was lit for a sect no one remembers and has not gone out since. It needs no oil, and the flame refuses to be carried away from the place that made it.</description>
    <graphicData>
      <texPath>Things/Building/CVG/RealmLantern</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.25</fillPercent>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(110,200,170,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>CVG_FormationTrap</defName>
    <label>formation trap</label>
    <description>A fragment of a killing formation carved into the floor, still tied to the will of the disciple who traced it. It wakes under the step of anyone it does not know. The old sects used them to test those who came looking for their treasure.</description>
    <thingClass>Building_TrapDamager</thingClass>
    <graphicData>
      <texPath>Things/Building/CVG/FormationTrap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <damageData>
        <rect>(0,0,1,0.15)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <stealable>false</stealable>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-5</Beauty>
      <TrapMeleeDamage>70</TrapMeleeDamage>
      <TrapSpringChance>1.0</TrapSpringChance>
    </statBases>
    <building>
      <isTrap>true</isTrap>
      <trapDestroyOnSpring>false</trapDestroyOnSpring>
      <trapDamageCategory>Blunt</trapDamageCategory>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
  </ThingDef>

  <ThingDef ParentName="AncientCryptosleepCasket">
    <defName>CVG_ForgottenSarcophagus</defName>
    <label>forgotten sarcophagus</label>
    <description>A jade sarcophagus where a disciple of a forgotten sect lies in a cultivation sleep, waiting for a retreat that never ended. The sect fell, the sleeper did not. Whoever wakes them will find out whether they are grateful or have long since gone mad.</description>
    <thingClass>Building_AncientCryptosleepPod</thingClass>
    <containedPawnsSelectable>true</containedPawnsSelectable>
    <graphicData>
      <texPath>Things/Building/CVG/ForgottenSarcophagus</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <building>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
    <researchPrerequisites Inherit="False" />
    <hasInteractionCell>false</hasInteractionCell>
    <statBases>
      <WorkToBuild>2000</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
    </statBases>
    <designationCategory Inherit="False" />
    <costList Inherit="False" />
    <comps Inherit="False" />
  </ThingDef>

  <HediffDef>
    <defName>CVG_RealmSealPressure</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>realm seal pressure</label>
    <description>The seal of a secret realm only admits cultivators up to a certain height and crushes the rest down to it. The higher above the limit, the heavier it presses. It lifts the moment the pawn leaves the realm.</description>
    <defaultLabelColor>(0.85, 0.55, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3000~3500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <painOffset>0.12</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.6</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- ================= Map generation ================= -->
  <BiomeDef>
    <defName>CVG_SecretRealmBiome</defName>
    <label>secret realm</label>
    <description>The inside of a secret realm: no sky, no wild plants and no animals but the ones its makers left behind.</description>
    <generatesNaturally>false</generatesNaturally>
    <animalDensity>0</animalDensity>
    <plantDensity>0</plantDensity>
    <wildAnimalsCanWanderInto>false</wildAnimalsCanWanderInto>
    <baseWeatherCommonalities>
      <Clear>1</Clear>
    </baseWeatherCommonalities>
    <diseaseMtbDays>99999</diseaseMtbDays>
    <diseases>
      <li>
        <diseaseInc>Disease_Flu</diseaseInc>
        <commonality>1</commonality>
      </li>
    </diseases>
    <settlementSelectionWeight>0</settlementSelectionWeight>
  </BiomeDef>

  <MapGeneratorDef>
    <defName>CVG_SecretRealmMap</defName>
    <label>secret realm</label>
    <disableShadows>true</disableShadows>
    <ignoreAreaRevealedLetter>true</ignoreAreaRevealedLetter>
    <disableCallAid>true</disableCallAid>
    <customMapComponents>
      <li>Convergence.Stories.MapComponent_SecretRealm</li>
    </customMapComponents>
    <pocketMapProperties>
      <biome>CVG_SecretRealmBiome</biome>
      <temperature>16</temperature>
      <destroyOnParentMapAbandoned>true</destroyOnParentMapAbandoned>
    </pocketMapProperties>
    <genSteps>
      <li>CVG_SecretRealmGen</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

  <GenStepDef>
    <defName>CVG_SecretRealmGen</defName>
    <order>100</order>
    <genStep Class="Convergence.Stories.GenStep_SecretRealm" />
  </GenStepDef>

  <!-- ================= Pawn kinds (sleeping disciples, tomb guardians) ================= -->
  <PawnKindDef Abstract="True" Name="CVG_SanctuaryKindBase">
    <race>Human</race>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <maxGenerationAge>70</maxGenerationAge>
    <apparelAllowHeadgearChance>0.2</apparelAllowHeadgearChance>
    <initialWillRange>0~2</initialWillRange>
    <initialResistanceRange>14~24</initialResistanceRange>
    <weaponTags><li>MedievalMeleeDecent</li></weaponTags>
    <weaponMoney>150~400</weaponMoney>
    <apparelTags><li>Neolithic</li></apparelTags>
    <apparelMoney>150~450</apparelMoney>
    <gearHealthRange>0.4~1.2</gearHealthRange>
    <itemQuality>Normal</itemQuality>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_SanctuaryKindBase">
    <defName>CVG_Sanctuary_Disciple</defName>
    <label>sleeping disciple</label>
    <combatPower>60</combatPower>
    <minGenerationAge>16</minGenerationAge>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_QiRefining</realm>
        <stage>2~3</stage>
        <manuals><li>CVG_Manual_GoldenEdge</li><li>CVG_Manual_FlowingCloud</li></manuals>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_SanctuaryKindBase">
    <defName>CVG_Sanctuary_Elder</defName>
    <label>sleeping elder</label>
    <combatPower>120</combatPower>
    <minGenerationAge>45</minGenerationAge>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_Foundation</realm>
        <stage>1~3</stage>
        <manuals><li>CVG_Manual_GoldenEdge</li><li>CVG_Manual_EvergreenSutra</li></manuals>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- ================= The realms ================= -->
  <Convergence.Stories.SecretRealmDef>
    <defName>CVG_SecretRealm_JadeHollow</defName>
    <label>Jade Hollow</label>
    <description>A small pocket realm left by a sect so minor that the chronicles forgot its name, but not so minor that it forgot to guard its cache. Wooden puppets still sweep its corridors and the lanterns have never gone out. It only admits those who have not yet laid their foundation.</description>
    <commonality>1</commonality>
    <minColonyRealm>0</minColonyRealm>
    <maxRealmLevel>1</maxRealmLevel>
    <collapseDays>5</collapseDays>
    <floor>TileSandstone</floor>
    <wallStuff>BlocksSandstone</wallStuff>
    <lantern>CVG_RealmLantern</lantern>
    <trap>CVG_FormationTrap</trap>
    <traps>5~8</traps>
    <guardianRooms>2~4</guardianRooms>
    <guardTurrets>
      <li MayRequire="prospero1088.convergence.formations">CVG_RuneCrossbowTurret</li>
    </guardTurrets>
    <guardTurretCount>1~2</guardTurretCount>
    <guardLoot>
      <li><thing>CVG_SpiritStone</thing><count>10~25</count></li>
      <li MayRequire="prospero1088.convergence.alchemy"><thing>CVG_SpiritHerb</thing><count>3~6</count><chance>0.5</chance></li>
    </guardLoot>
    <guardians>
      <li><kind>CVG_Sanctuary_Disciple</kind><count>2~3</count></li>
      <li MayRequire="prospero1088.convergence.biotechwuxia"><kind>CVG_Puppet_Wood</kind><count>1~2</count></li>
      <li MayRequire="prospero1088.convergence.faunaflora"><kind>CVG_JadeWeaverSpider</kind><count>1~2</count></li>
    </guardians>
    <boss>
      <li><kind>CVG_Sanctuary_Elder</kind><count>1</count></li>
      <li MayRequire="prospero1088.convergence.biotechwuxia"><kind>CVG_Puppet_Bronze</kind><count>1</count></li>
    </boss>
    <treasure>
      <li><thing>CVG_SpiritStone</thing><count>40~90</count></li>
      <li><thing>CVG_SpiritJade</thing><count>3~8</count></li>
      <li><thing>CVG_JadeSlip</thing><count>1~2</count></li>
      <li><thing>CVG_FoundationPill</thing><count>1</count><chance>0.5</chance></li>
    </treasure>
    <bossTreasure>
      <li><thing>CVG_SpiritStone</thing><count>60~120</count></li>
      <li><thing>CVG_JadeSlip</thing><count>1~3</count></li>
      <li><thing>CVG_FoundationPill</thing><count>1~2</count></li>
    </bossTreasure>
    <siteGuards>
      <li><kind>CVG_Sanctuary_Disciple</kind><count>2~3</count></li>
    </siteGuards>
  </Convergence.Stories.SecretRealmDef>

  <Convergence.Stories.SecretRealmDef>
    <defName>CVG_SecretRealm_ThunderTomb</defName>
    <label>Tomb of the Thunder Immortal</label>
    <description>The burial vault of a cultivator who was struck down by the heavens at the threshold of the next realm and whose followers refused to accept it. Lightning-scarred stone, bronze puppets and elders who never woke. The seal lets in only those below the Golden Core.</description>
    <commonality>0.8</commonality>
    <minColonyRealm>1</minColonyRealm>
    <maxRealmLevel>2</maxRealmLevel>
    <collapseDays>6</collapseDays>
    <floor>TileGranite</floor>
    <wallStuff>BlocksGranite</wallStuff>
    <lantern>CVG_RealmLantern</lantern>
    <trap>CVG_FormationTrap</trap>
    <traps>7~11</traps>
    <guardianRooms>3~4</guardianRooms>
    <guardTurrets>
      <li MayRequire="prospero1088.convergence.formations">CVG_RuneCrossbowTurret</li>
    </guardTurrets>
    <guardTurretCount>2</guardTurretCount>
    <guardLoot>
      <li><thing>CVG_SpiritStone</thing><count>15~35</count></li>
      <li><thing>CVG_SpiritJade</thing><count>1~3</count><chance>0.5</chance></li>
    </guardLoot>
    <guardians>
      <li><kind>CVG_Sanctuary_Disciple</kind><count>1~2</count></li>
      <li><kind>CVG_Sanctuary_Elder</kind><count>1</count></li>
      <li MayRequire="prospero1088.convergence.biotechwuxia"><kind>CVG_Puppet_Bronze</kind><count>1</count></li>
      <li MayRequire="prospero1088.convergence.faunaflora"><kind>CVG_WindWolf</kind><count>1~2</count></li>
    </guardians>
    <boss>
      <li><kind>CVG_Sanctuary_Elder</kind><count>2</count></li>
      <li MayRequire="prospero1088.convergence.biotechwuxia"><kind>CVG_Puppet_Jade</kind><count>1</count></li>
    </boss>
    <treasure>
      <li><thing>CVG_SpiritStone</thing><count>80~160</count></li>
      <li><thing>CVG_SpiritJade</thing><count>6~14</count></li>
      <li><thing>CVG_JadeSlip</thing><count>2~3</count></li>
      <li><thing>CVG_FoundationPill</thing><count>1~2</count></li>
      <li><thing>CVG_BeastCore</thing><count>1</count><chance>0.4</chance></li>
    </treasure>
    <bossTreasure>
      <li><thing>CVG_SpiritStone</thing><count>120~220</count></li>
      <li><thing>CVG_SpiritJade</thing><count>8~16</count></li>
      <li><thing>CVG_JadeSlip</thing><count>2~4</count></li>
      <li><thing>CVG_BeastCore</thing><count>1~2</count></li>
    </bossTreasure>
    <siteGuards>
      <li><kind>CVG_Sanctuary_Disciple</kind><count>2~3</count></li>
      <li><kind>CVG_Sanctuary_Elder</kind><count>1</count></li>
    </siteGuards>
  </Convergence.Stories.SecretRealmDef>

  <Convergence.Stories.SecretRealmDef>
    <defName>CVG_SecretRealm_NetherLabyrinth</defName>
    <label>Nine Nether Labyrinth</label>
    <description>A maze built to lose its visitors rather than to protect a treasure, though it protects one too. The old sects said that whoever reaches its heart leaves with a Golden Core in hand, and that nobody has tried to count how many left with nothing. Only those who have not condensed a core are allowed in.</description>
    <commonality>0.5</commonality>
    <minColonyRealm>2</minColonyRealm>
    <maxRealmLevel>2</maxRealmLevel>
    <collapseDays>7</collapseDays>
    <floor>TileMarble</floor>
    <wallStuff>BlocksMarble</wallStuff>
    <lantern>CVG_RealmLantern</lantern>
    <trap>CVG_FormationTrap</trap>
    <traps>10~15</traps>
    <guardianRooms>3~4</guardianRooms>
    <guardTurrets>
      <li MayRequire="prospero1088.convergence.formations">CVG_RuneCrossbowTurret</li>
    </guardTurrets>
    <guardTurretCount>2</guardTurretCount>
    <guardLoot>
      <li><thing>CVG_SpiritStone</thing><count>15~35</count></li>
      <li><thing>CVG_SpiritJade</thing><count>1~3</count><chance>0.5</chance></li>
    </guardLoot>
    <guardians>
      <li><kind>CVG_Sanctuary_Elder</kind><count>1~2</count></li>
      <li MayRequire="prospero1088.convergence.biotechwuxia"><kind>CVG_Puppet_Jade</kind><count>1</count></li>
      <li MayRequire="prospero1088.convergence.faunaflora"><kind>CVG_NineNetherSpider</kind><count>1</count></li>
    </guardians>
    <boss>
      <li><kind>CVG_Sanctuary_Elder</kind><count>3</count></li>
      <li MayRequire="prospero1088.convergence.faunaflora"><kind>CVG_NineNetherSpider</kind><count>1~2</count></li>
    </boss>
    <treasure>
      <li><thing>CVG_SpiritStone</thing><count>150~250</count></li>
      <li><thing>CVG_SpiritJade</thing><count>10~20</count></li>
      <li><thing>CVG_JadeSlip</thing><count>3~4</count></li>
      <li><thing>CVG_BeastCore</thing><count>1~2</count></li>
    </treasure>
    <bossTreasure>
      <li><thing>CVG_SpiritStone</thing><count>200~320</count></li>
      <li><thing>CVG_SpiritJade</thing><count>14~24</count></li>
      <li><thing>CVG_JadeSlip</thing><count>3~5</count></li>
      <li><thing>CVG_BeastCore</thing><count>2~3</count></li>
    </bossTreasure>
    <siteGuards>
      <li><kind>CVG_Sanctuary_Elder</kind><count>2</count></li>
    </siteGuards>
  </Convergence.Stories.SecretRealmDef>

  <!-- Content of the forgotten sect sanctuary (not a pocket realm: commonality 0, only read by the ancient temple resolver). -->
  <Convergence.Stories.SecretRealmDef>
    <defName>CVG_Sanctuary</defName>
    <label>Forgotten Sect Sanctuary</label>
    <description>The sanctuary of a sect whose name was erased from every chronicle: sarcophagi of disciples in cultivation sleep, guardians that never left their posts and an offering table nobody dared to touch.</description>
    <commonality>0</commonality>
    <lantern>CVG_RealmLantern</lantern>
    <guardians>
      <li><kind>CVG_Sanctuary_Disciple</kind><count>1~2</count></li>
      <li MayRequire="prospero1088.convergence.biotechwuxia"><kind>CVG_Puppet_Wood</kind><count>1~2</count></li>
    </guardians>
    <treasure>
      <li><thing>CVG_SpiritStone</thing><count>30~80</count></li>
      <li><thing>CVG_JadeSlip</thing><count>1~2</count></li>
      <li><thing>CVG_FoundationPill</thing><count>1</count><chance>0.5</chance></li>
      <li><thing>CVG_SpiritJade</thing><count>2~6</count><chance>0.7</chance></li>
    </treasure>
  </Convergence.Stories.SecretRealmDef>

  <!-- ================= Incident: a gate appears ================= -->
  <IncidentDef>
    <defName>CVG_Story_RealmGate</defName>
    <label>a secret realm opens</label>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>Convergence.Stories.IncidentWorker_RealmGate</workerClass>
    <baseChance>0.3</baseChance>
    <minRefireDays>45</minRefireDays>
  </IncidentDef>

  <!-- ================= World site + quest ================= -->
  <SitePartDef>
    <defName>CVG_SecretRealmEntrance</defName>
    <label>secret realm gate</label>
    <description>The sealed gate of a secret realm, guarded from the outside.</description>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/ItemStash</expandingIconTexture>
    <handlesWorldObjectTimeoutInspectString>true</handlesWorldObjectTimeoutInspectString>
    <approachOrderString>Approach the gate</approachOrderString>
    <approachingReportString>Approaching the secret realm gate</approachingReportString>
    <tags>
      <li>CVG_SecretRealm</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>CVG_SecretRealmEntrance</defName>
    <linkWithSite>CVG_SecretRealmEntrance</linkWithSite>
    <order>1400</order>   <!-- al final (antes de la niebla): pasos posteriores de otros mods borraban la puerta -->
    <genStep Class="Convergence.Stories.GenStep_RealmGateSite" />
  </GenStepDef>

  <QuestScriptDef>
    <defName>CVG_OpportunitySite_SecretRealm</defName>
    <rootSelectionWeight>0.6</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <autoAccept>true</autoAccept>
    <questNameRules>
      <rulesStrings>
        <li>questName->The [realm] of the [sect]</li>
        <li>realm->Secret Realm</li>
        <li>realm->Hidden Vault</li>
        <li>realm->Sealed Gate</li>
        <li>sect->Forgotten Sect</li>
        <li>sect->Nameless Master</li>
        <li>sect->Fallen Immortal</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->The Convergence has loosened the seals of the old world. A gate to a secret realm, closed for centuries, has become visible not far from [map_definite]. Inside lie guardians, formation traps and the treasures of a sect that the chronicles forgot.\n\nThe realm admits only cultivators below a certain height, and it collapses a few days after it is first entered. [allSitePartsDescriptions]</li>
      </rulesStrings>
    </questDescriptionRules>
    <root Class="Convergence.Stories.QuestNode_IfConvergence">
      <node Class="QuestNode_Sequence">
        <nodes>
          <li Class="QuestNode_SubScript">
            <def>Util_RandomizePointsChallengeRating</def>
            <parms>
              <pointsFactorTwoStar>1.5</pointsFactorTwoStar>
              <pointsFactorThreeStar>2</pointsFactorThreeStar>
            </parms>
          </li>
          <li Class="QuestNode_GetMap" />
          <li Class="QuestNode_GetSiteTile">
            <storeAs>siteTile</storeAs>
            <preferCloserTiles>true</preferCloserTiles>
          </li>
          <li Class="QuestNode_GetSitePartDefsByTagsAndFaction">
            <storeAs>sitePartDefs</storeAs>
            <storeFactionAs>siteFaction</storeFactionAs>
            <sitePartsTags>
              <li>
                <tag>CVG_SecretRealm</tag>
              </li>
            </sitePartsTags>
          </li>
          <li Class="QuestNode_GetDefaultSitePartsParams">
            <tile>$siteTile</tile>
            <faction>$siteFaction</faction>
            <sitePartDefs>$sitePartDefs</sitePartDefs>
            <storeSitePartsParamsAs>sitePartsParams</storeSitePartsParamsAs>
          </li>
          <li Class="QuestNode_SubScript">
            <def>Util_GenerateSite</def>
          </li>
          <li Class="QuestNode_SpawnWorldObjects">
            <worldObjects>$site</worldObjects>
          </li>
          <li Class="QuestNode_WorldObjectTimeout">
            <worldObject>$site</worldObject>
            <isQuestTimeout>true</isQuestTimeout>
            <delayTicks>$(randInt(14,30)*60000)</delayTicks>
            <inSignalDisable>site.MapGenerated</inSignalDisable>
            <node Class="QuestNode_Sequence">
              <nodes>
                <li Class="QuestNode_Letter">
                  <label TKey="CVG_LetterLabelRealmExpired">Quest expired: [resolvedQuestName]</label>
                  <text TKey="CVG_LetterTextRealmExpired">The gate has sealed itself again; whoever was meant to open it has not come. The quest [resolvedQuestName] has expired.</text>
                </li>
                <li Class="QuestNode_End">
                  <outcome>Fail</outcome>
                </li>
              </nodes>
            </node>
          </li>
          <li Class="QuestNode_NoWorldObject">
            <worldObject>$site</worldObject>
            <node Class="QuestNode_End" />
          </li>
        </nodes>
      </node>
    </root>
  </QuestScriptDef>
</Defs>
