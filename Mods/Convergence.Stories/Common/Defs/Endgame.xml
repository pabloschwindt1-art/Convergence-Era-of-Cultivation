  <!-- Endgame chain (docs/modulos/ENDGAME.md). Art provisional; final art Things/Item/CVG/<DefName>. -->
  <ThingDef ParentName="ResourceBase">
    <defName>CVG_FounderSeal</defName>
    <label>founder's seal</label>
    <description>A disc of black jade with a single character cut into it, so worn that only the fingers can read it. The founder of the oldest sect of Jiuxiao pressed it into the door of his own tomb on the day he left, and the door has been waiting for a hand that could turn it back.</description>
    <graphicData>
      <texPath>Things/Item/CVG/CVG_FounderSeal</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>0</MarketValue>
      <Mass>0.5</Mass>
      <MaxHitPoints>400</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <thingCategories Inherit="False" />
  </ThingDef>
  <ThingDef ParentName="ResourceBase">
    <defName>CVG_JiuxiaoShard</defName>
    <label>shard of Jiuxiao</label>
    <description>A splinter of the sky itself, light as a feather and cold as a winter well. When Jiuxiao broke, every fragment kept a little of the whole; this one remembers the clouds the sects once walked on, and hums when you carry it toward higher ground.</description>
    <graphicData>
      <texPath>Things/Item/CVG/CVG_JiuxiaoShard</texPath>
