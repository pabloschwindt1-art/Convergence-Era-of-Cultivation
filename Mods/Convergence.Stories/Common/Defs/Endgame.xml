  <ThingDef ParentName="ResourceBase">
    <defName>CVG_RuptureCore</defName>
    <label>core of the Rupture</label>
    <description>A knot of fused metal and qi pulled from the middle of the field where the Great Rupture began. It is warm, and not from any fire. Old chronicles say the Iron Calamity drank here for a hundred years and left this, the one thing it could not digest.</description>
    <graphicData>
      <texPath>Things/Item/CVG/CVG_RuptureCore</texPath>
