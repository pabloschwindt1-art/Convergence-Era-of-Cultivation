  <Convergence.Stories.SecretRealmDef>
    <defName>CVG_EndRealm_RuptureField</defName>
    <label>Field of the Great Rupture</label>
    <description>The battlefield where the Iron Calamity was beaten and Jiuxiao came apart. The ground is glass and bone and rusted metal, and under it the qi still screams. Something here is still working, in its own patient way.</description>
    <commonality>0</commonality>
