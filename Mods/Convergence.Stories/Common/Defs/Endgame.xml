  <Convergence.Stories.SecretRealmDef>
    <defName>CVG_EndRealm_DeepestRealm</defName>
    <label>The Deepest Realm</label>
    <description>Beneath every realm there is another, and under that one the heavens keep a room where they weigh those who would take their seat. Nobody knows how the floor holds. Everyone who has returned from it has returned older, or not at all.</description>
