  <ThingDef ParentName="ResourceBase">
    <defName>CVG_HeavenKey</defName>
    <label>key of heaven</label>
    <description>A key that is also a door, a door that is also a prayer. The Heavenly Court cut one for every ruler who might be worthy of the Ninth Sky, and every one of them was lost in the deepest realm, where the heavens test those who try to take their place.</description>
    <graphicData>
      <texPath>Things/Item/CVG/CVG_HeavenKey</texPath>
