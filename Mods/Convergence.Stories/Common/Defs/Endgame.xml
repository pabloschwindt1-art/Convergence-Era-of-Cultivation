  <Convergence.Stories.SecretRealmDef>
    <defName>CVG_EndRealm_FounderTomb</defName>
    <label>Tomb of the Founder</label>
    <description>The burial hall of the man who founded the oldest sect of Jiuxiao. It has no treasure he could not carry, no guard he did not choose. The founder wanted to be remembered, and his tomb checks, politely and without mercy, whether you deserve to.</description>
    <commonality>0</commonality>
    <minColonyRealm>1</minColonyRealm>
    <maxRealmLevel>3</maxRealmLevel>
    <collapseDays>8</collapseDays>
    <floor>TileGranite</floor>
    <wallStuff>BlocksGranite</wallStuff>
    <lantern>CVG_RealmLantern</lantern>
    <trap>CVG_FormationTrap</trap>
    <traps>8~12</traps>
    <guardianRooms>3~5</guardianRooms>
    <guardians>
      <li><kind>CVG_Sanctuary_Disciple</kind><count>2~3</count></li>
      <li><kind>CVG_Sanctuary_Elder</kind><count>1~2</count></li>
      <li MayRequire="prospero1088.convergence.biotechwuxia"><kind>CVG_Puppet_Bronze</kind><count>1~2</count></li>
    </guardians>
    <boss>
      <li><kind>CVG_Sanctuary_Elder</kind><count>2</count></li>
      <li MayRequire="prospero1088.convergence.biotechwuxia"><kind>CVG_Puppet_Jade</kind><count>1</count></li>
    </boss>
    <treasure>
      <li><thing>CVG_SpiritStone</thing><count>120~240</count></li>
      <li><thing>CVG_SpiritJade</thing><count>8~16</count></li>
      <li><thing>CVG_JadeSlip</thing><count>2~4</count></li>
    </treasure>
    <bossTreasure>
      <li><thing>CVG_FounderSeal</thing><count>1</count></li>
      <li><thing>CVG_SpiritStone</thing><count>200~300</count></li>
      <li><thing>CVG_BeastCore</thing><count>1~2</count></li>
    </bossTreasure>
    <siteGuards />
  </Convergence.Stories.SecretRealmDef>
  <Convergence.Stories.SecretRealmDef>
    <defName>CVG_EndRealm_JiuxiaoFragment</defName>
    <label>Fragment of Jiuxiao</label>
    <description>A piece of the broken Celestial Realm that drifts at the height where birds do not fly. Its pavilions still stand, tilted, among clouds that smell of old incense, and its guardians still keep the hours of a court that no longer exists.</description>
    <commonality>0</commonality>
    <minColonyRealm>2</minColonyRealm>
    <maxRealmLevel>3</maxRealmLevel>
    <collapseDays>8</collapseDays>
    <floor>PavedTile</floor>
    <wallStuff>BlocksMarble</wallStuff>
    <lantern>CVG_RealmLantern</lantern>
    <trap>CVG_FormationTrap</trap>
