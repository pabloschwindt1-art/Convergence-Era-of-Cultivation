<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ScenarioDef ParentName="ScenarioBase">
    <defName>CVG_Scenario_LostDisciples</defName>
    <label>Lost disciples</label>
    <description>You were practicing at the edge of the Sword Peak when the ground opened. You fell through the rift and now you are in a world of metal and glass. Your sect is looking for you.</description>
    <scenario>
      <summary>Three disciples who fell through a rift into a strange world. They already cultivate, without technology.</summary>
      <playerFaction>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>3</pawnCount>
          <pawnChoiceCount>5</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
        </li>

        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MedicineHerbal</thingDef><count>12</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Pemmican</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Silver</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MeleeWeapon_LongSword</thingDef><count>1</count><stuff>Steel</stuff></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>CVG_JadeSlip</thingDef><count>1</count></li>
        <li Class="ScenPart_StartingThing_Defined" MayRequire="prospero1088.convergence.apparel"><def>StartingThing_Defined</def><thingDef>CVG_Apparel_RobeOuter</thingDef><count>1</count><stuff>Cloth</stuff></li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart"><def>ScatterThingsNearPlayerStart</def><thingDef>WoodLog</thingDef><count>250</count></li>
        <li Class="ScenPart_ScatterThingsAnywhere"><def>ScatterThingsAnywhere</def><thingDef>Steel</thingDef><count>300</count></li>

        <li Class="Convergence.Stories.ScenPart_StoryOrigin">
          <def>CVG_StoryOrigin</def>
          <visible>false</visible>
          <origin>LostDisciples</origin>
          <followUps><li><key>emissaries</key><days>8~14</days></li></followUps>
        </li>
        <li Class="Convergence.Stories.ScenPart_ConvergenceOccurred">
          <def>CVG_ConvergenceOccurred</def>
        </li>
        <li Class="Convergence.Stories.ScenPart_StartingCultivators">
          <def>CVG_StartingCultivators</def>
          <realm>CVG_Realm_QiRefining</realm>
          <stage>2~4</stage>
          <count>99</count>
          <techniques>true</techniques>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <textKey>CVG_Scenario_LostDisciples_Start</textKey>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>CVG_Scenario_ExiledAlchemist</defName>
    <label>Exiled alchemist</label>
    <description>The Pavilion forgives everything except what is unpaid. You left with a formula that did not work, a few jars and the reputation of a debtor. The ledger will remember, and the Pavilion's collectors are known for their punctuality.</description>
    <scenario>
      <summary>Two alchemists who fled the Heavenly Cauldron Pavilion with a debt and a half-written formula.</summary>
      <playerFaction>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>2</pawnCount>
          <pawnChoiceCount>5</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MedicineHerbal</thingDef><count>52</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Pemmican</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Silver</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MedicineIndustrial</thingDef><count>6</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MeleeWeapon_Knife</thingDef><count>1</count><stuff>Steel</stuff></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>CVG_FoundationPill</thingDef><count>3</count></li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart"><def>ScatterThingsNearPlayerStart</def><thingDef>WoodLog</thingDef><count>250</count></li>
        <li Class="ScenPart_ScatterThingsAnywhere"><def>ScatterThingsAnywhere</def><thingDef>Steel</thingDef><count>300</count></li>

        <li Class="Convergence.Stories.ScenPart_StoryOrigin">
          <def>CVG_StoryOrigin</def>
          <visible>false</visible>
          <origin>ExiledAlchemist</origin>
          <followUps><li><key>ev:CauldronCreditors</key><days>8~14</days></li></followUps>
        </li>
        <li Class="Convergence.Stories.ScenPart_ConvergenceOccurred">
          <def>CVG_ConvergenceOccurred</def>
        </li>
        <li Class="Convergence.Stories.ScenPart_StartingCultivators">
          <def>CVG_StartingCultivators</def>
          <realm>CVG_Realm_QiRefining</realm>
          <stage>1~3</stage>
          <count>99</count>
          <techniques>true</techniques>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <textKey>CVG_Scenario_ExiledAlchemist_Start</textKey>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>CVG_Scenario_LotusRefugees</defName>
    <label>Healers of the infirmary</label>
    <description>The Heavenly Cauldron Pavilion closed its charity infirmary over a question of price. You walked out with a sack of herbs and a recipe nobody had paid for, and Mo Qinghua did not stop you. She watched you go with an expression that might have been sorrow, or arithmetic.</description>
    <scenario>
      <summary>Four healers who left the Heavenly Cauldron Pavilion when it closed its charity infirmary.</summary>
      <playerFaction>
        <factionDef>PlayerColony</factionDef>
      </playerFaction>
      <parts>
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigPage_ConfigureStartingPawns</def>
          <pawnCount>4</pawnCount>
          <pawnChoiceCount>6</pawnChoiceCount>
        </li>
        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MedicineHerbal</thingDef><count>72</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Pemmican</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>Silver</thingDef><count>150</count></li>
        <li Class="ScenPart_StartingThing_Defined"><def>StartingThing_Defined</def><thingDef>MeleeWeapon_Club</thingDef><count>2</count><stuff>WoodLog</stuff></li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart"><def>ScatterThingsNearPlayerStart</def><thingDef>WoodLog</thingDef><count>250</count></li>
        <li Class="ScenPart_ScatterThingsAnywhere"><def>ScatterThingsAnywhere</def><thingDef>Steel</thingDef><count>300</count></li>

        <li Class="Convergence.Stories.ScenPart_StoryOrigin">
          <def>CVG_StoryOrigin</def>
          <visible>false</visible>
          <origin>LotusRefugees</origin>
          <followUps><li><key>ev:LotusWelcome</key><days>6~10</days></li></followUps>
        </li>
        <li Class="Convergence.Stories.ScenPart_ConvergenceOccurred">
          <def>CVG_ConvergenceOccurred</def>
        </li>
        <li Class="Convergence.Stories.ScenPart_StartingCultivators">
          <def>CVG_StartingCultivators</def>
          <realm>CVG_Realm_QiRefining</realm>
          <stage>1~3</stage>
          <count>99</count>
          <techniques>true</techniques>
        </li>
        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <textKey>CVG_Scenario_LotusRefugees_Start</textKey>
          <closeSound>GameStartSting</closeSound>
        </li>
      </parts>
    </scenario>
  </ScenarioDef>
</Defs>
