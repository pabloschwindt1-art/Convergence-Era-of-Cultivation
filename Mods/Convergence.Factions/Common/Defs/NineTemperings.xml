<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ======================================================================================================================
       Sect of Nine Temperings (九炼宗, Jiǔliàn Zōng). Specialty: the body (body path of the Core: skin, flesh, bone, marrow...).
       All its fighters are Hulk, unarmed: the body is the weapon and the armor. Built on the sect framework (Sect_Bases.xml).
       ====================================================================================================================== -->

  <FactionDef ParentName="CVG_SectFactionBase">
    <defName>CVG_Faction_NineTemperings</defName>
    <label>sect of nine temperings</label>
    <description>A sect that refines flesh, blood and bone with qi until the body becomes both weapon and armor. Its founder, the Iron Mountain patriarch, broke his hands on the Calamity's machines nine times and nine times tempered them again; the sect still counts its ranks in temperings. They say not even a spirit sword can replace a body forged through pain and perseverance, and they respect strength wherever it comes from, technology or qi.</description>
    <fixedName>Sect of Nine Temperings</fixedName>
    <factionIconPath>World/CVG/Factions/NineTemperings</factionIconPath>
    <royalFavorIconPath>UI/Icons/CVG/Contribution/NineTemperings</royalFavorIconPath>
    <pawnSingular>tempered disciple</pawnSingular>
    <pawnsPlural>tempered disciples</pawnsPlural>
    <categoryTag>CVG_Sect_NineTemperings</categoryTag>
    <royalTitleTags><li>CVG_NineTemperingsTitle</li></royalTitleTags>
    <settlementNameMaker>CVG_NamerSettlement_NineTemperings</settlementNameMaker>
    <!-- Near white: the faction icon is tinted with this color, and the emblem art already has its own colors. -->
    <colorSpectrum>
      <li>(1.00,1.00,1.00)</li>
      <li>(0.92,0.92,0.92)</li>
    </colorSpectrum>
    <!-- Fixed ideoligion: our name, founder and precepts; nothing random from vanilla Ideology (GameComponent_SectIdeos does the rest). -->
    <forcedMemes><li>CVG_Meme_BodyWay</li><li>CVG_Structure_Ancestors</li></forcedMemes>
    <fixedIdeo>true</fixedIdeo>
    <ideoName>Way of the Nine Temperings</ideoName>
    <ideoDescription>The body is the first temple and the last weapon. The Nine Temperings follow the Iron Mountain Patriarch, who broke his hands on the machines of the Calamity nine times and tempered them nine times: pain is a hammer, not a wound.</ideoDescription>
    <deityPresets>
      <li>
        <nameType><name>Tie Shan</name><type>Iron Mountain Patriarch</type></nameType>
        <gender>Male</gender>
        <iconPath>UI/Deities/DeityGeneric</iconPath>
      </li>
    </deityPresets>
    <requiredPreceptsOnly>true</requiredPreceptsOnly>
    <styles />
    <basicMemberKind>CVG_NineTemperings_Disciple</basicMemberKind>
    <fixedLeaderKinds><li>CVG_NineTemperings_Elder</li></fixedLeaderKinds>
    <caravanTraderKinds Inherit="False"><li>CVG_Trader_NineTemperings</li></caravanTraderKinds>
    <visitorTraderKinds Inherit="False"><li>CVG_Trader_NineTemperings</li></visitorTraderKinds>
    <baseTraderKinds Inherit="False"><li>CVG_Trader_NineTemperingsSettlement</li></baseTraderKinds>
    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <CVG_NineTemperings_Disciple>10</CVG_NineTemperings_Disciple>
          <CVG_NineTemperings_Inner>7</CVG_NineTemperings_Inner>
          <CVG_NineTemperings_Core>4</CVG_NineTemperings_Core>
          <CVG_NineTemperings_Elder>1.5</CVG_NineTemperings_Elder>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <CVG_NineTemperings_Disciple>10</CVG_NineTemperings_Disciple>
          <CVG_NineTemperings_Inner>7</CVG_NineTemperings_Inner>
          <CVG_NineTemperings_Core>4</CVG_NineTemperings_Core>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <CVG_NineTemperings_Trader>1</CVG_NineTemperings_Trader>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
        </carriers>
        <guards>
          <CVG_NineTemperings_Disciple>10</CVG_NineTemperings_Disciple>
          <CVG_NineTemperings_Inner>7</CVG_NineTemperings_Inner>
          <CVG_NineTemperings_Core>4</CVG_NineTemperings_Core>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <CVG_NineTemperings_Disciple>10</CVG_NineTemperings_Disciple>
          <CVG_NineTemperings_Inner>7</CVG_NineTemperings_Inner>
          <CVG_NineTemperings_Core>4</CVG_NineTemperings_Core>
          <CVG_NineTemperings_Elder>1.5</CVG_NineTemperings_Elder>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectIdeo">
        <icon>CVG_IdeoIcon_BodyWay</icon>
        <color>CVG_IdeoColor_Natural</color>
        <leaderIconPath>UI/Roles/CVG/NineTemperings_Leader</leaderIconPath>
        <elderIconPath>UI/Roles/CVG/NineTemperings_Elder</elderIconPath>
      </li>
      <li Class="Convergence.DefModExtension_ConvergenceFaction">
        <extraSettlements>1~2</extraSettlements>
      </li>
    </modExtensions>
  </FactionDef>

  <!-- Disciples: body path, Hulk, unarmed (no weapon), body techniques, the Nine Temperings body by rank. -->
  <PawnKindDef Abstract="True" Name="CVG_NineTemperingsKindBase" ParentName="CVG_Sect2KindBase">
    <defaultFactionDef>CVG_Faction_NineTemperings</defaultFactionDef>
    <nameMaker>CVG_NamerPerson_NineTemperings</nameMaker>
    <weaponMoney>0~0</weaponMoney>
    <apparelTags><li>Neolithic</li><li>MedievalMilitary</li></apparelTags>
    <apparelColor>(0.62,0.45,0.30)</apparelColor>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_NineTemperingsKindBase">
    <defName>CVG_NineTemperings_Disciple</defName>
    <label>outer tempered disciple</label>
    <fixedAdultBackstories><li>CVG_Backstory_NT_OuterDisciple</li><li>CVG_Backstory_NT_StoneCarrier</li></fixedAdultBackstories>
    <combatPower>60</combatPower>
    <minGenerationAge>16</minGenerationAge>
    <apparelMoney>100~350</apparelMoney>
    <itemQuality>Normal</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_SkinTempering</realm>
        <stage>1~3</stage>
        <manuals><li>CVG_Manual_VajraBody</li></manuals>
        <forcedBodyType>Hulk</forcedBodyType>
        <traitChances>
          <li><trait>CVG_Body_Steel</trait><degree>1</degree><chance>0.03</chance></li>
          <li><trait>CVG_Body_Steel</trait><degree>0</degree><chance>0.30</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_NineTemperingsKindBase">
    <defName>CVG_NineTemperings_Inner</defName>
    <label>inner tempered disciple</label>
    <fixedAdultBackstories><li>CVG_Backstory_NT_InnerDisciple</li><li>CVG_Backstory_NT_BeastHunter</li></fixedAdultBackstories>
    <combatPower>110</combatPower>
    <minGenerationAge>18</minGenerationAge>
    <apparelMoney>250~700</apparelMoney>
    <itemQuality>Good</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_FleshTempering</realm>
        <stage>1~2</stage>
        <manuals><li>CVG_Manual_VajraBody</li></manuals>
        <forcedBodyType>Hulk</forcedBodyType>
        <traitChances>
          <li><trait>CVG_Body_Steel</trait><degree>2</degree><chance>0.02</chance></li>
          <li><trait>CVG_Body_Steel</trait><degree>1</degree><chance>0.10</chance></li>
          <li><trait>CVG_Body_Steel</trait><degree>0</degree><chance>0.45</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_NineTemperingsKindBase">
    <defName>CVG_NineTemperings_Core</defName>
    <label>core tempered disciple</label>
    <fixedAdultBackstories><li>CVG_Backstory_NT_CoreDisciple</li><li>CVG_Backstory_NT_PitChampion</li></fixedAdultBackstories>
    <combatPower>150</combatPower>
    <minGenerationAge>20</minGenerationAge>
    <apparelMoney>400~1000</apparelMoney>
    <itemQuality>Good</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_FleshTempering</realm>
        <stage>3~4</stage>
        <manuals><li>CVG_Manual_VajraBody</li></manuals>
        <forcedBodyType>Hulk</forcedBodyType>
        <traitChances>
          <li><trait>CVG_Body_Steel</trait><degree>3</degree><chance>0.005</chance></li>
          <li><trait>CVG_Body_Steel</trait><degree>2</degree><chance>0.06</chance></li>
          <li><trait>CVG_Body_Steel</trait><degree>1</degree><chance>0.25</chance></li>
          <li><trait>CVG_Body_Steel</trait><degree>0</degree><chance>0.60</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_NineTemperingsKindBase">
    <defName>CVG_NineTemperings_Elder</defName>
    <label>tempering elder</label>
    <fixedAdultBackstories><li>CVG_Backstory_NT_TemperingElder</li><li>CVG_Backstory_NT_VajraGuardian</li></fixedAdultBackstories>
    <combatPower>260</combatPower>
    <minGenerationAge>40</minGenerationAge>
    <maxGenerationAge>160</maxGenerationAge>
    <factionLeader>true</factionLeader>
    <apparelMoney>600~1400</apparelMoney>
    <itemQuality>Excellent</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_BoneForging</realm>
        <stage>1~3</stage>
        <manuals><li>CVG_Manual_VajraBody</li></manuals>
        <forcedBodyType>Hulk</forcedBodyType>
        <traitChances>
          <li><trait>CVG_Body_Steel</trait><degree>3</degree><chance>0.03</chance></li>
          <li><trait>CVG_Body_Steel</trait><degree>2</degree><chance>0.25</chance></li>
          <li><trait>CVG_Body_Steel</trait><degree>1</degree><chance>1</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_NineTemperingsKindBase">
    <defName>CVG_NineTemperings_Trader</defName>
    <label>blood and bone trader</label>
    <fixedAdultBackstories><li>CVG_Backstory_NT_BloodTrader</li></fixedAdultBackstories>
    <combatPower>50</combatPower>
    <minGenerationAge>25</minGenerationAge>
    <trader>true</trader>
    <apparelMoney>200~500</apparelMoney>
    <itemQuality>Good</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_SkinTempering</realm>
        <stage>2~3</stage>
        <manuals><li>CVG_Manual_VajraBody</li></manuals>
        <forcedBodyType>Hulk</forcedBodyType>
        <traitChances>
          <li><trait>CVG_Body_Steel</trait><degree>0</degree><chance>0.30</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- Trade: beast blood, tempering resources, recovery preparations and armor Good to Masterwork (never Legendary). -->
  <TraderKindDef Abstract="True" Name="CVG_TraderNineTemperingsBase">
    <stockGenerators>
      <li Class="StockGenerator_SingleDef"><thingDef>Silver</thingDef><countRange>300~900</countRange></li>
      <li Class="Convergence.StockGenerator_QualityTag">
        <tradeTag>Armor</tradeTag>
        <thingDefCountRange>2~4</thingDefCountRange>
        <countRange>1~1</countRange>
        <qualities>
          <li><quality>Good</quality><weight>55</weight></li>
          <li><quality>Excellent</quality><weight>37</weight></li>
          <li><quality>Masterwork</quality><weight>8</weight></li>
        </qualities>
      </li>
      <li Class="StockGenerator_SingleDef"><thingDef>CVG_BeastBlood</thingDef><countRange>10~40</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>CVG_SpiritMeat</thingDef><countRange>20~60</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>CVG_BeastCore</thingDef><countRange>0~3</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>CVG_SpiritStone</thingDef><countRange>20~60</countRange></li>
      <li Class="StockGenerator_SingleDef" MayRequire="prospero1088.convergence.alchemy"><thingDef>CVG_TemperingPill</thingDef><countRange>0~4</countRange></li>
      <li Class="StockGenerator_SingleDef" MayRequire="prospero1088.convergence.alchemy"><thingDef>CVG_HealingPill</thingDef><countRange>0~6</countRange></li>
      <li Class="StockGenerator_SingleDef" MayRequire="prospero1088.convergence.alchemy"><thingDef>CVG_HerbalOintment</thingDef><countRange>0~8</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Medicine</categoryDef><thingDefCountRange>1~2</thingDefCountRange><countRange>4~12</countRange></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Armor</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>WeaponMelee</tag></li>
    </stockGenerators>
  </TraderKindDef>

  <TraderKindDef ParentName="CVG_TraderNineTemperingsBase">
    <defName>CVG_Trader_NineTemperings</defName>
    <label>nine temperings merchant</label>
  </TraderKindDef>

  <TraderKindDef ParentName="CVG_TraderNineTemperingsBase">
    <defName>CVG_Trader_NineTemperingsSettlement</defName>
    <label>nine temperings settlement</label>
  </TraderKindDef>

  <!-- Honorary titles -->
  <RoyalTitleDef ParentName="CVG_SectTitle1">
    <defName>CVG_Title_NineTemperings_Friend</defName>
    <label>friend of the Nine Temperings</label>
    <description>The sect greets its friends with a slap on the back hard enough to bruise; the bruise is the courtesy. A friend may watch the morning beatings and eat at the long table of beast meat.</description>
    <tags><li>CVG_NineTemperingsTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle2">
    <defName>CVG_Title_NineTemperings_Guest</defName>
    <label>honored guest of the Nine Temperings</label>
    <description>An honored guest is offered the first cup of the blood broth that tempers the disciples, and nobody laughs if they cannot finish it. In return the sect expects them to speak of its strength, and never of its scars.</description>
    <tags><li>CVG_NineTemperingsTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle3">
    <defName>CVG_Title_NineTemperings_Protector</defName>
    <label>protector of the Nine Temperings</label>
    <description>An outsider who has bled beside the sect has their name beaten into the bronze gong of the training hall. When that gong rings for them, the sect's disciples come running.</description>
    <tags><li>CVG_NineTemperingsTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle4">
    <defName>CVG_Title_NineTemperings_GuestElder</defName>
    <label>guest elder of the Nine Temperings</label>
    <description>A guest elder (客卿长老) sits among the elders of the Nine Temperings without having taken the sect's vows. They have earned the right the hard way: the sect does not honor what it has not tested.</description>
    <tags><li>CVG_NineTemperingsTitle</li></tags>
  </RoyalTitleDef>

  <!-- The five favors -->
  <RoyalTitlePermitDef ParentName="CVG_SectFavorResources">
    <defName>CVG_Permit_NineTemperings_TemperingResources</defName>
    <label>tempering resources</label>
    <description>The sect sends a crate from its butchery: spirit beast blood, spirit meat and stones for the forge of the body. The elders say a body is tempered at the table as much as in the yard.</description>
    <faction>CVG_Faction_NineTemperings</faction>
    <minTitle>CVG_Title_NineTemperings_Friend</minTitle>
    <royalAid>
      <itemsToDrop>
        <CVG_BeastBlood>15</CVG_BeastBlood>
        <CVG_SpiritMeat>25</CVG_SpiritMeat>
        <CVG_SpiritStone>20</CVG_SpiritStone>
      </itemsToDrop>
    </royalAid>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorReinforcements">
    <defName>CVG_Permit_NineTemperings_Disciples</defName>
    <label>call tempered disciples</label>
    <description>Three inner disciples of the Nine Temperings come to fight with their bare hands at your side. Bullets bother them less than they should.</description>
    <faction>CVG_Faction_NineTemperings</faction>
    <minTitle>CVG_Title_NineTemperings_Guest</minTitle>
    <royalAid>
      <pawnKindDef>CVG_NineTemperings_Inner</pawnKindDef>
    </royalAid>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorMasterwork">
    <defName>CVG_Permit_NineTemperings_MasterworkArmor</defName>
    <label>masterwork armor</label>
    <description>The sect does not wear armor, but it forges it for those it respects: a suit hammered by disciples who test every plate on their own ribs.</description>
    <faction>CVG_Faction_NineTemperings</faction>
    <minTitle>CVG_Title_NineTemperings_Protector</minTitle>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectGift">
        <options>
          <li><thing>Apparel_PlateArmor</thing><quality>Masterwork</quality></li>
          <li><thing>Apparel_FlakVest</thing><quality>Masterwork</quality></li>
          <li><thing>Apparel_ArmorRecon</thing><quality>Masterwork</quality></li>
        </options>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorExceptional">
    <defName>CVG_Permit_NineTemperings_LegendaryArmor</defName>
    <label>legendary armor</label>
    <description>An armor from the sect's hall of trials, struck nine thousand times and never pierced. The guest elder chooses which one will carry their name.</description>
    <faction>CVG_Faction_NineTemperings</faction>
    <minTitle>CVG_Title_NineTemperings_GuestElder</minTitle>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectGift">
        <playerChooses>true</playerChooses>
        <options>
          <li><thing>Apparel_PlateArmor</thing><quality>Legendary</quality></li>
          <li><thing>Apparel_ArmorRecon</thing><quality>Legendary</quality></li>
          <li><thing>Apparel_PowerArmor</thing><quality>Legendary</quality></li>
          <li><thing>Apparel_ArmorCataphract</thing><quality>Legendary</quality></li>
        </options>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorStrike">
    <defName>CVG_Permit_NineTemperings_BodyStrike</defName>
    <label>iron mountain strike</label>
    <description>Four core disciples of the Nine Temperings land where you point and tear through whatever stands there with their bare hands. Their enemies call it the falling mountain; the sect calls it a warm-up.</description>
    <faction>CVG_Faction_NineTemperings</faction>
    <minTitle>CVG_Title_NineTemperings_GuestElder</minTitle>
    <royalAid>
      <pawnKindDef>CVG_NineTemperings_Core</pawnKindDef>
      <pawnCount>4</pawnCount>
    </royalAid>
  </RoyalTitlePermitDef>
</Defs>
