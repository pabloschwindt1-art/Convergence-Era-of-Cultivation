<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ======================================================================================================================
       Blood Moon Cult (血月教, Xuèyuè Jiào). Specialty: blood cultivation and the demonic arts. A natural enemy: it arrives hostile,
       except with colonies that follow the demonic way (neutralToPlayerMemes), and its favors depend on that diplomacy. It does not
       trade. Blades only: blood spilled from afar is blood wasted. Built on the sect framework (Sect_Bases.xml).
       ====================================================================================================================== -->

  <FactionDef ParentName="CVG_SectFactionBase">
    <defName>CVG_Faction_BloodMoon</defName>
    <label>blood moon cult</label>
    <description>A heterodox cult born from a purge of the Heavenly Origin sect. Its founder, Xue Jiuyou, the Venerable, discovered that blood and soul concentrate qi faster than any meditation, and was cast out for saying it aloud. They are not mad: they are pragmatic. They respect strength and loyalty, keep their own laws, and pay their blood debts to the last drop. Heaven is a cage, they say; break it with what you have in your veins. They crossed into Jiuxiao before anyone else, following a red moon that, some whisper, was never a moon at all.</description>
    <fixedName>Blood Moon Cult</fixedName>
    <factionIconPath>World/CVG/Factions/BloodMoon</factionIconPath>
    <royalFavorIconPath>UI/Icons/CVG/Contribution/BloodMoon</royalFavorIconPath>
    <pawnSingular>blood disciple</pawnSingular>
    <pawnsPlural>blood disciples</pawnsPlural>
    <leaderTitle>venerable</leaderTitle>
    <categoryTag>CVG_Sect_BloodMoon</categoryTag>
    <royalTitleTags><li>CVG_BloodMoonTitle</li></royalTitleTags>
    <settlementNameMaker>CVG_NamerSettlement_BloodMoon</settlementNameMaker>
    <naturalEnemy>true</naturalEnemy>
    <structureMemeWeights Inherit="False">
      <CVG_Structure_Ancestors>2</CVG_Structure_Ancestors>
      <CVG_Structure_DaoOrigin>1</CVG_Structure_DaoOrigin>
      <Structure_Ideological>2</Structure_Ideological>
    </structureMemeWeights>
    <!-- Near white: the faction icon is tinted with this color, and the emblem art already has its own colors. -->
    <colorSpectrum>
      <li>(1.00,1.00,1.00)</li>
      <li>(0.92,0.92,0.92)</li>
    </colorSpectrum>
    <!-- Fixed ideoligion: our name, founder and precepts; nothing random from vanilla Ideology (GameComponent_SectIdeos does the rest). -->
    <forcedMemes><li>CVG_Meme_DemonicWay</li><li>CVG_Structure_Ancestors</li></forcedMemes>
    <fixedIdeo>true</fixedIdeo>
    <ideoName>Way of the Blood Moon</ideoName>
    <ideoDescription>Heaven is a cage; break it with what you have in your veins. The Cult follows Xue Jiuyou, the Venerable, who was cast out for saying aloud that blood and soul hold more qi than any mountain.</ideoDescription>
    <deityPresets>
      <li>
        <nameType><name>Xue Jiuyou</name><type>the Venerable of the Blood Moon</type></nameType>
        <gender>Male</gender>
        <iconPath>UI/Deities/DeityGeneric</iconPath>
      </li>
    </deityPresets>
    <requiredPreceptsOnly>true</requiredPreceptsOnly>
    <styles />
    <basicMemberKind>CVG_BloodMoon_Servant</basicMemberKind>
    <fixedLeaderKinds><li>CVG_BloodMoon_Elder</li></fixedLeaderKinds>
    <caravanTraderKinds Inherit="False" />
    <visitorTraderKinds Inherit="False" />
    <baseTraderKinds Inherit="False" />
    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <CVG_BloodMoon_Servant>10</CVG_BloodMoon_Servant>
          <CVG_BloodMoon_Disciple>7</CVG_BloodMoon_Disciple>
          <CVG_BloodMoon_Crimson>4</CVG_BloodMoon_Crimson>
          <CVG_BloodMoon_Elder>1</CVG_BloodMoon_Elder>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <CVG_BloodMoon_Servant>10</CVG_BloodMoon_Servant>
          <CVG_BloodMoon_Disciple>7</CVG_BloodMoon_Disciple>
          <CVG_BloodMoon_Crimson>4</CVG_BloodMoon_Crimson>
        </options>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <CVG_BloodMoon_Servant>10</CVG_BloodMoon_Servant>
          <CVG_BloodMoon_Disciple>7</CVG_BloodMoon_Disciple>
          <CVG_BloodMoon_Crimson>4</CVG_BloodMoon_Crimson>
          <CVG_BloodMoon_Elder>1.5</CVG_BloodMoon_Elder>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectIdeo">
        <icon>CVG_IdeoIcon_DemonicWay</icon>
        <color>CVG_IdeoColor_Natural</color>
        <leaderIconPath>UI/Roles/CVG/BloodMoon_Leader</leaderIconPath>
        <elderIconPath>UI/Roles/CVG/BloodMoon_Elder</elderIconPath>
      </li>
      <li Class="Convergence.DefModExtension_ConvergenceFaction">
        <extraSettlements>1~2</extraSettlements>
        <!-- The orthodox sects that forbid the demonic arts are its sworn enemies. -->
        <hostileTo>
          <li>CVG_Faction_FormlessSword</li>
          <li>CVG_Faction_NineTemperings</li>
        </hostileTo>
        <neutralToPlayerMemes>
          <li>CVG_Meme_DemonicWay</li>
        </neutralToPlayerMemes>
      </li>
    </modExtensions>
  </FactionDef>

  <!-- Disciples: blood cultivators with blades (daggers, spears and swords; never bows or rifles) and the blood moon body by rank. -->
  <PawnKindDef Abstract="True" Name="CVG_BloodMoonKindBase" ParentName="CVG_Sect2KindBase">
    <defaultFactionDef>CVG_Faction_BloodMoon</defaultFactionDef>
    <nameMaker>CVG_NamerPerson_BloodMoon</nameMaker>
    <weaponTags><li>MedievalMeleeDecent</li><li>MedievalMeleeBasic</li></weaponTags>
    <apparelTags><li>IndustrialBasic</li><li>Neolithic</li></apparelTags>
    <apparelColor>(0.45,0.07,0.09)</apparelColor>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_BloodMoonKindBase">
    <defName>CVG_BloodMoon_Servant</defName>
    <label>blood servant</label>
    <fixedAdultBackstories><li>CVG_Backstory_BM_BloodServant</li><li>CVG_Backstory_BM_RiftRunner</li></fixedAdultBackstories>
    <combatPower>55</combatPower>
    <minGenerationAge>16</minGenerationAge>
    <weaponMoney>150~400</weaponMoney>
    <apparelMoney>150~450</apparelMoney>
    <itemQuality>Normal</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_QiRefining</realm>
        <stage>1~3</stage>
        <manuals><li>CVG_Manual_FlowingCloud</li><li>CVG_Manual_BlazingSun</li></manuals>
        <elements><li>CVG_Element_Water</li><li>CVG_Element_Fire</li></elements>
        <traitChances>
          <li><trait>CVG_Body_BloodMoon</trait><degree>1</degree><chance>0.03</chance></li>
          <li><trait>CVG_Body_BloodMoon</trait><degree>0</degree><chance>0.30</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_BloodMoonKindBase">
    <defName>CVG_BloodMoon_Disciple</defName>
    <label>blood disciple</label>
    <fixedAdultBackstories><li>CVG_Backstory_BM_BloodDisciple</li><li>CVG_Backstory_BM_LanternKeeper</li></fixedAdultBackstories>
    <combatPower>105</combatPower>
    <minGenerationAge>18</minGenerationAge>
    <weaponMoney>300~800</weaponMoney>
    <apparelMoney>300~800</apparelMoney>
    <itemQuality>Good</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_Foundation</realm>
        <stage>1~2</stage>
        <manuals><li>CVG_Manual_FlowingCloud</li><li>CVG_Manual_BlazingSun</li></manuals>
        <elements><li>CVG_Element_Water</li><li>CVG_Element_Fire</li></elements>
        <traitChances>
          <li><trait>CVG_Body_BloodMoon</trait><degree>2</degree><chance>0.02</chance></li>
          <li><trait>CVG_Body_BloodMoon</trait><degree>1</degree><chance>0.10</chance></li>
          <li><trait>CVG_Body_BloodMoon</trait><degree>0</degree><chance>0.45</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_BloodMoonKindBase">
    <defName>CVG_BloodMoon_Crimson</defName>
    <label>crimson envoy</label>
    <fixedAdultBackstories><li>CVG_Backstory_BM_CrimsonEnvoy</li><li>CVG_Backstory_BM_DebtCollector</li></fixedAdultBackstories>
    <weaponTags Inherit="False"><li>MedievalMeleeAdvanced</li><li>MedievalMeleeDecent</li></weaponTags>
    <combatPower>140</combatPower>
    <minGenerationAge>20</minGenerationAge>
    <weaponMoney>500~1200</weaponMoney>
    <apparelMoney>400~1000</apparelMoney>
    <itemQuality>Good</itemQuality>
    <inventoryOptions>
      <skipChance>0.6</skipChance>
      <thingDef>CVG_ChaosCore</thingDef>
      <countRange>1~1</countRange>
    </inventoryOptions>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_Foundation</realm>
        <stage>3~4</stage>
        <manuals><li>CVG_Manual_FlowingCloud</li><li>CVG_Manual_BlazingSun</li></manuals>
        <elements><li>CVG_Element_Water</li><li>CVG_Element_Fire</li></elements>
        <traitChances>
          <li><trait>CVG_Body_BloodMoon</trait><degree>3</degree><chance>0.005</chance></li>
          <li><trait>CVG_Body_BloodMoon</trait><degree>2</degree><chance>0.06</chance></li>
          <li><trait>CVG_Body_BloodMoon</trait><degree>1</degree><chance>0.25</chance></li>
          <li><trait>CVG_Body_BloodMoon</trait><degree>0</degree><chance>0.60</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_BloodMoonKindBase">
    <defName>CVG_BloodMoon_Elder</defName>
    <label>blood elder</label>
    <fixedAdultBackstories><li>CVG_Backstory_BM_BloodElder</li><li>CVG_Backstory_BM_SoulElder</li></fixedAdultBackstories>
    <weaponTags Inherit="False"><li>MedievalMeleeAdvanced</li></weaponTags>
    <combatPower>240</combatPower>
    <minGenerationAge>40</minGenerationAge>
    <maxGenerationAge>160</maxGenerationAge>
    <factionLeader>true</factionLeader>
    <weaponMoney>900~2000</weaponMoney>
    <apparelMoney>600~1400</apparelMoney>
    <itemQuality>Excellent</itemQuality>
    <inventoryOptions>
      <skipChance>0.1</skipChance>
      <thingDef>CVG_ChaosCore</thingDef>
      <countRange>1~3</countRange>
    </inventoryOptions>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_GoldenCore</realm>
        <stage>1~3</stage>
        <manuals><li>CVG_Manual_FlowingCloud</li><li>CVG_Manual_BlazingSun</li></manuals>
        <elements><li>CVG_Element_Water</li><li>CVG_Element_Fire</li></elements>
        <traitChances>
          <li><trait>CVG_Body_BloodMoon</trait><degree>3</degree><chance>0.03</chance></li>
          <li><trait>CVG_Body_BloodMoon</trait><degree>2</degree><chance>0.25</chance></li>
          <li><trait>CVG_Body_BloodMoon</trait><degree>1</degree><chance>1</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- Honorary titles: what the Cult grants outsiders who shed blood for it. -->
  <RoyalTitleDef ParentName="CVG_SectTitle1">
    <defName>CVG_Title_BloodMoon_Guest</defName>
    <label>blood guest</label>
    <description>A blood guest (血客) may walk into the Cult's halls and walk out again, which is more than most visitors manage. The Cult does not ask what you believe; it asks what you are willing to spill.</description>
    <tags><li>CVG_BloodMoonTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle2">
    <defName>CVG_Title_BloodMoon_Sworn</defName>
    <label>blood-sworn</label>
    <description>The blood-sworn have mixed a drop of their blood with the Cult's in a bowl of moonlit water. Whoever harms them owes a blood debt, and the Cult always collects.</description>
    <tags><li>CVG_BloodMoonTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle3">
    <defName>CVG_Title_BloodMoon_Creditor</defName>
    <label>blood creditor</label>
    <description>The Cult owes this one a debt of blood, written in Su Lanyin's own hand. The Blood Saint smiles at creditors; they are the only people she has promised never to bleed.</description>
    <tags><li>CVG_BloodMoonTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle4">
    <defName>CVG_Title_BloodMoon_GuestElder</defName>
    <label>guest elder of the Blood Moon</label>
    <description>A guest elder (客卿长老) sits under the red moon beside the Venerable's empty seat. Xue Jiuyou has granted the title to a handful of outsiders in a century; all of them are still alive, which in the Cult is the highest honor.</description>
    <tags><li>CVG_BloodMoonTitle</li></tags>
  </RoyalTitleDef>

  <!-- The five favors (only while the Cult is not hostile) -->
  <RoyalTitlePermitDef ParentName="CVG_SectFavorResources">
    <defName>CVG_Permit_BloodMoon_BloodOffering</defName>
    <label>blood offering</label>
    <description>A sealed crate from the Cult's cellars: beast blood still warm from the rite, spirit stones and a beast core. Nobody asks where the blood came from; the Cult would answer.</description>
    <faction>CVG_Faction_BloodMoon</faction>
    <minTitle>CVG_Title_BloodMoon_Guest</minTitle>
    <royalAid>
      <itemsToDrop>
        <CVG_BeastBlood>30</CVG_BeastBlood>
        <CVG_SpiritStone>40</CVG_SpiritStone>
        <CVG_BeastCore>1</CVG_BeastCore>
        <HemogenPack MayRequire="Ludeon.RimWorld.Biotech">6</HemogenPack>
        <CVG_BloodEssencePill MayRequire="prospero1088.convergence.biotechwuxia">3</CVG_BloodEssencePill>
      </itemsToDrop>
    </royalAid>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorReinforcements">
    <defName>CVG_Permit_BloodMoon_Disciples</defName>
    <label>call blood disciples</label>
    <description>Three blood disciples answer the call with their blades already drawn. They fight for you as long as the debt lasts, and they keep count.</description>
    <faction>CVG_Faction_BloodMoon</faction>
    <minTitle>CVG_Title_BloodMoon_Sworn</minTitle>
    <royalAid>
      <pawnKindDef>CVG_BloodMoon_Disciple</pawnKindDef>
    </royalAid>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorMasterwork">
    <defName>CVG_Permit_BloodMoon_BloodBlade</defName>
    <label>masterwork blood blade</label>
    <description>A blade the Cult has quenched in blood under a full red moon. It drinks a little from every wound it opens, the disciples say, and remembers the taste.</description>
    <faction>CVG_Faction_BloodMoon</faction>
    <minTitle>CVG_Title_BloodMoon_Creditor</minTitle>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectGift">
        <options>
          <li><weaponTag>MedievalMeleeAdvanced</weaponTag><quality>Masterwork</quality></li>
        </options>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorExceptional">
    <defName>CVG_Permit_BloodMoon_VenerableGift</defName>
    <label>gift of the venerable</label>
    <description>Xue Jiuyou opens the Cult's reliquary to the guest elder: blades that served the Venerable's own elders, or the essence of a hundred blood rites distilled into a cup. The guest elder chooses; the Venerable remembers the choice.</description>
    <faction>CVG_Faction_BloodMoon</faction>
    <minTitle>CVG_Title_BloodMoon_GuestElder</minTitle>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectGift">
        <playerChooses>true</playerChooses>
        <options>
          <li><thing>MeleeWeapon_Spear</thing><quality>Legendary</quality></li>
          <li><thing>MeleeWeapon_LongSword</thing><quality>Legendary</quality></li>
          <li><thing>MeleeWeapon_MonoSword</thing><quality>Legendary</quality></li>
          <li MayRequire="prospero1088.convergence.alchemy"><thing>CVG_Dao</thing><quality>Legendary</quality></li>
          <li MayRequire="prospero1088.convergence.biotechwuxia"><thing>CVG_BloodEssencePill</thing><count>10</count></li>
          <li><thing>CVG_PrimordialCrystal</thing><count>3</count></li>
        </options>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorStrike">
    <defName>CVG_Permit_BloodMoon_CrimsonStrike</defName>
    <label>crimson strike</label>
    <description>Four crimson envoys fall where you point, under a moon that turns red for the occasion. When they leave, the Cult considers one more debt paid.</description>
    <faction>CVG_Faction_BloodMoon</faction>
    <minTitle>CVG_Title_BloodMoon_GuestElder</minTitle>
    <royalAid>
      <pawnKindDef>CVG_BloodMoon_Crimson</pawnKindDef>
      <pawnCount>4</pawnCount>
    </royalAid>
  </RoyalTitlePermitDef>
</Defs>
