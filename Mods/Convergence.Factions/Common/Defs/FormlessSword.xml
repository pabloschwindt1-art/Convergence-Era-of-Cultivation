<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- ======================================================================================================================
       Formless Sword Sect (无形剑宗, Wúxíng Jiànzōng). Specialty: the sword (Jian Yi, sword intent). Built on the sect framework
       (Sect_Bases.xml, Ideology/Sect_Framework.xml); its ideology is in Ideology/FormlessSword_Ideology.xml.
       ====================================================================================================================== -->

  <FactionDef ParentName="CVG_SectFactionBase">
    <defName>CVG_Faction_FormlessSword</defName>
    <label>formless sword sect</label>
    <description>A sect of swordsmen who teach that steel can break, but true intent endures. Four thousand years ago the Sword Saint Qing Feng split a mountain with a single stroke and stayed on the summit to cultivate; his heirs say he never drew the blade. After the Convergence they seek to rebuild the teachings lost in the Iron Calamity, and disciples able to understand a cut before making it. They have no quarrel with technology: their oldest swords were forged from the shells of fallen machines.</description>
    <fixedName>Formless Sword Sect</fixedName>
    <factionIconPath>World/CVG/Factions/FormlessSword</factionIconPath>
    <royalFavorIconPath>UI/Icons/CVG/Contribution/FormlessSword</royalFavorIconPath>
    <pawnSingular>sword disciple</pawnSingular>
    <pawnsPlural>sword disciples</pawnsPlural>
    <categoryTag>CVG_Sect_FormlessSword</categoryTag>
    <royalTitleTags><li>CVG_FormlessSwordTitle</li></royalTitleTags>
    <settlementNameMaker>CVG_NamerSettlement_FormlessSword</settlementNameMaker>
    <!-- Near white: the faction icon is tinted with this color, and the emblem art already has its own colors. -->
    <colorSpectrum>
      <li>(1.00,1.00,1.00)</li>
      <li>(0.92,0.92,0.92)</li>
    </colorSpectrum>
    <!-- Fixed ideoligion: our name, founder and precepts; nothing random from vanilla Ideology (GameComponent_SectIdeos does the rest). -->
    <forcedMemes><li>CVG_Meme_SwordWay</li><li>CVG_Structure_DaoOrigin</li></forcedMemes>
    <fixedIdeo>true</fixedIdeo>
    <ideoName>Way of the Formless Sword</ideoName>
    <ideoDescription>Steel can break; true intent endures. The Formless Sword follows the path of the Sword Saint Qing Feng, who split a mountain with a single stroke and never drew the blade again: understand the cut before making it, and the sword will follow.</ideoDescription>
    <deityPresets>
      <li>
        <nameType><name>Qing Feng</name><type>Sword Saint of the Split Mountain</type></nameType>
        <gender>Male</gender>
        <iconPath>UI/Deities/DeityGeneric</iconPath>
      </li>
    </deityPresets>
    <requiredPreceptsOnly>true</requiredPreceptsOnly>
    <styles />
    <basicMemberKind>CVG_FormlessSword_Disciple</basicMemberKind>
    <fixedLeaderKinds><li>CVG_FormlessSword_Elder</li></fixedLeaderKinds>
    <caravanTraderKinds Inherit="False"><li>CVG_Trader_FormlessSword</li></caravanTraderKinds>
    <visitorTraderKinds Inherit="False"><li>CVG_Trader_FormlessSword</li></visitorTraderKinds>
    <baseTraderKinds Inherit="False"><li>CVG_Trader_FormlessSwordSettlement</li></baseTraderKinds>
    <pawnGroupMakers Inherit="False">
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <CVG_FormlessSword_Disciple>10</CVG_FormlessSword_Disciple>
          <CVG_FormlessSword_Bearer>7</CVG_FormlessSword_Bearer>
          <CVG_FormlessSword_Blade>4</CVG_FormlessSword_Blade>
          <CVG_FormlessSword_Elder>1.5</CVG_FormlessSword_Elder>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <CVG_FormlessSword_Disciple>10</CVG_FormlessSword_Disciple>
          <CVG_FormlessSword_Bearer>7</CVG_FormlessSword_Bearer>
          <CVG_FormlessSword_Blade>4</CVG_FormlessSword_Blade>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <CVG_FormlessSword_Swordsmith>1</CVG_FormlessSword_Swordsmith>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Dromedary>5</Dromedary>
        </carriers>
        <guards>
          <CVG_FormlessSword_Disciple>10</CVG_FormlessSword_Disciple>
          <CVG_FormlessSword_Bearer>7</CVG_FormlessSword_Bearer>
          <CVG_FormlessSword_Blade>4</CVG_FormlessSword_Blade>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <CVG_FormlessSword_Disciple>10</CVG_FormlessSword_Disciple>
          <CVG_FormlessSword_Bearer>7</CVG_FormlessSword_Bearer>
          <CVG_FormlessSword_Blade>4</CVG_FormlessSword_Blade>
          <CVG_FormlessSword_Elder>1.5</CVG_FormlessSword_Elder>
        </options>
      </li>
    </pawnGroupMakers>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectIdeo">
        <icon>CVG_IdeoIcon_SwordWay</icon>
        <color>CVG_IdeoColor_Natural</color>
        <leaderIconPath>UI/Roles/CVG/FormlessSword_Leader</leaderIconPath>
        <elderIconPath>UI/Roles/CVG/FormlessSword_Elder</elderIconPath>
      </li>
      <li Class="Convergence.DefModExtension_ConvergenceFaction">
        <extraSettlements>1~2</extraSettlements>
      </li>
    </modExtensions>
  </FactionDef>

  <!-- Disciples: swords only (weapon tag CVG_Sword, no ranged weapons), no Hulk bodies, Sword Body by rank (rarest grade first),
       adult backstory of the sect by rank (FormlessSword_Backstories.xml); childhood stays random. -->
  <PawnKindDef Abstract="True" Name="CVG_FormlessSwordKindBase" ParentName="CVG_Sect2KindBase">
    <defaultFactionDef>CVG_Faction_FormlessSword</defaultFactionDef>
    <nameMaker>CVG_NamerPerson_FormlessSword</nameMaker>
    <weaponTags><li>CVG_Sword</li></weaponTags>
    <apparelTags><li>Neolithic</li><li>MedievalMilitary</li></apparelTags>
    <apparelColor>(0.80,0.86,0.93)</apparelColor>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_FormlessSwordKindBase">
    <defName>CVG_FormlessSword_Disciple</defName>
    <fixedAdultBackstories><li>CVG_Backstory_FS_OuterDisciple</li><li>CVG_Backstory_FS_MoundKeeper</li></fixedAdultBackstories>
    <label>outer sword disciple</label>
    <combatPower>55</combatPower>
    <minGenerationAge>16</minGenerationAge>
    <weaponMoney>150~500</weaponMoney>
    <apparelMoney>150~450</apparelMoney>
    <gearHealthRange>0.6~1.8</gearHealthRange>
    <itemQuality>Normal</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_QiRefining</realm>
        <stage>1~3</stage>
        <manuals><li>CVG_Manual_GoldenEdge</li><li>CVG_Manual_SwordHeart</li></manuals>
        <elements><li>CVG_Element_Metal</li><li>CVG_Element_Water</li></elements>
        <disallowedBodyTypes><li>Hulk</li></disallowedBodyTypes>
        <traitChances>
          <li><trait>CVG_Body_Sword</trait><degree>1</degree><chance>0.03</chance></li>
          <li><trait>CVG_Body_Sword</trait><degree>0</degree><chance>0.30</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_FormlessSwordKindBase">
    <defName>CVG_FormlessSword_Bearer</defName>
    <fixedAdultBackstories><li>CVG_Backstory_FS_InnerBearer</li><li>CVG_Backstory_FS_WanderingBlade</li></fixedAdultBackstories>
    <label>inner sword bearer</label>
    <combatPower>105</combatPower>
    <minGenerationAge>18</minGenerationAge>
    <weaponMoney>300~900</weaponMoney>
    <apparelMoney>300~800</apparelMoney>
    <gearHealthRange>0.8~2</gearHealthRange>
    <itemQuality>Good</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_Foundation</realm>
        <stage>1~2</stage>
        <manuals><li>CVG_Manual_GoldenEdge</li><li>CVG_Manual_SwordHeart</li></manuals>
        <elements><li>CVG_Element_Metal</li><li>CVG_Element_Water</li></elements>
        <disallowedBodyTypes><li>Hulk</li></disallowedBodyTypes>
        <traitChances>
          <li><trait>CVG_Body_Sword</trait><degree>2</degree><chance>0.02</chance></li>
          <li><trait>CVG_Body_Sword</trait><degree>1</degree><chance>0.10</chance></li>
          <li><trait>CVG_Body_Sword</trait><degree>0</degree><chance>0.45</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_FormlessSwordKindBase">
    <defName>CVG_FormlessSword_Blade</defName>
    <fixedAdultBackstories><li>CVG_Backstory_FS_CoreBlade</li><li>CVG_Backstory_FS_TournamentRival</li></fixedAdultBackstories>
    <label>core blade disciple</label>
    <combatPower>140</combatPower>
    <minGenerationAge>20</minGenerationAge>
    <weaponMoney>500~1200</weaponMoney>
    <apparelMoney>400~1000</apparelMoney>
    <gearHealthRange>0.9~2</gearHealthRange>
    <itemQuality>Good</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_Foundation</realm>
        <stage>3~4</stage>
        <manuals><li>CVG_Manual_GoldenEdge</li><li>CVG_Manual_SwordHeart</li></manuals>
        <elements><li>CVG_Element_Metal</li><li>CVG_Element_Water</li></elements>
        <disallowedBodyTypes><li>Hulk</li></disallowedBodyTypes>
        <traitChances>
          <li><trait>CVG_Body_Sword</trait><degree>3</degree><chance>0.005</chance></li>
          <li><trait>CVG_Body_Sword</trait><degree>2</degree><chance>0.06</chance></li>
          <li><trait>CVG_Body_Sword</trait><degree>1</degree><chance>0.25</chance></li>
          <li><trait>CVG_Body_Sword</trait><degree>0</degree><chance>0.60</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_FormlessSwordKindBase">
    <defName>CVG_FormlessSword_Elder</defName>
    <fixedAdultBackstories><li>CVG_Backstory_FS_SwordElder</li><li>CVG_Backstory_FS_DisciplineElder</li></fixedAdultBackstories>
    <label>sword elder</label>
    <combatPower>250</combatPower>
    <minGenerationAge>40</minGenerationAge>
    <maxGenerationAge>160</maxGenerationAge>
    <factionLeader>true</factionLeader>
    <weaponMoney>900~2000</weaponMoney>
    <apparelMoney>600~1400</apparelMoney>
    <gearHealthRange>1~2</gearHealthRange>
    <itemQuality>Excellent</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_GoldenCore</realm>
        <stage>1~3</stage>
        <manuals><li>CVG_Manual_GoldenEdge</li><li>CVG_Manual_SwordHeart</li></manuals>
        <elements><li>CVG_Element_Metal</li><li>CVG_Element_Water</li></elements>
        <disallowedBodyTypes><li>Hulk</li></disallowedBodyTypes>
        <!-- An elder always has the Sword Body: cold steel at least. -->
        <traitChances>
          <li><trait>CVG_Body_Sword</trait><degree>3</degree><chance>0.03</chance></li>
          <li><trait>CVG_Body_Sword</trait><degree>2</degree><chance>0.25</chance></li>
          <li><trait>CVG_Body_Sword</trait><degree>1</degree><chance>1</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <PawnKindDef ParentName="CVG_FormlessSwordKindBase">
    <defName>CVG_FormlessSword_Swordsmith</defName>
    <fixedAdultBackstories><li>CVG_Backstory_FS_Swordsmith</li></fixedAdultBackstories>
    <label>sect swordsmith</label>
    <combatPower>45</combatPower>
    <minGenerationAge>25</minGenerationAge>
    <trader>true</trader>
    <weaponMoney>150~500</weaponMoney>
    <apparelMoney>200~500</apparelMoney>
    <itemQuality>Good</itemQuality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivatorPawnKind">
        <realm>CVG_Realm_QiRefining</realm>
        <stage>2~3</stage>
        <manuals><li>CVG_Manual_GoldenEdge</li></manuals>
        <elements><li>CVG_Element_Metal</li></elements>
        <disallowedBodyTypes><li>Hulk</li></disallowedBodyTypes>
        <traitChances>
          <li><trait>CVG_Body_Sword</trait><degree>0</degree><chance>0.30</chance></li>
        </traitChances>
      </li>
    </modExtensions>
  </PawnKindDef>

  <!-- Trade: swords Good to Masterwork (never Legendary), plus spirit materials and manuals depending on stock. -->
  <TraderKindDef Abstract="True" Name="CVG_TraderFormlessSwordBase">
    <stockGenerators>
      <li Class="StockGenerator_SingleDef"><thingDef>CVG_SpiritStone</thingDef><countRange>25~75</countRange></li>
      <li Class="Convergence.StockGenerator_QualityTag">
        <tradeTag>WeaponMelee</tradeTag>
        <weaponTags><li>CVG_Sword</li></weaponTags>
        <thingDefCountRange>3~6</thingDefCountRange>
        <countRange>1~2</countRange>
        <qualities>
          <li><quality>Good</quality><weight>55</weight></li>
          <li><quality>Excellent</quality><weight>37</weight></li>
          <li><quality>Masterwork</quality><weight>8</weight></li>
        </qualities>
      </li>
      <li Class="StockGenerator_SingleDef"><thingDef>CVG_SpiritStone</thingDef><countRange>20~80</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>CVG_SpiritJade</thingDef><countRange>10~30</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>CVG_JadeSlip</thingDef><countRange>0~2</countRange></li>
      <li Class="StockGenerator_SingleDef" MayRequire="prospero1088.convergence.resources"><thingDef>CVG_SpiritSteel</thingDef><countRange>0~40</countRange></li>
      <li Class="StockGenerator_SingleDef" MayRequire="prospero1088.convergence.alchemy"><thingDef>CVG_SpiritHerb</thingDef><countRange>0~10</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Steel</thingDef><countRange>200~600</countRange></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>WeaponMelee</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Armor</tag></li>
    </stockGenerators>
  </TraderKindDef>

  <TraderKindDef ParentName="CVG_TraderFormlessSwordBase">
    <defName>CVG_Trader_FormlessSword</defName>
    <label>formless sword sect merchant</label>
  </TraderKindDef>

  <TraderKindDef ParentName="CVG_TraderFormlessSwordBase">
    <defName>CVG_Trader_FormlessSwordSettlement</defName>
    <label>formless sword sect settlement</label>
    <commonality>1</commonality>
  </TraderKindDef>

  <!-- Honorary titles -->
  <RoyalTitleDef ParentName="CVG_SectTitle1">
    <defName>CVG_Title_FormlessSword_Friend</defName>
    <label>friend of the Formless Sword</label>
    <description>The sect's first courtesy to an outsider: the gate of the Peak stays open, and its disciples bow before they speak. The Formless Sword says a friend is someone whose intent it has already seen.</description>
    <tags><li>CVG_FormlessSwordTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle2">
    <defName>CVG_Title_FormlessSword_Guest</defName>
    <label>honored guest of the Formless Sword</label>
    <description>An honored guest may sit at the elders' table and watch the morning sword forms, a privilege few disciples are given. In return the sect expects the guest to keep its secrets and answer for its name.</description>
    <tags><li>CVG_FormlessSwordTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle3">
    <defName>CVG_Title_FormlessSword_Protector</defName>
    <label>protector of the Formless Sword</label>
    <description>An outsider who has drawn a blade for the sect is carved into the Sword Mound's register of debts. The Formless Sword pays its debts in kind: a protector who calls will not call alone.</description>
    <tags><li>CVG_FormlessSwordTitle</li></tags>
  </RoyalTitleDef>

  <RoyalTitleDef ParentName="CVG_SectTitle4">
    <defName>CVG_Title_FormlessSword_GuestElder</defName>
    <label>guest elder of the Formless Sword</label>
    <description>A guest elder (客卿长老) holds the rank of an elder without being bound to the sect: no master over them, no vow of obedience. It is the highest honor the Formless Sword gives a stranger, granted perhaps once in a generation.</description>
    <tags><li>CVG_FormlessSwordTitle</li></tags>
  </RoyalTitleDef>

  <!-- The five favors -->
  <RoyalTitlePermitDef ParentName="CVG_SectFavorResources">
    <defName>CVG_Permit_FormlessSword_SpiritResources</defName>
    <label>spirit resources</label>
    <description>The sect sends a sealed chest from its storehouses: spirit stones and spirit jade gathered at the Sword Mound. The elders call it a loan; nobody has ever been asked to repay it.</description>
    <faction>CVG_Faction_FormlessSword</faction>
    <minTitle>CVG_Title_FormlessSword_Friend</minTitle>
    <royalAid>
      <itemsToDrop>
        <CVG_SpiritStone>40</CVG_SpiritStone>
        <CVG_SpiritJade>3</CVG_SpiritJade>
      </itemsToDrop>
    </royalAid>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorReinforcements">
    <defName>CVG_Permit_FormlessSword_Disciples</defName>
    <label>call sword disciples</label>
    <description>Three inner disciples of the Formless Sword come to fight at your side. They will not take a step back from the line, and they will not stay a day longer than the battle.</description>
    <faction>CVG_Faction_FormlessSword</faction>
    <minTitle>CVG_Title_FormlessSword_Guest</minTitle>
    <royalAid>
      <pawnKindDef>CVG_FormlessSword_Bearer</pawnKindDef>
    </royalAid>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorMasterwork">
    <defName>CVG_Permit_FormlessSword_MasterworkSword</defName>
    <label>masterwork sword</label>
    <description>The swordsmiths of the Peak send one blade they would have kept for themselves. It arrives without a name: a sword earns its name in the hand that carries it.</description>
    <faction>CVG_Faction_FormlessSword</faction>
    <minTitle>CVG_Title_FormlessSword_Protector</minTitle>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectGift">
        <options>
          <li><weaponTag>CVG_Sword</weaponTag><quality>Masterwork</quality></li>
        </options>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorExceptional">
    <defName>CVG_Permit_FormlessSword_LegendarySword</defName>
    <label>legendary sword</label>
    <description>A blade taken from the Sword Mound itself, where the masters' swords rest. The sect never sells these: it lends them to those it trusts, and the guest elder chooses which one will answer.</description>
    <faction>CVG_Faction_FormlessSword</faction>
    <minTitle>CVG_Title_FormlessSword_GuestElder</minTitle>
    <modExtensions>
      <li Class="Convergence.Factions.DefModExtension_SectGift">
        <playerChooses>true</playerChooses>
        <options>
          <li MayRequire="prospero1088.convergence.alchemy"><thing>CVG_Jian</thing><quality>Legendary</quality></li>
          <li MayRequire="prospero1088.convergence.alchemy"><thing>CVG_FlyingSword</thing><quality>Legendary</quality></li>
          <li MayRequire="prospero1088.convergence.alchemy"><thing>CVG_Dao</thing><quality>Legendary</quality></li>
          <li><thing>MeleeWeapon_LongSword</thing><quality>Legendary</quality></li>
          <li><thing>MeleeWeapon_MonoSword</thing><quality>Legendary</quality></li>
          <li><thing>MeleeWeapon_PlasmaSword</thing><quality>Legendary</quality></li>
        </options>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

  <RoyalTitlePermitDef ParentName="CVG_SectFavorStrike">
    <defName>CVG_Permit_FormlessSword_SwordStrike</defName>
    <label>sword strike</label>
    <description>Four core blades of the Formless Sword descend where you point and cut through whatever stands there. The sect calls it a courtesy between elders; its enemies call it the falling mountain.</description>
    <faction>CVG_Faction_FormlessSword</faction>
    <minTitle>CVG_Title_FormlessSword_GuestElder</minTitle>
    <royalAid>
      <pawnKindDef>CVG_FormlessSword_Blade</pawnKindDef>
      <pawnCount>4</pawnCount>
    </royalAid>
  </RoyalTitlePermitDef>
</Defs>
