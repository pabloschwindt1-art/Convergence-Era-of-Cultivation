  <PreceptDef>
    <defName>CVG_Ritual_Ascension</defName>
    <label>ascension ceremony</label>
    <description>When a disciple climbs a realm, the sect gathers at the hall to witness it. The master lights three sticks of incense for the Dao, three for the elders and one for the disciple.</description>
    <issue>Ritual</issue>
    <impact>Medium</impact>
    <iconPath>UI/Icons/Rituals/CVG/Ascension</iconPath>
    <preceptClass>Precept_Ritual</preceptClass>
