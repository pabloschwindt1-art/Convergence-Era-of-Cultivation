  <PreceptDef>
    <defName>CVG_Ritual_Tournament</defName>
    <label>sect tournament</label>
    <description>Once a year the sect clears the courtyard and lets its disciples cross blades in the open. Nobody dies, nobody forgets, and the winner sits at the master's right hand for a night.</description>
    <issue>Ritual</issue>
    <impact>Medium</impact>
    <iconPath>UI/Icons/Rituals/CVG/Tournament</iconPath>
