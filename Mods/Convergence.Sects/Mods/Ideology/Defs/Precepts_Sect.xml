  <PreceptDef>
    <defName>CVG_Cultivation_Obligatory</defName>
    <issue>CVG_Issue_Cultivation</issue>
    <label>obligatory</label>
    <description>Every disciple must sit in cultivation every day. A day without cultivation is a day stolen from the Dao.</description>
    <impact>High</impact>
    <displayOrderInIssue>30</displayOrderInIssue>
    <displayOrderInImpact>1000</displayOrderInImpact>
    <associatedMemes><li>CVG_Meme_SwordWay</li><li>CVG_Meme_LotusPath</li><li>CVG_Meme_CauldronWay</li><li>CVG_Meme_DragonBlood</li></associatedMemes>
    <conflictingMemes><li>CVG_Meme_WanderingPath</li></conflictingMemes>
    <comps>
      <li Class="PreceptComp_SelfTookMemoryThought">
        <eventDef>CVG_Cultivated</eventDef>
        <thought>CVG_Cultivation_Obligatory_Self</thought>
      </li>
      <li Class="PreceptComp_SituationalThought">
        <thought>CVG_Cultivation_Obligatory_Missed</thought>
      </li>
    </comps>
  </PreceptDef>
