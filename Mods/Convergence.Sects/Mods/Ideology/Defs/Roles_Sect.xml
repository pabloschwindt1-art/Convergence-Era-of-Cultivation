<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Sect roles: vanilla role structure (PreceptRoleSingleBase), restricted to ideoligions with a sect doctrine. Icons are provisional vanilla ones. -->
  <PreceptDef ParentName="PreceptRoleSingleBase">
    <defName>CVG_Role_SectMaster</defName>
    <label>sect master</label>
    <description>The master of the sect: the one who taught the first disciples and still decides who may enter. Counsels, reassures and gives the sect its direction. A sect has one, and the position is never inherited by chance.</description>
    <iconPath>UI/Roles/CVG/SectMaster</iconPath>
    <nameMaker>NamerRoleMoralist</nameMaker>
    <displayOrderInImpact>90</displayOrderInImpact>
    <canRemoveInUI>true</canRemoveInUI>
    <requiredMemes><li>CVG_Meme_SwordWay</li><li>CVG_Meme_LotusPath</li><li>CVG_Meme_CauldronWay</li><li>CVG_Meme_DragonBlood</li><li>CVG_Meme_DemonicWay</li><li>CVG_Meme_WanderingPath</li><li>CVG_Meme_BodyWay</li><li>CVG_Meme_ThunderWay</li><li MayRequire="Ludeon.RimWorld.Biotech">CVG_Meme_PuppetPath</li></requiredMemes>
    <roleEffects>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>CVG_CultivationSpeed</statDef>
        <modifier>0.15</modifier>
      </li>
    </roleEffects>
    <grantedAbilities><li>Counsel</li><li>Reassure</li><li>Convert</li></grantedAbilities>
    <roleRequiredWorkTags><li>Social</li></roleRequiredWorkTags>
    <roleTags><li>Moralist</li></roleTags>
  </PreceptDef>
  <PreceptDef ParentName="PreceptRoleSingleBase">
    <defName>CVG_Role_GrandElder</defName>
    <!-- Varios roles de secta: sin el -5 por rol vacío (con 8 roles eran -40 y la colonia colapsaba). -->
    <createsRoleEmptyThought>false</createsRoleEmptyThought>
    <label>grand elder</label>
    <description>The most senior elder, keeper of the sect's memory and its grudges. He does not lead the sect, but no master has ever acted against his wishes for long.</description>
    <iconPath>UI/Roles/CVG/GrandElder</iconPath>
    <nameMaker>NamerRoleMoralist</nameMaker>
    <displayOrderInImpact>90</displayOrderInImpact>
    <canRemoveInUI>true</canRemoveInUI>
    <requiredMemes><li>CVG_Meme_SwordWay</li><li>CVG_Meme_LotusPath</li><li>CVG_Meme_CauldronWay</li><li>CVG_Meme_DragonBlood</li><li>CVG_Meme_DemonicWay</li><li>CVG_Meme_WanderingPath</li><li>CVG_Meme_BodyWay</li><li>CVG_Meme_ThunderWay</li><li MayRequire="Ludeon.RimWorld.Biotech">CVG_Meme_PuppetPath</li></requiredMemes>
    <roleEffects>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>GlobalLearningFactor</statDef>
        <modifier>0.15</modifier>
      </li>
    </roleEffects>
    <grantedAbilities><li>PreachHealth</li></grantedAbilities>
    <roleRequiredWorkTags><li>Social</li></roleRequiredWorkTags>
  </PreceptDef>
  <PreceptDef ParentName="PreceptRoleSingleBase">
    <defName>CVG_Role_SwordElder</defName>
    <!-- Varios roles de secta: sin el -5 por rol vacío (con 8 roles eran -40 y la colonia colapsaba). -->
    <createsRoleEmptyThought>false</createsRoleEmptyThought>
    <label>sword elder</label>
    <description>The elder in charge of the discipline of arms. He fights in melee, trains the young with a wooden sword and has never lost a duel he cared about.</description>
    <iconPath>UI/Roles/CVG/SwordElder</iconPath>
    <nameMaker>NamerRoleMoralist</nameMaker>
    <displayOrderInImpact>90</displayOrderInImpact>
    <canRemoveInUI>true</canRemoveInUI>
    <requiredMemes><li>CVG_Meme_SwordWay</li><li>CVG_Meme_LotusPath</li><li>CVG_Meme_CauldronWay</li><li>CVG_Meme_DragonBlood</li><li>CVG_Meme_DemonicWay</li><li>CVG_Meme_WanderingPath</li><li>CVG_Meme_BodyWay</li><li>CVG_Meme_ThunderWay</li><li MayRequire="Ludeon.RimWorld.Biotech">CVG_Meme_PuppetPath</li></requiredMemes>
    <roleEffects>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>MeleeHitChance</statDef>
        <modifier>5</modifier>
      </li>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>MeleeDodgeChance</statDef>
        <modifier>3</modifier>
      </li>
    </roleEffects>
    <grantedAbilities></grantedAbilities>
    <roleRequiredWorkTags><li>Violent</li></roleRequiredWorkTags>
    <roleRequirements Inherit="False">
      <li Class="RoleRequirement_SameIdeo">
        <labelKey>RoleRequirementLabelSameIdeo</labelKey>
      </li>
      <li Class="RoleRequirement_MinSkillAny">
        <skills>
          <Melee>8</Melee>
        </skills>
      </li>
    </roleRequirements>
  </PreceptDef>
