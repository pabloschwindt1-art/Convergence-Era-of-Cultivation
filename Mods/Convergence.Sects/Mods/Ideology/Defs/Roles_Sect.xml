    <iconPath>UI/Roles/CVG/ScriptureKeeper</iconPath>
    <nameMaker>NamerRoleMoralist</nameMaker>
    <displayOrderInImpact>90</displayOrderInImpact>
    <canRemoveInUI>true</canRemoveInUI>
    <requiredMemes><li>CVG_Meme_SwordWay</li><li>CVG_Meme_LotusPath</li><li>CVG_Meme_CauldronWay</li><li>CVG_Meme_DragonBlood</li><li>CVG_Meme_DemonicWay</li><li>CVG_Meme_WanderingPath</li><li>CVG_Meme_BodyWay</li><li>CVG_Meme_ThunderWay</li><li MayRequire="Ludeon.RimWorld.Biotech">CVG_Meme_PuppetPath</li></requiredMemes>
    <roleEffects>
      <li Class="RoleEffect_PawnStatOffset">
        <statDef>GlobalLearningFactor</statDef>
        <modifier>0.25</modifier>
      </li>
    </roleEffects>
    <grantedAbilities></grantedAbilities>
    <roleRequiredWorkTags><li>Social</li></roleRequiredWorkTags>
  </PreceptDef>
  <PreceptDef ParentName="PreceptRoleSingleBase" MayRequire="Ludeon.RimWorld.Biotech">
    <defName>CVG_Role_PuppetMaster</defName>
    <!-- Varios roles de secta: sin el -5 por rol vacío (con 8 roles eran -40 y la colonia colapsaba). -->
    <createsRoleEmptyThought>false</createsRoleEmptyThought>
    <label>puppet master</label>
    <description>The disciple who commands the sect's puppets from behind a screen of strings. He does not need to be strong; he needs to be patient, and to have forgotten how to be lonely.</description>
    <iconPath>UI/Roles/CVG/PuppetMaster</iconPath>
    <nameMaker>NamerRoleMoralist</nameMaker>
    <displayOrderInImpact>90</displayOrderInImpact>
    <canRemoveInUI>true</canRemoveInUI>
    <requiredMemes><li>CVG_Meme_SwordWay</li><li>CVG_Meme_LotusPath</li><li>CVG_Meme_CauldronWay</li><li>CVG_Meme_DragonBlood</li><li>CVG_Meme_DemonicWay</li><li>CVG_Meme_WanderingPath</li><li>CVG_Meme_BodyWay</li><li>CVG_Meme_ThunderWay</li><li MayRequire="Ludeon.RimWorld.Biotech">CVG_Meme_PuppetPath</li></requiredMemes>
