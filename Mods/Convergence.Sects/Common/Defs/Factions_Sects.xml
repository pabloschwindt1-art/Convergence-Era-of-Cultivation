<Defs>
  <!-- The sects are normal factions of the world, chosen at world creation like the vanilla ones (one of each, removable).
       Saves from before this change get them at the Convergence (DefModExtension_ConvergenceFaction in Core). -->
  <FactionDef ParentName="OutlanderFactionBase">
    <defName>CVG_Faction_AzurePeak</defName>
    <factionIconPath>World/CVG/Factions/AzurePeak</factionIconPath>
    <label>azure peak sword sect</label>
    <description>A sect of swordsmen on a peak split by a single stroke, four thousand years ago. Proud and strict, they temper the Will of the Sword and answer any slight to the honor of the Peak with a duel. They forge with metal, qi and, if needed, with whatever the Rim brings: they have no quarrel with technology. Neutral and fair at first; they trade blades and spirit metals.</description>
    <fixedName>Azure Peak Sword Sect</fixedName>
    <pawnSingular>sword disciple</pawnSingular>
    <pawnsPlural>sword disciples</pawnsPlural>
    <leaderTitle>sect master</leaderTitle>
    <categoryTag>CVG_Sect_AzurePeak</categoryTag>
    <listOrderPriority>40</listOrderPriority>
    <techLevel>Medieval</techLevel>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <startingCountAtWorldCreation>1</startingCountAtWorldCreation>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>60</configurationListOrderPriority>
    <backstoryFilters>
      <li>
        <categories><li>CVG_Cultivation</li></categories>
        <commonality>2</commonality>
      </li>
    </backstoryFilters>
    <structureMemeWeights Inherit="False">
      <CVG_Structure_DaoOrigin MayRequire="Ludeon.RimWorld.Ideology">3</CVG_Structure_DaoOrigin>
      <CVG_Structure_HeavenMandate MayRequire="Ludeon.RimWorld.Ideology">2</CVG_Structure_HeavenMandate>
      <Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
    </structureMemeWeights>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <earliestRaidDays>8</earliestRaidDays>
    <canSiege>false</canSiege>
    <settlementNameMaker>CVG_NamerSettlement_AzurePeak</settlementNameMaker>
