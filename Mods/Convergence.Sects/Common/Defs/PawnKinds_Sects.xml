<Defs>
  <!-- Base of every sect pawn kind: a humanlike combatant. Realm, stage, manuals and root come from DefModExtension_CultivatorPawnKind (Core). -->
  <PawnKindDef Abstract="True" Name="CVG_SectKindBase">
    <race>Human</race>
    <chemicalAddictionChance>0.02</chemicalAddictionChance>
    <invNutrition>2.55</invNutrition>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <maxGenerationAge>75</maxGenerationAge>
    <apparelAllowHeadgearChance>0.3</apparelAllowHeadgearChance>
    <initialWillRange>0~2</initialWillRange>
    <initialResistanceRange>14~24</initialResistanceRange>
    <xenotypeSet Inherit="False">
      <xenotypeChances />
    </xenotypeSet>
  </PawnKindDef>

  <!-- Azure Peak Sword Sect -->
  <PawnKindDef ParentName="CVG_SectKindBase">
