<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Jiangshi (docs/modulos/BIOTECH_WUXIA.md §3), only with Anomaly: a mutant like the shambler (entities faction,
    holding platform, codex knowledge), its claws drain yang (corpse qi on the victim), the sun burns it, peach wood
    hurts it x3 (DefModExtension_StuffWeakness), the bagua mirror dazes it and glutinous rice draws the corpse qi out
    (a vanilla operation). Event: Night of the Hungry Ghosts.
  -->

  <!-- ===== Corpse qi (what the claws leave) ===== -->

  <DamageDef>
    <defName>CVG_YangDrain</defName>
    <label>yang drain</label>
    <workerClass>Convergence.DamageWorker_YangDrain</workerClass>
    <harmsHealth>false</harmsHealth>
    <externalViolence>false</externalViolence>
    <hediff>CVG_CorpseQi</hediff>
    <deathMessage>{0} has been drained of yang.</deathMessage>
  </DamageDef>

  <HediffDef>
    <defName>CVG_CorpseQi</defName>
    <label>corpse qi</label>
    <description>Cold, stagnant yin left in the meridians by the claws of a jiangshi, which drinks the yang of the living through the wound. The patient feels heavy and sleepy and their limbs go numb. The masters of the Hall of Nine Talismans drew it out with a poultice of glutinous rice, which turns black as it absorbs the corpse qi. It also fades on its own if the patient rests.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.7, 0.6)</defaultLabelColor>
    <isBad>true</isBad>
    <maxSeverity>1</maxSeverity>
    <initialSeverity>0.05</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.12</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>faint</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.05</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>spreading</label>
        <restFallFactor>1.3</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>deep</label>
        <restFallFactor>1.6</restFallFactor>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.3</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- ===== The jiangshi ===== -->

  <HediffDef>
    <defName>CVG_Jiangshi</defName>
    <label>jiangshi</label>
    <description>A corpse that did not rest. When the Convergence poured qi back into the world, it also woke the yin that sleeps in badly buried bodies: they rise stiff, arms stretched out, and hop toward the warmth of the living to drink their yang. Sunlight burns them, peach wood cuts them like a blade cuts paper and a bagua mirror throws back their own death at them.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <everCurableByItem>false</everCurableByItem>
    <duplicationAllowed>false</duplicationAllowed>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <stages>
      <li>
        <naturalHealingFactor>0.3</naturalHealingFactor>
        <painFactor>0</painFactor>
        <statFactors>
          <MeleeCooldownFactor>1.2</MeleeCooldownFactor>
          <PsychicSensitivity>0</PsychicSensitivity>
        </statFactors>
        <statOffsets>
          <ComfyTemperatureMin>-60</ComfyTemperatureMin>
          <ComfyTemperatureMax>30</ComfyTemperatureMax>
          <MinimumContainmentStrength>30</MinimumContainmentStrength>
          <ToxicResistance>1</ToxicResistance>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Talking</capacity>
            <postFactor>0</postFactor>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.7</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="Convergence.HediffCompProperties_SunBurn">
        <damage>2</damage>
        <intervalTicks>250</intervalTicks>
        <minSkyGlow>0.5</minSkyGlow>
        <fleck>Smoke</fleck>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <modExtensions>
      <li Class="Convergence.DefModExtension_StuffWeakness">
        <stuff>CVG_PeachWood</stuff>
        <weapons>
          <li>CVG_PeachWoodSword</li>
        </weapons>
        <factor>3</factor>
      </li>
    </modExtensions>
  </HediffDef>

  <MutantDef ParentName="BaseMutantEntity">
    <defName>CVG_Jiangshi</defName>
    <label>jiangshi</label>
    <description>A hopping corpse raised by the yin that the Convergence woke. It drinks the yang of the living through its claws and leaves corpse qi in the wound.\n\nAbout jiangshi: they come at night and the sun burns them. Peach wood weapons hurt them three times as much, a bagua mirror dazes them and a poultice of glutinous rice draws the corpse qi out of the wounded. In the old stories the Taoist priests of Xiangxi drove them home by night, ringing a bell, with a talisman on each forehead.</description>
    <hediff>CVG_Jiangshi</hediff>
    <thinkTree>Shambler</thinkTree>
    <thinkTreeConstant>ShamblerConstant</thinkTreeConstant>
    <hideLabel>true</hideLabel>
    <namePrefix>jiangshi </namePrefix>
    <useCorpseGraphics>true</useCorpseGraphics>
    <isConsideredCorpse>true</isConsideredCorpse>
    <bloodDef>Filth_DarkBlood</bloodDef>
    <bloodSmearDef>Filth_DarkBloodSmear</bloodSmearDef>
    <entitledToMedicalCare>false</entitledToMedicalCare>
    <removeAllInjuries>true</removeAllInjuries>
    <restoreLegs>true</restoreLegs>
    <defaultFaction>Entities</defaultFaction>
    <canOpenDoors>false</canOpenDoors>
    <makesFootprints>false</makesFootprints>
    <tameable>false</tameable>
    <clearMutantStatusOnDeath>true</clearMutantStatusOnDeath>
    <canTravelInCaravan>false</canTravelInCaravan>
    <respectsAllowedArea>false</respectsAllowedArea>
    <disableFlying>true</disableFlying>
    <canGainXP>false</canGainXP>
    <canBeDrafted>false</canBeDrafted>
    <disableHostilityResponse>true</disableHostilityResponse>
    <deathOnDownedChance>0.5</deathOnDownedChance>
    <woundColor>(0.35, 0.45, 0.4, 1.0)</woundColor>
    <anomalyKnowledgeOffset>0.5</anomalyKnowledgeOffset>
    <knowledgeCategory>Basic</knowledgeCategory>
    <soundAttackChance>0.25</soundAttackChance>
    <soundCall>Pawn_Shambler_Call</soundCall>
    <soundAttack>Pawn_Shambler_Attack</soundAttack>
    <soundWounded>Pawn_Shambler_Wounded</soundWounded>
    <soundDeath>Pawn_Shambler_Killed</soundDeath>
    <tools>
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <extraMeleeDamages>
          <li>
            <def>CVG_YangDrain</def>
            <amount>6</amount>
          </li>
        </extraMeleeDamages>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <extraMeleeDamages>
          <li>
            <def>CVG_YangDrain</def>
            <amount>6</amount>
          </li>
        </extraMeleeDamages>
      </li>
    </tools>
  </MutantDef>

  <PawnKindDef ParentName="MutantBase">
    <defName>CVG_Jiangshi</defName>
    <label>jiangshi</label>
    <mutant>CVG_Jiangshi</mutant>
    <generateInitialNonFamilyRelations>false</generateInitialNonFamilyRelations>
    <combatPower>55</combatPower>
    <gearHealthRange>0.2~0.5</gearHealthRange>
    <itemQuality>Poor</itemQuality>
    <apparelMoney>0~300</apparelMoney>
    <apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>Neolithic</li>
    </apparelTags>
  </PawnKindDef>

  <HediffDef>
    <defName>CVG_BaguaDazed</defName>
    <label>dazed by the bagua</label>
    <description>The bagua mirror threw this creature's own death back at it. It staggers and hits badly for a while.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>-6</MeleeHitChance>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <postFactor>0.5</postFactor>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- ===== Wards: peach wood, bagua mirror, glutinous rice ===== -->

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_PeachWood</defName>
    <label>peach wood</label>
    <description>Planks of peach tree soaked in talisman ash and cured over a spirit stone. Since the Yellow Emperor's time the peach tree has stood at the gate between the living and the dead: Shentu and Yulei, the door gods, tied evil spirits with reeds under a great peach tree. Weapons of this wood hurt jiangshi and other restless dead three times as much.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_PeachWood</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>Wood_Drop</soundInteract>
    <soundDrop>Wood_Drop</soundDrop>
    <statBases>
      <MarketValue>2.5</MarketValue>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>0.4</Mass>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
      <StuffPower_Armor_Sharp>0.54</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.54</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.40</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>8</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>4</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>0.45</SharpDamageMultiplier>
      <BluntDamageMultiplier>0.95</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>true</burnableByRecipe>
    <healthAffectsPrice>false</healthAffectsPrice>
    <stackLimit>75</stackLimit>
    <stuffProps>
      <stuffAdjective>peach wood</stuffAdjective>
      <categories>
        <li>Woody</li>
      </categories>
      <commonality>0</commonality>
      <color>(196,120,110)</color>
      <constructEffect>ConstructWood</constructEffect>
      <appearance>Planks</appearance>
      <soundImpactBullet>BulletImpact_Wood</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Wood</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Wood</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Wood</soundImpactMelee>
      <statFactors>
        <Beauty>1.2</Beauty>
        <WorkToMake>0.7</WorkToMake>
        <WorkToBuild>0.7</WorkToBuild>
        <MaxHitPoints>0.65</MaxHitPoints>
        <Flammability>1</Flammability>
        <MeleeWeapon_CooldownMultiplier>0.9</MeleeWeapon_CooldownMultiplier>
      </statFactors>
    </stuffProps>
  </ThingDef>

  <RecipeDef>
    <defName>CVG_MakePeachWood</defName>
    <label>cure peach wood</label>
    <description>Soak peach timber in talisman ash and cure it over a spirit stone, the way the exorcists of the Hall of Nine Talismans prepared their swords.</description>
    <jobString>Curing peach wood.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>CVG_PeachTimber</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>CVG_SpiritStone</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>CVG_PeachTimber</li>
        <li>CVG_SpiritStone</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <CVG_PeachWood>25</CVG_PeachWood>
    </products>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
  </RecipeDef>

  <ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
    <defName>CVG_PeachWoodSword</defName>
    <label>peach wood sword</label>
    <description>A Taoist sword of peach wood with a row of copper coins along its spine. It is a poor blade against the living, but every exorcist from Maoshan to Xiangxi carries one: it cuts the yin of jiangshi and restless dead three times as deep as steel.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponMelee/CVG_PeachWoodSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <costList>
      <CVG_PeachWood>60</CVG_PeachWood>
      <CVG_SpiritStone>2</CVG_SpiritStone>
    </costList>
    <statBases>
      <WorkToMake>6000</WorkToMake>
      <Mass>1.2</Mass>
      <MarketValue>160</MarketValue>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <tools>
      <li>
        <label>point</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.9</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>CraftingSpot</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>CVG_BaguaMirror</defName>
    <label>bagua mirror</label>
    <description>A round mirror of polished silver in a frame of the eight trigrams. Hung over doors since the Han dynasty, it shows evil spirits their own true face. Jiangshi and other restless dead within sight of it are dazed and burned a little every few seconds.</description>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Building/CVG/BaguaMirror</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
    </graphicData>
    <designationCategory>Anomaly</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.2</fillPercent>
    <rotatable>false</rotatable>
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Mass>4</Mass>
      <Flammability>0.4</Flammability>
      <Beauty>4</Beauty>
    </statBases>
    <costList>
      <Silver>40</Silver>
      <CVG_PeachWood>20</CVG_PeachWood>
    </costList>
    <placeWorkers>
      <li>Convergence.PlaceWorker_BaguaMirror</li>
    </placeWorkers>
    <comps>
      <li Class="Convergence.CompProperties_BaguaMirror">
        <radius>7.9</radius>
        <affectedHediffs>
          <li>CVG_Jiangshi</li>
          <li>Shambler</li>
        </affectedHediffs>
        <hediff>CVG_BaguaDazed</hediff>
        <damage>3</damage>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_GlutinousRicePoultice</defName>
    <label>glutinous rice poultice</label>
    <description>Sticky rice steamed and pressed into a cloth. Laid on a jiangshi wound it turns black as it draws the corpse qi out, and an exorcist changes it until it stays white. Old women in Guangdong still keep a sack of glutinous rice behind the door, just in case.</description>
    <graphicData>
      <texPath>Things/Item/CVG_GlutinousRicePoultice</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>12</MarketValue>
      <Mass>0.2</Mass>
      <Flammability>0.8</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Medicine</li>
    </thingCategories>
  </ThingDef>

  <RecipeDef>
    <defName>CVG_MakeGlutinousRicePoultice</defName>
    <label>make glutinous rice poultices</label>
    <description>Steam rice and press it into cloth poultices that draw out corpse qi.</description>
    <jobString>Making rice poultices.</jobString>
    <workAmount>600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RawRice</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RawRice</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <CVG_GlutinousRicePoultice>3</CVG_GlutinousRicePoultice>
    </products>
    <recipeUsers>
      <li>CraftingSpot</li>
      <li>Campfire</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef ParentName="SurgeryFlesh">
    <defName>CVG_DrawCorpseQi</defName>
    <label>draw out corpse qi</label>
    <description>Lay glutinous rice poultices on the jiangshi wounds until they stop turning black.</description>
    <workerClass>Recipe_RemoveHediff</workerClass>
    <jobString>drawing corpse qi out of TargetA.</jobString>
    <workAmount>800</workAmount>
    <hideBodyPartNames>true</hideBodyPartNames>
    <targetsBodyPart>false</targetsBodyPart>
    <anesthetize>false</anesthetize>
    <surgerySuccessChanceFactor>3</surgerySuccessChanceFactor>
    <removesHediff>CVG_CorpseQi</removesHediff>
    <successfullyRemovedHediffMessage>{0} has drawn the corpse qi out of {1}.</successfullyRemovedHediffMessage>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>CVG_GlutinousRicePoultice</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>CVG_GlutinousRicePoultice</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
  </RecipeDef>

  <!-- ===== Event ===== -->

  <IncidentDef>
    <defName>CVG_JiangshiNight</defName>
    <label>night of the hungry ghosts</label>
    <category>ThreatBig</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>Convergence.IncidentWorker_JiangshiNight</workerClass>
    <baseChance>0.6</baseChance>
    <minRefireDays>12</minRefireDays>
    <earliestDay>8</earliestDay>
    <pointsScaleable>true</pointsScaleable>
    <letterLabel>Night of the hungry ghosts</letterLabel>
    <letterText>{COUNT} jiangshi are hopping toward the colony. The Convergence woke the yin in old graves, and the dead came looking for the warmth of the living.\n\nThey drink yang with their claws. The sun burns them, peach wood hurts them three times as much and a bagua mirror dazes them. Glutinous rice poultices draw the corpse qi out of the wounded.</letterText>
    <letterDef>ThreatBig</letterDef>
    <modExtensions>
      <li Class="Convergence.DefModExtension_JiangshiIncident">
        <pawnKind>CVG_Jiangshi</pawnKind>
        <!-- At least 1, not 2 (playtest 2026-10-24: 2 jiangshi of 55 points each for a 50-point threat). -->
        <count>1~14</count>
        <fromHour>20</fromHour>
        <toHour>4</toHour>
      </li>
    </modExtensions>
  </IncidentDef>
</Defs>
