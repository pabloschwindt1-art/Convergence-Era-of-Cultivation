<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Puppet weapons (docs/revision/REVISION_BiotechWuxia.md, item 2). Same pattern as the vanilla light mech guns
    (LightMechanoidGunRanged: destroyOnDrop, tradeability None, relicChance 0): built into the puppet, never dropped.
    Own weapon tag (CVG_PuppetJadeNeedle) so only puppets get it and puppets get nothing else. The repeating crossbow was removed
    (2026-10-23): no puppet used it after the bronze guardian became a melee fighter.
  -->

  <!-- ================= Jade needle caster ================= -->
  <ThingDef ParentName="LightMechanoidGunRanged">
    <defName>CVG_PuppetGun_JadeNeedle</defName>
    <label>jade needle caster</label>
    <description>Embroiderers of the Thousand Strings Valley were said to be the deadliest women in Jiuxiao: a needle that can carry a thread through silk can carry qi through armor. The jade guardian flings needles of spirit jade charged by its beast core; they are thin, fast and pierce armor. It is part of the puppet and breaks if torn out.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/CVG_PuppetJadeNeedle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>900</MarketValue>
      <Mass>1</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.75</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>CVG_PuppetJadeNeedle</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CVG_Needle_PuppetJade</defaultProjectile>
        <warmupTime>0.9</warmupTime>
        <range>24.9</range>
        <burstShotCount>2</burstShotCount>
        <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
        <soundCast>Bow_Small</soundCast>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>CVG_Needle_PuppetJade</defName>
    <label>jade needle</label>
    <graphicData>
      <texPath>Things/Projectile/Needle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(120, 210, 150)</color>
    </graphicData>
    <projectile>
      <damageDef>ArrowHighVelocity</damageDef>
      <damageAmountBase>11</damageAmountBase>
      <armorPenetrationBase>0.45</armorPenetrationBase>
      <stoppingPower>0.5</stoppingPower>
      <speed>70</speed>
    </projectile>
  </ThingDef>
</Defs>
