<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Puppet roster, part 2 (docs/modulos/BIOTECH_WUXIA.md): miner, mason (construction + farming) and blade (melee).
       Together with the wooden (haul/clean), bronze guardian (melee tank) and jade guardian (elite) puppets: one clear role each.
       They are light mechs with CompPuppet (CVG_PuppetRaceBase): the master's realm scales speed, damage and work speed.
       Textures: tinted vanilla mech sprites; final art Things/Pawn/Puppet/CVG_<Name>. -->

  <!-- ================= Miner ================= -->
  <ThingDef ParentName="CVG_PuppetRaceBase">
    <defName>CVG_Puppet_Miner</defName>
    <label>pickaxe puppet</label>
    <description>The Thousand Strings Valley was dug out of its mountain by puppets before it was ever lived in by puppeteers. This squat bronze-handed puppet bites into rock with a pick of spirit steel and never asks what is on the other side. It mines for its master and grows stronger as the master's realm rises.

Work puppet (tier 1): mining, smithing and firefighting. It defends itself with its pick. Stiffens in the cold (iron joints). 1 thread. Built from 35 spirit steel, 12 spirit thread and 1 blueprint.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <MiningSpeed>0.9</MiningSpeed>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
    </statBases>
    <race>
      <mechFixedSkillLevel>8</mechFixedSkillLevel>
      <mechEnabledWorkTypes>
        <li>Mining</li>
        <li>Smithing</li>
        <li>Firefighter</li>
      </mechEnabledWorkTypes>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Constructoid_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Constructoid_Death</soundDeath>
          <soundCall>Pawn_Mech_Constructoid_Call</soundCall>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Constructoid_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Constructoid_Death</soundDeath>
          <soundCall>Pawn_Mech_Constructoid_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>pick</label>
        <capacities>
          <li>Stab</li>
          <li>Blunt</li>
        </capacities>
        <power>13</power>
        <cooldownTime>2.6</cooldownTime>
        <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <modExtensions>
      <li Class="Convergence.DefModExtension_PuppetTier">
        <tier>1</tier>
        <materialHediff>CVG_PuppetMaterial_Iron</materialHediff>
      </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="NonCombatLightMechanoidKind">
    <defName>CVG_Puppet_Miner</defName>
    <label>pickaxe puppet</label>
    <race>CVG_Puppet_Miner</race>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/CVG/Puppet/Miner</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.35</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/CVG/Puppet/Miner</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.35</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <!-- ================= Mason (construction + farming) ================= -->
  <ThingDef ParentName="CVG_PuppetRaceBase">
    <defName>CVG_Puppet_Mason</defName>
    <label>mason puppet</label>
    <description>Every sect that ever raised a hall had a mason puppet that outlived the architect. Four patient arms of spirit wood lay stones, drive pegs and, between buildings, sow and cut the grain that feeds the sect. It builds and tends the fields for its master and grows stronger as the master's realm rises.

Work puppet (tier 1): construction, crafting, tailoring and cooking. It defends itself with its mallet arm. Stiffens in the cold (iron joints). 1 thread. Built from 40 spirit wood, 10 spirit steel, 12 spirit thread and 1 blueprint.</description>
    <statBases>
      <MoveSpeed>3.0</MoveSpeed>
      <ConstructionSpeed>0.5</ConstructionSpeed>
      <PlantWorkSpeed>0.8</PlantWorkSpeed>
    </statBases>
    <race>
      <mechFixedSkillLevel>8</mechFixedSkillLevel>
      <mechEnabledWorkTypes>
        <li>Construction</li>
        <li>Crafting</li>
        <li>Tailoring</li>
        <li>Cooking</li>
      </mechEnabledWorkTypes>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Agrihand_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Agrihand_Death</soundDeath>
          <soundCall>Pawn_Mech_Agrihand_Call</soundCall>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Agrihand_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Agrihand_Death</soundDeath>
          <soundCall>Pawn_Mech_Agrihand_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>mallet arm</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2.9</cooldownTime>
        <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <modExtensions>
      <li Class="Convergence.DefModExtension_PuppetTier">
        <tier>1</tier>
        <materialHediff>CVG_PuppetMaterial_Iron</materialHediff>
      </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="NonCombatLightMechanoidKind">
    <defName>CVG_Puppet_Mason</defName>
    <label>mason puppet</label>
    <race>CVG_Puppet_Mason</race>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/CVG/Puppet/Mason</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.55</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/CVG/Puppet/Mason</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.55</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

  <!-- ================= Blade (melee) ================= -->
  <ThingDef ParentName="CVG_PuppetRaceBase">
    <defName>CVG_Puppet_Blade</defName>
    <label>twin-blade puppet</label>
    <description>The Valley's duelists trained against a puppet with two blades for arms before they were allowed to hold a sword, and some never graduated. It has no ranged weapon and needs none: it closes the distance and does not stop. It guards its master in melee and grows stronger as the master's realm rises.

War puppet (tier 3): melee, with twin blades; fast. Fights with the strength of its master's realm, up to Nascent Soul. The cold stiffens it only a little. 2 threads. Needs spirit steel threads research and a Golden Core master. Built from 45 spirit steel, 15 spirit thread and 1 blueprint.</description>
    <statBases>
      <BandwidthCost>2</BandwidthCost>
      <MoveSpeed>4.0</MoveSpeed>
      <ArmorRating_Sharp>0.3</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
    </statBases>
    <race>
      <lifeStageAges>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>100</minAge>
          <soundWounded>Pawn_Mech_Militor_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Militor_Death</soundDeath>
          <soundCall>Pawn_Mech_Militor_Call</soundCall>
        </li>
      </lifeStageAges>
    </race>
    <tools>
      <li>
        <label>twin blades</label>
        <capacities>
          <li>Cut</li>
          <li>Stab</li>
        </capacities>
        <power>15</power>
        <cooldownTime>1.7</cooldownTime>
        <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      </li>
    </tools>
    <modExtensions>
      <li Class="Convergence.DefModExtension_PuppetTier">
        <tier>3</tier>
        <combat>true</combat>
        <minMasterRealm>3</minMasterRealm>
        <minMasterStage>1</minMasterStage>
        <capRealm>4</capRealm>
        <capStage>4</capStage>
        <materialHediff>CVG_PuppetMaterial_Steel</materialHediff>
      </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="LightMechanoidKind">
    <defName>CVG_Puppet_Blade</defName>
    <label>twin-blade puppet</label>
    <race>CVG_Puppet_Blade</race>
    <combatPower>60</combatPower>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/CVG/Puppet/Blade</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.7</drawSize>
        </bodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/CVG/Puppet/Blade</texPath>
          <shaderType>Cutout</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.7</drawSize>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponTags Inherit="False" />
  </PawnKindDef>

  <!-- ================= Recipes ================= -->
  <RecipeDef ParentName="CVG_PuppetRecipeBase">
    <defName>CVG_BuildPuppet_Miner</defName>
    <label>bind pickaxe puppet</label>
    <description>Cast and bind a pickaxe work puppet (mining, smithing and firefighting).</description>
    <ingredients>
      <li>
        <filter><thingDefs><li>CVG_SpiritSteel</li></thingDefs></filter>
        <count>35</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_SpiritThread</li></thingDefs></filter>
        <count>12</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_PuppetBlueprint</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <CVG_Puppet_Miner>1</CVG_Puppet_Miner>
    </products>
    <descriptionHyperlinks>
      <ThingDef>CVG_Puppet_Miner</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>

  <RecipeDef ParentName="CVG_PuppetRecipeBase">
    <defName>CVG_BuildPuppet_Mason</defName>
    <label>bind mason puppet</label>
    <description>Carve and bind a mason work puppet (construction, crafting, tailoring and cooking).</description>
    <ingredients>
      <li>
        <filter><thingDefs><li>CVG_SpiritWood</li></thingDefs></filter>
        <count>40</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_SpiritSteel</li></thingDefs></filter>
        <count>10</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_SpiritThread</li></thingDefs></filter>
        <count>12</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_PuppetBlueprint</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <CVG_Puppet_Mason>1</CVG_Puppet_Mason>
    </products>
    <descriptionHyperlinks>
      <ThingDef>CVG_Puppet_Mason</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>

  <RecipeDef ParentName="CVG_PuppetRecipeBase">
    <defName>CVG_BuildPuppet_Blade</defName>
    <researchPrerequisite>CVG_Research_SteelThreads</researchPrerequisite>
    <label>bind twin-blade puppet</label>
    <description>Cast and bind a twin-blade war puppet (tier 3: the master must have reached the Golden Core).</description>
    <ingredients>
      <li>
        <filter><thingDefs><li>CVG_SpiritSteel</li></thingDefs></filter>
        <count>45</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_SpiritThread</li></thingDefs></filter>
        <count>15</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_PuppetBlueprint</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <products>
      <CVG_Puppet_Blade>1</CVG_Puppet_Blade>
    </products>
    <descriptionHyperlinks>
      <ThingDef>CVG_Puppet_Blade</ThingDef>
    </descriptionHyperlinks>
  </RecipeDef>
</Defs>
