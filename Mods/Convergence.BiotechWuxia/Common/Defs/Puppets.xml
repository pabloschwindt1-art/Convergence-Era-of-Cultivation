  <ThingDef ParentName="MechGestatorBase">
    <defName>CVG_PuppetWorkshop</defName>
    <label>puppet workshop</label>
    <description>The workshops of the Thousand Strings Valley hummed day and night, their looms fed by the qi of the mountain itself. This carving frame with a binding loom of spirit thread is where a puppet master builds puppets (as a mech gestator). It needs no electricity.</description>
    <graphicData>
      <texPath>Things/Building/CVG/Puppet/PuppetWorkshop</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(3, 2, 1.9)</volume>
      </shadowData>
    </graphicData>
    <uiIconPath>Things/Building/CVG/Puppet/PuppetWorkshop_south</uiIconPath>
    <uiIconScale>1.85</uiIconScale>
    <interactionCellOffset>(1,0,2)</interactionCellOffset>
    <designationCategory>Biotech</designationCategory>
    <recipes>
      <li>CVG_BuildPuppet_Wood</li>
      <li>CVG_BuildPuppet_Miner</li>
      <li>CVG_BuildPuppet_Mason</li>
      <li>CVG_BuildPuppet_Blade</li>
      <li>CVG_BuildPuppet_Bronze</li>
      <li>CVG_BuildPuppet_Jade</li>
    </recipes>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>1</Flammability>
    </statBases>
    <size>(3,2)</size>
    <costList>
      <CVG_SpiritWood>120</CVG_SpiritWood>
      <CVG_SpiritStone>15</CVG_SpiritStone>
    </costList>
    <researchPrerequisites>
      <li>CVG_Research_Puppetry</li>
