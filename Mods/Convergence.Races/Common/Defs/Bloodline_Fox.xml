<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Fox bloodline. Design and values: docs/modulos/razas/ZORRO.md -->

  <Convergence.BloodlineDef>
    <defName>CVG_Bloodline_Fox</defName>
    <label>fox</label>
    <description>The blood of Qingqiu, the guest at the table of the Four: charm, illusions and a mind as quick as fire. Its tails count its purity.\n\nBest as: negotiator and artist. Trade, diplomacy and art; keep it far from the mines.</description>
    <commonality>1.2</commonality>
    <color>(1, 0.6, 0.35)</color>
    <xenotypeIcon>Ears</xenotypeIcon>
    <affinities>
      <li>CVG_Element_Fire</li>
    </affinities>
    <purities>
      <li>
        <purity>CVG_Purity_Trace</purity>
        <gene>CVG_Blood_Fox_Trace</gene>
        <hediff>CVG_Bloodline_Fox</hediff>
        <affinityCultivationFactor>1.05</affinityCultivationFactor>
        <aspectGenes>
          <li>CVG_Fox_Ears</li>
          <li>CVG_Fox_Eyes</li>
          <li>CVG_Fox_Mane</li>
          <li>CVG_Fox_Tail1</li>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Diluted</purity>
        <gene>CVG_Blood_Fox_Diluted</gene>
        <hediff>CVG_Bloodline_Fox</hediff>
        <affinityCultivationFactor>1.1</affinityCultivationFactor>
        <abilities>
          <li>CVG_Ability_FoxCharm</li>
        </abilities>
        <aspectGenes>
          <li>CVG_Fox_Tail3</li>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Pure</purity>
        <gene>CVG_Blood_Fox_Pure</gene>
        <passion>Minor</passion>
        <xenotype>CVG_Xeno_Fox</xenotype>
        <hediff>CVG_Bloodline_Fox</hediff>
        <affinityCultivationFactor>1.2</affinityCultivationFactor>
        <!-- TODO (M5 techniques): Illusion (radius 6 cloud: enemies -50% accuracy) -->
        <aspectGenes>
          <li>CVG_Fox_Tail6</li>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Ancestral</purity>
        <gene>CVG_Blood_Fox_Ancestral</gene>
        <passion>Major</passion>
        <xenotype>CVG_Xeno_Fox</xenotype>
        <hediff>CVG_Bloodline_Fox</hediff>
        <affinityCultivationFactor>1.35</affinityCultivationFactor>
        <!-- TODO (M5 techniques): Nine-Tailed Form (8 h, nine fox-fires) -->
        <aspectGenes>
          <li>CVG_Fox_Tail9</li>
          <li>CVG_Fox_ManeAncestral</li>
        </aspectGenes>
      </li>
    </purities>
  </Convergence.BloodlineDef>

  <!-- Metabolism of the purity genes: total Trace -1, Diluted -2 (a flaw; beast vitality I/II costs -1 of it); Pure and Ancestral compensate the vanilla genes of the
       bloodline xenotype (added on reaching Pure, -3 metabolism) so the total is 0 (Pure) and +1 (Ancestral). -->
  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Fox_Trace</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
    </suppressedTraits>
    <socialFightChanceFactor>2</socialFightChanceFactor>
    <label>trace of fox blood</label>
    <description>A single tail, hidden for now. People simply find themselves liking you. An ancestor slipped through the small rift of the fox's wedding, the rain under sunshine, posing as a merchant or a bard; the mischief came with the charm, and pranks often end in fists.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Fire</iconPath>
    <iconColor>(0.7, 0.7, 0.7)</iconColor>
    <displayOrderInCategory>50</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <aptitudes>
      <Social>1</Social>
      <Artistic>1</Artistic>
      <Mining>-2</Mining>
    </aptitudes>
    <modExtensions>
      <li Class="Convergence.DefModExtension_Bloodline">
        <bloodline>CVG_Bloodline_Fox</bloodline>
        <purity>CVG_Purity_Trace</purity>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Fox_Diluted</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
    </suppressedTraits>
    <socialFightChanceFactor>1.6</socialFightChanceFactor>
    <label>diluted fox blood</label>
    <description>Three tails sway at the edge of vision. Few can tell you apart from a smile. The Court of Qingqiu deceived the Iron Calamity with mirages while selling it plans, and people still cannot decide whether to thank a fox or punch it.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Fire</iconPath>
    <iconColor>(0.55, 0.8, 1)</iconColor>
    <displayOrderInCategory>51</displayOrderInCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <aptitudes>
      <Social>2</Social>
      <Artistic>2</Artistic>
      <Mining>-2</Mining>
    </aptitudes>
    <modExtensions>
      <li Class="Convergence.DefModExtension_Bloodline">
        <bloodline>CVG_Bloodline_Fox</bloodline>
        <purity>CVG_Purity_Diluted</purity>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Fox_Pure</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
    </suppressedTraits>
    <socialFightChanceFactor>1.3</socialFightChanceFactor>
    <label>pure fox blood</label>
    <description>Six tails, a thousand faces. You lie so well that you never have to. Pure foxes serve tribes, corporations and imperial houses as go-betweens, keeping the letter of every deal and walking around its spirit.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Fire</iconPath>
    <iconColor>(0.8, 0.6, 1)</iconColor>
    <displayOrderInCategory>52</displayOrderInCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>3</biostatMet>
    <aptitudes>
      <Social>3</Social>
      <Artistic>3</Artistic>
      <Mining>-1</Mining>
    </aptitudes>
    <modExtensions>
      <li Class="Convergence.DefModExtension_Bloodline">
        <bloodline>CVG_Bloodline_Fox</bloodline>
        <purity>CVG_Purity_Pure</purity>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Fox_Ancestral</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
    </suppressedTraits>
    <socialFightChanceFactor>1.1</socialFightChanceFactor>
    <label>ancestral fox blood</label>
    <description>Nine tails and the fox pearl. The Heavens themselves do not know if you are bowing or laughing. Hu Jiuyao, Queen of Qingqiu, reached nine tails and refused to ascend so that someone would keep the secrets; at this purity the pranks have become diplomacy.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Fire</iconPath>
    <iconColor>(1, 0.82, 0.35)</iconColor>
    <displayOrderInCategory>53</displayOrderInCategory>
    <biostatCpx>4</biostatCpx>
