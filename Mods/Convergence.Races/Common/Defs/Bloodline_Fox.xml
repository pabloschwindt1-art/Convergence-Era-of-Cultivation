  <GeneDef ParentName="CVG_BloodAspectBase">
    <defName>CVG_Fox_Mane</defName>
    <label>fox coat</label>
    <description>Red-orange hair, like a fox in autumn. The courtiers of Qingqiu wear it perfumed and adorned, for the fox values beauty above raw power.</description>
    <iconPath>UI/Icons/Genes/Gene_HairColor</iconPath>
    <iconColor>(225, 110, 45)</iconColor>
    <displayOrderInCategory>57</displayOrderInCategory>
