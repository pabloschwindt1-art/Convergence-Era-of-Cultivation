  <HediffDef ParentName="CVG_BloodlineHediffBase">
    <defName>CVG_Bloodline_Fox</defName>
    <label>fox blood</label>
    <description>Awakened fox blood: beauty, charm and a sharp psychic mind. The body is frail at low purity, and people never fully trust a fox.</description>
    <defaultLabelColor>(1, 0.6, 0.35)</defaultLabelColor>
    <!-- Done in XML: mischief as socialFightChanceFactor 2/1.6/1.3/1.1 on the identity genes. TODO (needs code; see docs/modulos/razas/ZORRO.md): social mistrust (opinion of others), mischief (insult chance), fire/mind technique damage -->
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>trace</label>
        <statOffsets>
          <PawnBeauty>1</PawnBeauty>
          <SocialImpact>0.1</SocialImpact>
          <PsychicSensitivity>0.1</PsychicSensitivity>
          <MeditationFocusGain>0.05</MeditationFocusGain>
          <MeleeDodgeChance>5</MeleeDodgeChance>
          <PainShockThreshold>-0.05</PainShockThreshold>
          <NegotiationAbility>0.15</NegotiationAbility>
          <TradePriceImprovement>0.05</TradePriceImprovement>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>1.05</IncomingDamageFactor>
          <LifespanFactor>1.5</LifespanFactor>
          <CVG_QiMax>1.05</CVG_QiMax>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>diluted</label>
        <statOffsets>
          <PawnBeauty>2</PawnBeauty>
          <SocialImpact>0.25</SocialImpact>
          <PsychicSensitivity>0.25</PsychicSensitivity>
          <MeditationFocusGain>0.1</MeditationFocusGain>
          <MeleeDodgeChance>10</MeleeDodgeChance>
          <PainShockThreshold>-0.1</PainShockThreshold>
          <NegotiationAbility>0.3</NegotiationAbility>
          <TradePriceImprovement>0.1</TradePriceImprovement>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>1.15</IncomingDamageFactor>
          <MeleeDamageFactor>0.9</MeleeDamageFactor>
          <MoveSpeed>1.03</MoveSpeed>
          <LifespanFactor>2.0</LifespanFactor>
          <CVG_QiMax>1.1</CVG_QiMax>
          <CVG_QiRegen>1.05</CVG_QiRegen>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>pure</label>
        <statOffsets>
          <PawnBeauty>3</PawnBeauty>
          <SocialImpact>0.5</SocialImpact>
          <PsychicSensitivity>0.5</PsychicSensitivity>
          <MeditationFocusGain>0.2</MeditationFocusGain>
          <MeleeDodgeChance>15</MeleeDodgeChance>
          <PainShockThreshold>-0.05</PainShockThreshold>
          <NegotiationAbility>0.5</NegotiationAbility>
          <TradePriceImprovement>0.15</TradePriceImprovement>
        </statOffsets>
        <statFactors>
          <IncomingDamageFactor>1.1</IncomingDamageFactor>
          <MeleeDamageFactor>0.95</MeleeDamageFactor>
          <MoveSpeed>1.06</MoveSpeed>
          <LifespanFactor>3.0</LifespanFactor>
          <CVG_QiMax>1.2</CVG_QiMax>
          <CVG_QiRegen>1.15</CVG_QiRegen>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>ancestral</label>
        <statOffsets>
          <PawnBeauty>4</PawnBeauty>
          <SocialImpact>1.0</SocialImpact>
          <PsychicSensitivity>0.8</PsychicSensitivity>
          <MeditationFocusGain>0.3</MeditationFocusGain>
          <MeleeDodgeChance>25</MeleeDodgeChance>
          <NegotiationAbility>0.8</NegotiationAbility>
          <TradePriceImprovement>0.2</TradePriceImprovement>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
          <LifespanFactor>4.0</LifespanFactor>
          <CVG_QiMax>1.3</CVG_QiMax>
          <CVG_QiRegen>1.3</CVG_QiRegen>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <AbilityDef ParentName="CVG_InnateAbilityBase">
    <defName>CVG_Ability_FoxCharm</defName>
    <label>charm</label>
    <description>One glance, and the other decides it was their own idea.\n\nA hostile person within 10 cells is entranced for 15 seconds: they stand still and do not attack. Costs qi if the user cultivates.</description>
    <iconPath>UI/Abilities/CVG_FoxCharm</iconPath>
    <cooldownTicksRange>15000</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9.9</range>
      <warmupTime>0.5</warmupTime>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
        <canTargetAnimals>false</canTargetAnimals>
        <canTargetMechs>false</canTargetMechs>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityQiCost">
        <qiCost>30</qiCost>
      </li>
      <li Class="CompProperties_AbilityEffect">
        <compClass>CompAbilityEffect_OnlyTargetHostiles</compClass>
      </li>
      <li Class="CompProperties_AbilityEffectWithDuration">
        <compClass>CompAbilityEffect_Stun</compClass>
        <durationSecondsOverride>15~15</durationSecondsOverride>
      </li>
      <li Class="CompProperties_AbilityGiveHediff">
