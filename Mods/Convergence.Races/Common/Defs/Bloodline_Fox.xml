        <bloodline>CVG_Bloodline_Fox</bloodline>
        <purity>CVG_Purity_Ancestral</purity>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodAspectBase">
    <defName>CVG_Fox_Ears</defName>
    <label>fox ears</label>
    <description>Pointed fox ears, the color of the hair. In the Court of Qingqiu they were the spies' best tool: they catch a whisper at the far end of a banquet.</description>
    <iconPath>UI/Icons/Genes/CVG/Gene_Fox_Ears</iconPath>
    <iconColor>(225, 110, 45)</iconColor>
    <displayOrderInCategory>55</displayOrderInCategory>
    <exclusionTags>
      <li>Ears</li>
    </exclusionTags>
