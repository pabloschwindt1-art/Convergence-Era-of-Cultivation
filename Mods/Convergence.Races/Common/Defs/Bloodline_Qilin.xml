    <aggroMentalBreakSelectionChanceFactor>0</aggroMentalBreakSelectionChanceFactor>
    <label>diluted qilin blood</label>
    <description>The kindness of the Qilin is thin in you, but it still heals what it touches. Children delivered by the qilin midwives, like Jin Zhi, inherited a thread of their blood: gentle hands, and no wish to raise them in anger.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Earth</iconPath>
    <iconColor>(0.55, 0.8, 1)</iconColor>
    <displayOrderInCategory>31</displayOrderInCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <aptitudes>
      <Plants>2</Plants>
      <Medicine>2</Medicine>
      <Melee>-2</Melee>
    </aptitudes>
    <modExtensions>
      <li Class="Convergence.DefModExtension_Bloodline">
        <bloodline>CVG_Bloodline_Qilin</bloodline>
        <purity>CVG_Purity_Diluted</purity>
      </li>
    </modExtensions>
  </GeneDef>

