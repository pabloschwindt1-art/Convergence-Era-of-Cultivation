  <GeneDef ParentName="CVG_BloodAspectBase">
    <defName>CVG_Qilin_Scales</defName>
    <label>golden scales</label>
    <description>Skin with a golden sheen of fine scales: the dragon scales the qilin wears on a deer's body. They shimmer when the bearer is near someone in pain.</description>
    <iconPath>UI/Icons/Genes/Gene_SkinColorOverride</iconPath>
    <iconColor>(228, 196, 120)</iconColor>
    <displayOrderInCategory>37</displayOrderInCategory>
    <exclusionTags>
      <li>SkinColorOverride</li>
    </exclusionTags>
    <skinColorOverride>(228, 196, 120)</skinColorOverride>
  </GeneDef>

