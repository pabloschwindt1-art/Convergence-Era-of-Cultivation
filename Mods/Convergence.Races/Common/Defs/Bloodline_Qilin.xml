  <GeneDef ParentName="CVG_BloodAspectBase">
    <defName>CVG_Qilin_Mane</defName>
    <label>pale mane</label>
    <description>Pale gold-white hair, soft as a deer's coat. In the Silent Lotus Temple it is never cut, only braided, so that it does not brush the living grass.</description>
    <iconPath>UI/Icons/Genes/Gene_HairColor</iconPath>
    <iconColor>(245, 232, 195)</iconColor>
    <displayOrderInCategory>35</displayOrderInCategory>
    <hairColorOverride>(245, 232, 195)</hairColorOverride>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodAspectBase">
    <defName>CVG_Qilin_Eyes</defName>
    <label>serene eyes</label>
    <description>Calm, pale golden eyes. They say a qilin sees corrupted blood through any disguise, and refuses to keep quiet about it.</description>
