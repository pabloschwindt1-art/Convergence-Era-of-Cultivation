<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Qilin bloodline. Design and values: docs/modulos/razas/QILIN.md -->

  <Convergence.BloodlineDef>
    <defName>CVG_Bloodline_Qilin</defName>
    <label>qilin</label>
    <description>The blood of the Arbiter of the Middle Valleys: calm, kindness and good fortune. It heals, and it does not like to kill.\n\nBest as: healer and farmer. The infirmary and the fields, far from the front line.</description>
    <commonality>0.5</commonality>
    <color>(1, 0.85, 0.45)</color>
    <xenotypeIcon>Crescent</xenotypeIcon>
    <affinities>
      <li>CVG_Element_Earth</li>
      <!-- The Thunder Qilin: thunder roots come from this blood (Pure and Ancestral may awaken one). -->
      <li>CVG_Element_Thunder</li>
    </affinities>
    <purities>
      <li>
        <purity>CVG_Purity_Trace</purity>
        <gene>CVG_Blood_Qilin_Trace</gene>
        <hediff>CVG_Bloodline_Qilin</hediff>
        <affinityCultivationFactor>1.05</affinityCultivationFactor>
        <aspectGenes>
          <li>CVG_Qilin_Mane</li>
          <li>CVG_Qilin_Eyes</li>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Diluted</purity>
        <gene>CVG_Blood_Qilin_Diluted</gene>
        <hediff>CVG_Bloodline_Qilin</hediff>
        <affinityCultivationFactor>1.1</affinityCultivationFactor>
        <abilities>
          <li>CVG_Ability_QilinBlessing</li>
        </abilities>
        <aspectGenes>
          <li>CVG_Qilin_HornSmall</li>
          <li>CVG_Qilin_Scales</li>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Pure</purity>
        <gene>CVG_Blood_Qilin_Pure</gene>
        <passion>Minor</passion>
        <xenotype>CVG_Xeno_Qilin</xenotype>
        <hediff>CVG_Bloodline_Qilin</hediff>
        <affinityCultivationFactor>1.2</affinityCultivationFactor>
        <rootElement>CVG_Element_Thunder</rootElement>
        <rootElementChance>0.25</rootElementChance>
        <!-- TODO (M5 techniques): Purifying Hoof (x2 damage to demonic/void, cleanse corruption) -->
        <aspectGenes>
          <li>CVG_Qilin_Horn</li>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Ancestral</purity>
        <gene>CVG_Blood_Qilin_Ancestral</gene>
        <passion>Major</passion>
        <xenotype>CVG_Xeno_Qilin</xenotype>
        <hediff>CVG_Bloodline_Qilin</hediff>
        <affinityCultivationFactor>1.35</affinityCultivationFactor>
        <rootElement>CVG_Element_Thunder</rootElement>
        <rootElementChance>0.5</rootElementChance>
        <!-- TODO (M5 techniques): Auspicious Domain (map-wide fortune buff) -->
      </li>
    </purities>
  </Convergence.BloodlineDef>

  <!-- Metabolism of the purity genes: total Trace -1, Diluted -2 (a flaw; beast vitality I/II costs -1 of it); Pure and Ancestral compensate the vanilla genes of the
       bloodline xenotype (added on reaching Pure, -5 metabolism) so the total is 0 (Pure) and +1 (Ancestral). -->
  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Qilin_Trace</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
      <li><def>Delicate</def></li>
      <li><def>Wimp</def></li>
      <li><def>Bloodlust</def></li>
      <li><def>Psychopath</def></li>
    </suppressedTraits>
    <forcedTraits>
      <li><def>Kind</def></li>
    </forcedTraits>
    <socialFightChanceFactor>0.3</socialFightChanceFactor>
    <aggroMentalBreakSelectionChanceFactor>0</aggroMentalBreakSelectionChanceFactor>
    <label>trace of qilin blood</label>
    <description>You walk softly, and the grass is grateful. An ancestor shared a forest with the 'sacred deer' of the Four-Footed March, the last qilin hiding on the Rim from the machines; the blood cannot stomach violence, and makes its bearer kind.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Earth</iconPath>
    <iconColor>(0.7, 0.7, 0.7)</iconColor>
    <displayOrderInCategory>30</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <aptitudes>
      <Plants>1</Plants>
      <Medicine>1</Medicine>
      <Melee>-2</Melee>
    </aptitudes>
    <modExtensions>
      <li Class="Convergence.DefModExtension_Bloodline">
        <bloodline>CVG_Bloodline_Qilin</bloodline>
        <purity>CVG_Purity_Trace</purity>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Qilin_Diluted</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
