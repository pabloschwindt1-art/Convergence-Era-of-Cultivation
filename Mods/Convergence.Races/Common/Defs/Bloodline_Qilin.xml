  <HediffDef ParentName="CVG_BloodlineHediffBase">
    <defName>CVG_Bloodline_Qilin</defName>
    <label>qilin blood</label>
    <description>Awakened qilin blood: a calm mind, gentle hands and a body that resists sickness. Killing weighs on it.</description>
    <defaultLabelColor>(1, 0.85, 0.45)</defaultLabelColor>
    <!-- Done in XML: pacifism as socialFightChanceFactor 0.3, aggroMentalBreakSelectionChanceFactor 0 and forced Kind (Trace-Pure) on the identity genes. TODO (needs code; see docs/modulos/razas/QILIN.md): Dao Heart stability, mood aura, fortune, evil detection, 'killed' and corpse/execution thoughts, demon sensitivity -->
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>trace</label>
        <statOffsets>
          <MentalBreakThreshold>-0.02</MentalBreakThreshold>
          <MedicalTendQuality>0.15</MedicalTendQuality>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.05</MoveSpeed>
          <PlantHarvestYield>1.1</PlantHarvestYield>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>diluted</label>
        <statOffsets>
          <MentalBreakThreshold>-0.05</MentalBreakThreshold>
          <ToxicResistance>0.2</ToxicResistance>
          <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
          <MedicalTendQuality>0.3</MedicalTendQuality>
        </statOffsets>
        <statFactors>
          <ImmunityGainSpeed>1.1</ImmunityGainSpeed>
          <LifespanFactor>1.2</LifespanFactor>
          <MeleeDamageFactor>0.9</MeleeDamageFactor>
          <CVG_QiMax>1.05</CVG_QiMax>
          <CVG_QiRegen>1.05</CVG_QiRegen>
          <MoveSpeed>1.1</MoveSpeed>
          <PlantHarvestYield>1.2</PlantHarvestYield>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>pure</label>
        <statOffsets>
          <MentalBreakThreshold>-0.08</MentalBreakThreshold>
          <ToxicResistance>0.4</ToxicResistance>
          <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
          <MedicalTendQuality>0.45</MedicalTendQuality>
        </statOffsets>
        <statFactors>
          <ImmunityGainSpeed>1.25</ImmunityGainSpeed>
          <LifespanFactor>1.5</LifespanFactor>
          <MeleeDamageFactor>0.95</MeleeDamageFactor>
          <CVG_QiMax>1.15</CVG_QiMax>
          <CVG_QiRegen>1.15</CVG_QiRegen>
          <MoveSpeed>1.15</MoveSpeed>
          <PlantHarvestYield>1.3</PlantHarvestYield>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>ancestral</label>
        <statOffsets>
          <MentalBreakThreshold>-0.12</MentalBreakThreshold>
          <ToxicResistance>0.6</ToxicResistance>
          <ArmorRating_Blunt>0.2</ArmorRating_Blunt>
          <MedicalTendQuality>0.6</MedicalTendQuality>
        </statOffsets>
        <statFactors>
          <ImmunityGainSpeed>1.4</ImmunityGainSpeed>
          <LifespanFactor>2.0</LifespanFactor>
          <CVG_QiMax>1.25</CVG_QiMax>
          <CVG_QiRegen>1.3</CVG_QiRegen>
          <MoveSpeed>1.25</MoveSpeed>
          <PlantHarvestYield>1.5</PlantHarvestYield>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <AbilityDef ParentName="CVG_InnateAbilityBase">
    <defName>CVG_Ability_QilinBlessing</defName>
    <label>qilin's blessing</label>
    <description>A warm calm that mends wounds and softens hearts for a few hours.\n\nAllies within 8 cells: +4 mood, +25% wound healing and +15% tend quality for 4 hours (radius and duration grow with the realm). Costs qi if the user cultivates.</description>
    <iconPath>UI/Abilities/CVG_QilinBlessing</iconPath>
    <cooldownTicksRange>20000</cooldownTicksRange>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <targetRequired>false</targetRequired>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>7.9</range>
      <warmupTime>1.5</warmupTime>
      <drawAimPie>false</drawAimPie>
      <requireLineOfSight>false</requireLineOfSight>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityQiCost">
        <qiCost>30</qiCost>
      </li>
      <li Class="Convergence.CompProperties_AbilityGiveHediffInRadius">
        <hediffDef>CVG_QilinBlessed</hediffDef>
        <radius>7.9</radius>
        <fleckDef>PsycastAreaEffect</fleckDef>
      </li>
    </comps>
  </AbilityDef>

  <HediffDef>
    <defName>CVG_QilinBlessed</defName>
    <label>qilin's blessing</label>
    <description>The calm of the qilin: wounds close faster and the heart is lighter.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <defaultLabelColor>(1, 0.85, 0.45)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>10000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <InjuryHealingFactor>1.25</InjuryHealingFactor>
        </statFactors>
        <statOffsets>
          <MedicalTendQuality>0.15</MedicalTendQuality>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>CVG_Thought_QilinBlessed</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>CVG_QilinBlessed</hediff>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>qilin's blessing</label>
        <description>A warm calm, as if the world were kind for a while.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <XenotypeDef>
    <defName>CVG_Xeno_Qilin</defName>
    <label>voice of the lotus</label>
    <description>Monks and healers of the Silent Lotus Temple: pure qilin blood, a golden horn, golden scales and deer ears. Serene and gifted healers, they suffer when they have to kill.</description>
    <descriptionShort>Pure qilin blood: golden horn and scales. Calm healers who dislike killing.</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/Genie</iconPath>
    <inheritable>true</inheritable>
    <nameMaker>CVG_NamerPerson_Qilin</nameMaker>
    <nameMakerFemale>CVG_NamerPerson_Qilin_Female</nameMakerFemale>
    <chanceToUseNameMaker>0.8</chanceToUseNameMaker>
    <genes>
      <li>CVG_Blood_Qilin_Pure</li>
      <li>CVG_Qilin_Mane</li>
      <li>CVG_Qilin_Eyes</li>
      <li>CVG_Qilin_Scales</li>
      <li>CVG_Qilin_Horn</li>
      <li>Mood_Optimist</li>
      <li>Pain_Reduced</li>
      <li>KindInstinct</li>
      <li>ToxResist_Partial</li>
      <li>CVG_BloodGene_BeastVitality_III</li>
      <li>CVG_BloodGene_KeenSenses_III</li>
