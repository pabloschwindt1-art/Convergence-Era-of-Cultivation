  <HediffDef>
    <defName>CVG_AuspiciousPresence</defName>
    <label>auspicious presence</label>
    <description>A qilin is near. The world feels a little kinder.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>4</maxSeverity>
    <defaultLabelColor>(1, 0.85, 0.45)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li><minSeverity>0</minSeverity><label>I</label></li>
      <li><minSeverity>2</minSeverity><label>II</label></li>
      <li><minSeverity>3</minSeverity><label>III</label></li>
      <li><minSeverity>4</minSeverity><label>IV</label></li>
    </stages>
  </HediffDef>

  <ThoughtDef>
    <defName>CVG_Thought_AuspiciousPresence</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>CVG_AuspiciousPresence</hediff>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li><label>auspicious presence</label><description>A qilin walks among us.</description><baseMoodEffect>1</baseMoodEffect></li>
      <li><label>auspicious presence</label><description>A qilin walks among us.</description><baseMoodEffect>2</baseMoodEffect></li>
      <li><label>auspicious presence</label><description>A qilin walks among us.</description><baseMoodEffect>3</baseMoodEffect></li>
      <li><label>auspicious presence</label><description>A qilin walks among us.</description><baseMoodEffect>4</baseMoodEffect></li>
    </stages>
  </ThoughtDef>

  <HediffDef>
    <defName>CVG_EvilRepelled</defName>
    <label>repelled by the qilin</label>
    <description>The auspicious blood of a qilin weakens this creature of the void.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <initialSeverity>3</initialSeverity>
    <maxSeverity>4</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <statFactors>
          <MeleeDamageFactor>0.8</MeleeDamageFactor>
          <MoveSpeed>0.85</MoveSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <statFactors>
          <MeleeDamageFactor>0.65</MeleeDamageFactor>
          <MoveSpeed>0.75</MoveSpeed>
          <IncomingDamageFactor>1.15</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
