<Defs>
  <Convergence.BloodlineGeneGroupDef>
    <defName>CVG_GeneGroup_AuspiciousPresence</defName>
    <label>auspicious presence</label>
    <description>After the Convergence, allies nearby feel calmer and luckier (mood).</description>
    <bloodline>CVG_Bloodline_Qilin</bloodline>
    <order>11</order>
  </Convergence.BloodlineGeneGroupDef>

  <GeneDef ParentName="CVG_BloodTierGeneBase">
    <defName>CVG_BloodGene_AuspiciousPresence_I</defName>
    <label>auspicious presence I</label>
    <description>After the Convergence, allies nearby feel calmer and luckier (mood). Villages of Jiuxiao rang their bells when a qilin-blooded traveler passed, and the harvest that year was always good.</description>
    <geneClass>Convergence.Gene_Bloodline</geneClass>
    <iconPath>UI/Icons/Genes/CVG/Gene_AuspiciousPresence</iconPath>
    <iconColor>(0.7, 0.7, 0.7)</iconColor>
    <displayOrderInCategory>111</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <exclusionTags>
      <li>CVG_BloodGene_AuspiciousPresence</li>
    </exclusionTags>
    <modExtensions>
      <li Class="Convergence.DefModExtension_BloodlineGeneTier">
        <group>CVG_GeneGroup_AuspiciousPresence</group>
        <tier>1</tier>
      </li>
      <li Class="Convergence.DefModExtension_GeneAura">
        <radius>6</radius>
        <hediff>CVG_AuspiciousPresence</hediff>
        <affectAllies>true</affectAllies>
        <affectHostiles>false</affectHostiles>
        <onlyEntities>false</onlyEntities>
        <affectSelf>false</affectSelf>
      </li>
    </modExtensions>
  </GeneDef>

