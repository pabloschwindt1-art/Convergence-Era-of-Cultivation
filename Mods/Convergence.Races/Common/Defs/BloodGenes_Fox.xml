  <Convergence.BloodlineGeneGroupDef>
    <defName>CVG_GeneGroup_NineLives</defName>
    <label>nine tails, nine lives</label>
    <description>After the Convergence, each tail is a life: when the fox would die, it survives, healed, and spends one (1 / 3 / 6 / 9 lives).</description>
    <bloodline>CVG_Bloodline_Fox</bloodline>
    <order>19</order>
  </Convergence.BloodlineGeneGroupDef>

  <GeneDef ParentName="CVG_BloodTierGeneBase">
    <defName>CVG_BloodGene_NineLives_I</defName>
    <label>nine tails, nine lives I</label>
    <description>After the Convergence, each tail is a life: when the fox would die, it survives, healed, and spends one (1 / 3 / 6 / 9 lives). Old tales say a fox grows a new tail every thousand years, and pays for each one with a life it refuses to give up.</description>
    <geneClass>Convergence.Gene_Bloodline</geneClass>
    <iconPath>UI/Icons/Genes/CVG/Gene_NineLives</iconPath>
