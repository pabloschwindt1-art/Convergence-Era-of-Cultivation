  <AbilityDef ParentName="CVG_InnateAbilityBase">
    <defName>CVG_Ability_FoxFire</defName>
    <label>fox fire</label>
    <description>Flick a small blue-white fox-fire at a target. It burns and sets things alight. Costs qi if the user cultivates.</description>
    <iconPath>UI/Abilities/FireSpew</iconPath>
    <cooldownTicksRange>2500</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <ai_IsIncendiary>true</ai_IsIncendiary>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>15.9</range>
      <warmupTime>0.4</warmupTime>
      <soundCast>FireSpew_Resolve</soundCast>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityQiCost">
        <qiCost>15</qiCost>
      </li>
      <li Class="CompProperties_AbilityLaunchProjectile">
        <projectileDef>CVG_Projectile_FoxFire</projectileDef>
      </li>
    </comps>
  </AbilityDef>

  <ThingDef ParentName="BaseBullet">
    <defName>CVG_Projectile_FoxFire</defName>
    <label>fox fire</label>
    <graphicData>
      <texPath>Things/Projectile/Spark</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(160, 210, 255)</color>
      <drawSize>1.2</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Flame</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <speed>45</speed>
      <ai_IsIncendiary>true</ai_IsIncendiary>
    </projectile>
  </ThingDef>

