    <label>pure phoenix blood</label>
    <description>Feathers of the Southern Court. Death is a door you have already walked through once. The Heavenly Cauldron Pavilion would name its bearer a Guardian of the Flame, though the temper of the fire is still close to the surface.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Fire</iconPath>
    <iconColor>(0.8, 0.6, 1)</iconColor>
    <displayOrderInCategory>22</displayOrderInCategory>
    <biostatCpx>3</biostatCpx>
    <biostatMet>5</biostatMet>
    <aptitudes>
      <Crafting>3</Crafting>
      <Cooking>3</Cooking>
      <Plants>-1</Plants>
    </aptitudes>
    <modExtensions>
      <li Class="Convergence.DefModExtension_Bloodline">
        <bloodline>CVG_Bloodline_Phoenix</bloodline>
        <purity>CVG_Purity_Pure</purity>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Phoenix_Ancestral</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
      <li><def>Delicate</def></li>
      <li><def>Wimp</def></li>
