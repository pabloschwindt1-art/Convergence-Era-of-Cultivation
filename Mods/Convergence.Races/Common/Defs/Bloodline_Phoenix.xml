  <HediffDef ParentName="CVG_BloodlineHediffBase">
    <defName>CVG_Bloodline_Phoenix</defName>
    <label>phoenix blood</label>
    <description>Awakened phoenix blood: wounds close fast, fire barely touches the body. The cold and a short temper are the price.</description>
    <defaultLabelColor>(1, 0.55, 0.25)</defaultLabelColor>
    <!-- Done in XML: hot temper as aggroMentalBreakSelectionChanceFactor 2/1.6/1.3 on the identity genes. TODO (needs code; see docs/modulos/razas/FENIX.md): limb regrowth (Pure/Ancestral), incendiary mental breaks (a fire-starting break), cold-work mood, fire technique damage -->
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>trace</label>
        <statOffsets>
          <ArmorRating_Heat>0.05</ArmorRating_Heat>
          <ComfyTemperatureMin>5</ComfyTemperatureMin>
          <CVG_ForgeQuality>0.25</CVG_ForgeQuality>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>1.1</InjuryHealingFactor>
          <ImmunityGainSpeed>1.1</ImmunityGainSpeed>
          <GeneralLaborSpeed>1.15</GeneralLaborSpeed>
          <CookSpeed>1.15</CookSpeed>
          <CVG_ForgeSpeed>1.2</CVG_ForgeSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>diluted</label>
        <statOffsets>
          <ArmorRating_Heat>0.15</ArmorRating_Heat>
          <ComfyTemperatureMax>10</ComfyTemperatureMax>
          <ComfyTemperatureMin>15</ComfyTemperatureMin>
          <MentalBreakThreshold>0.06</MentalBreakThreshold>
          <CVG_ForgeQuality>0.5</CVG_ForgeQuality>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>1.5</InjuryHealingFactor>
          <ImmunityGainSpeed>1.3</ImmunityGainSpeed>
          <Flammability>0.7</Flammability>
          <LifespanFactor>1.2</LifespanFactor>
          <CVG_QiMax>1.05</CVG_QiMax>
          <CVG_QiRegen>1.05</CVG_QiRegen>
          <GeneralLaborSpeed>1.3</GeneralLaborSpeed>
          <CookSpeed>1.3</CookSpeed>
          <CVG_ForgeSpeed>1.4</CVG_ForgeSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>pure</label>
        <statOffsets>
          <ArmorRating_Heat>0.3</ArmorRating_Heat>
          <ComfyTemperatureMax>25</ComfyTemperatureMax>
          <ComfyTemperatureMin>10</ComfyTemperatureMin>
          <MentalBreakThreshold>0.03</MentalBreakThreshold>
          <CVG_ForgeQuality>1.0</CVG_ForgeQuality>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>2.0</InjuryHealingFactor>
          <ImmunityGainSpeed>1.6</ImmunityGainSpeed>
          <Flammability>0.35</Flammability>
          <LifespanFactor>1.5</LifespanFactor>
          <CVG_QiMax>1.1</CVG_QiMax>
          <CVG_QiRegen>1.2</CVG_QiRegen>
          <GeneralLaborSpeed>1.5</GeneralLaborSpeed>
          <CookSpeed>1.5</CookSpeed>
          <CVG_ForgeSpeed>1.7</CVG_ForgeSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>ancestral</label>
        <statOffsets>
          <ArmorRating_Heat>0.5</ArmorRating_Heat>
          <ComfyTemperatureMax>40</ComfyTemperatureMax>
          <ComfyTemperatureMin>5</ComfyTemperatureMin>
          <CVG_ForgeQuality>2.0</CVG_ForgeQuality>
        </statOffsets>
        <statFactors>
          <InjuryHealingFactor>3.0</InjuryHealingFactor>
          <ImmunityGainSpeed>2.0</ImmunityGainSpeed>
          <Flammability>0</Flammability>
          <LifespanFactor>2.0</LifespanFactor>
          <CVG_QiMax>1.2</CVG_QiMax>
          <CVG_QiRegen>1.35</CVG_QiRegen>
          <GeneralLaborSpeed>1.8</GeneralLaborSpeed>
          <CookSpeed>1.8</CookSpeed>
          <CVG_ForgeSpeed>2.2</CVG_ForgeSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <AbilityDef ParentName="CVG_InnateAbilityBase">
    <defName>CVG_Ability_PhoenixFlames</defName>
    <label>phoenix flames</label>
    <description>Hurl a golden flame that bursts on impact.\n\nFire burst of radius 2 (16 damage) that sets the target alight. Costs qi if the user cultivates.</description>
