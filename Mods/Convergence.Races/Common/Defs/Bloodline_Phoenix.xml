<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Phoenix bloodline. Design and values: docs/modulos/razas/FENIX.md -->

  <Convergence.BloodlineDef>
    <defName>CVG_Bloodline_Phoenix</defName>
    <label>phoenix</label>
    <description>The blood of the Southern Court: fire that heals, ash that refuses to stay ash. It hates the cold.\n\nBest as: crafter and cook. The forge, the workbench and the kitchen, wherever its fire is welcome.</description>
    <commonality>0.8</commonality>
    <color>(1, 0.55, 0.25)</color>
    <xenotypeIcon>Crown</xenotypeIcon>
    <affinities>
      <li>CVG_Element_Fire</li>
    </affinities>
    <purities>
      <li>
        <purity>CVG_Purity_Trace</purity>
        <gene>CVG_Blood_Phoenix_Trace</gene>
        <hediff>CVG_Bloodline_Phoenix</hediff>
        <affinityCultivationFactor>1.05</affinityCultivationFactor>
        <aspectGenes>
          <li>CVG_Phoenix_Plumage</li>
          <li>CVG_Phoenix_Eyes</li>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Diluted</purity>
        <gene>CVG_Blood_Phoenix_Diluted</gene>
        <hediff>CVG_Bloodline_Phoenix</hediff>
        <affinityCultivationFactor>1.1</affinityCultivationFactor>
        <abilities>
          <li>CVG_Ability_PhoenixFlames</li>
        </abilities>
        <aspectGenes>
          <li>CVG_Phoenix_Skin</li>
          <li>CVG_Phoenix_Crest</li>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Pure</purity>
        <gene>CVG_Blood_Phoenix_Pure</gene>
        <passion>Minor</passion>
        <xenotype>CVG_Xeno_Phoenix</xenotype>
        <hediff>CVG_Bloodline_Phoenix</hediff>
        <affinityCultivationFactor>1.2</affinityCultivationFactor>
        <!-- TODO (M5 techniques): Nirvana (passive: revive once, Harmony on Pawn.Kill) -->
        <aspectGenes>
        </aspectGenes>
      </li>
      <li>
        <purity>CVG_Purity_Ancestral</purity>
        <gene>CVG_Blood_Phoenix_Ancestral</gene>
        <passion>Major</passion>
        <xenotype>CVG_Xeno_Phoenix</xenotype>
        <hediff>CVG_Bloodline_Phoenix</hediff>
        <affinityCultivationFactor>1.35</affinityCultivationFactor>
        <!-- TODO (M5 techniques): Eternal Nirvana (revive every 180 days) -->
        <aspectGenes>
          <li>CVG_Phoenix_SkinAncestral</li>
        </aspectGenes>
      </li>
    </purities>
  </Convergence.BloodlineDef>

  <!-- Metabolism of the purity genes: total Trace -1, Diluted -2 (a flaw; beast vitality I/II costs -1 of it); Pure and Ancestral compensate the vanilla genes of the
       bloodline xenotype (added on reaching Pure, -5 metabolism) so the total is 0 (Pure) and +1 (Ancestral). -->
  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Phoenix_Trace</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
      <li><def>Delicate</def></li>
      <li><def>Wimp</def></li>
    </suppressedTraits>
    <aggroMentalBreakSelectionChanceFactor>2</aggroMentalBreakSelectionChanceFactor>
    <label>trace of phoenix blood</label>
    <description>A warm ash in the veins. In winter you are always the last to shiver. An ancestor breathed the qi-rich ash of the Fires of Heaven, the phoenix flames that fell on the Rim like shooting stars; the ember never went out, and it flares into rage easily.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Fire</iconPath>
    <iconColor>(0.7, 0.7, 0.7)</iconColor>
    <displayOrderInCategory>20</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
    <aptitudes>
      <Crafting>1</Crafting>
      <Cooking>1</Cooking>
      <Plants>-2</Plants>
    </aptitudes>
    <modExtensions>
      <li Class="Convergence.DefModExtension_Bloodline">
        <bloodline>CVG_Bloodline_Phoenix</bloodline>
        <purity>CVG_Purity_Trace</purity>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodIdentityBase">
    <defName>CVG_Blood_Phoenix_Diluted</defName>
    <suppressedTraits>
      <li><def>Immunity</def><degree>-1</degree></li>
      <li><def>Delicate</def></li>
      <li><def>Wimp</def></li>
    </suppressedTraits>
    <aggroMentalBreakSelectionChanceFactor>1.6</aggroMentalBreakSelectionChanceFactor>
    <label>diluted phoenix blood</label>
    <description>The old fire wakes in your wounds and closes them. You hate the cold. This is the blood of the Nirvana Company, wandering phoenix healers who stayed on the Rim: people call their children 'those who never fall ill', and step back when they boil over.</description>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Fire</iconPath>
    <iconColor>(0.55, 0.8, 1)</iconColor>
    <displayOrderInCategory>21</displayOrderInCategory>
    <biostatCpx>2</biostatCpx>
    <biostatMet>-1</biostatMet>
    <aptitudes>
      <Crafting>2</Crafting>
      <Cooking>2</Cooking>
      <Plants>-2</Plants>
    </aptitudes>
    <modExtensions>
      <li Class="Convergence.DefModExtension_Bloodline">
        <bloodline>CVG_Bloodline_Phoenix</bloodline>
        <purity>CVG_Purity_Diluted</purity>
      </li>
    </modExtensions>
  </GeneDef>

