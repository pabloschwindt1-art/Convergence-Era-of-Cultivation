  <GeneDef ParentName="CVG_BloodAspectBase">
    <defName>CVG_Phoenix_Skin</defName>
    <label>ember skin</label>
    <description>Warm skin with a faint ember glow, as if the ash of the Fires of Heaven still smoldered underneath. Phoenix mothers wrap their children in furs anyway, out of their own hatred of winter.</description>
    <iconPath>UI/Icons/Genes/Gene_SkinColorOverride</iconPath>
    <iconColor>(235, 165, 130)</iconColor>
