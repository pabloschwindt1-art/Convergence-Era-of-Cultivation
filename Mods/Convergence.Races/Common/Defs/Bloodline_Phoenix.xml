      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodAspectBase">
    <defName>CVG_Phoenix_Plumage</defName>
    <label>phoenix plumage</label>
    <description>Flame-red hair that falls like feathers. The Classic of Mountains and Seas paints the phoenix of Mount Danxue in these colors, and the Southern Court never dyed it.</description>
    <iconPath>UI/Icons/Genes/Gene_HairColor</iconPath>
    <iconColor>(230, 80, 35)</iconColor>
    <displayOrderInCategory>25</displayOrderInCategory>
    <hairColorOverride>(230, 80, 35)</hairColorOverride>
  </GeneDef>

  <GeneDef ParentName="CVG_BloodAspectBase">
    <defName>CVG_Phoenix_Eyes</defName>
    <label>golden eyes</label>
    <description>Bright golden eyes with an ember at the center. It is said that a phoenix cannot lie under oath, because the fire in its eyes would give it away.</description>
