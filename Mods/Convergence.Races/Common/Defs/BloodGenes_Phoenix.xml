  <Convergence.BloodlineGeneGroupDef>
    <defName>CVG_GeneGroup_FieryPlumes</defName>
    <label>fiery plumes</label>
    <description>Feathers born of fire: flames hurt less, and at ancestral purity not at all.</description>
    <bloodline>CVG_Bloodline_Phoenix</bloodline>
    <order>8</order>
  </Convergence.BloodlineGeneGroupDef>

