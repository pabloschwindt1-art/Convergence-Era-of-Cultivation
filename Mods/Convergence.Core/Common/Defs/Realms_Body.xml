<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Path of the body (M4b): Skin -> Flesh -> Bone -> Marrow -> Blood -> Golden Body. Rootless adults follow it after the
    Convergence, but it only STARTS when they eat spirit-beast meat or blood, and it only advances by spending blood qi
    (which only comes from spirit-beast products) on training equipment. Breaking through to realms 2-6 REQUIRES beast
    blood (2-3) or a beast core (4-6), taken during the retreat. Power multiplies like the qi realms but leans on
    health and armor. Values are interpolated per stage (stage 1 ~ stage 4); foundation quality scales them.
  -->
  <Convergence.CultivationRealmDef>
    <defName>CVG_Realm_SkinTempering</defName>
    <label>Skin Tempering</label>
    <description>The body path begins: spirit-beast blood and endless beatings harden the skin until blades leave only scratches.</description>
    <path>CVG_Path_Body</path>
    <order>1</order>
    <hediff>CVG_Hediff_SkinTempering</hediff>
    <healthScaleFactor>1.3~1.45</healthScaleFactor>
    <!-- Aging speed of adults at the first and last stage (longevity). -->
    <biologicalAgingFactor>0.9~0.85</biologicalAgingFactor>
    <stages>4</stages>
    <progressPerStage>800</progressPerStage>
    <progressPerHour>40</progressPerHour>
    <breakthroughChanceFactor>1</breakthroughChanceFactor>
    <breakthroughHours>3</breakthroughHours>
    <breakthroughCooldownDays>2</breakthroughCooldownDays>
    <breakthroughFailureHediff>CVG_BloodBackflow</breakthroughFailureHediff>
    <tribulation>false</tribulation>
  </Convergence.CultivationRealmDef>
  <Convergence.CultivationRealmDef>
    <defName>CVG_Realm_FleshTempering</defName>
    <label>Flesh Tempering</label>
    <description>Muscles are torn and rebuilt with beast blood until they are dense as rope. Strength doubles; wounds that would cripple a mortal barely slow the cultivator.</description>
    <path>CVG_Path_Body</path>
    <order>2</order>
    <hediff>CVG_Hediff_FleshTempering</hediff>
    <healthScaleFactor>1.8~2.1</healthScaleFactor>
    <!-- Aging speed of adults at the first and last stage (longevity). -->
    <biologicalAgingFactor>0.8~0.7</biologicalAgingFactor>
    <stages>4</stages>
    <progressPerStage>1800</progressPerStage>
    <progressPerHour>40</progressPerHour>
    <breakthroughItem>CVG_BeastBlood</breakthroughItem>
    <breakthroughItemRequired>true</breakthroughItemRequired>
    <breakthroughChanceFactor>1</breakthroughChanceFactor>
    <breakthroughHours>3</breakthroughHours>
    <breakthroughCooldownDays>2</breakthroughCooldownDays>
    <breakthroughFailureHediff>CVG_BloodBackflow</breakthroughFailureHediff>
    <breakthroughRequirements>
      <li Class="Convergence.BreakthroughRequirement_Research">
        <project>CVG_Research_BodyTempering</project>
      </li>
    </breakthroughRequirements>
    <tribulation>false</tribulation>
  </Convergence.CultivationRealmDef>
  <Convergence.CultivationRealmDef>
