<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Spirit beasts (M4b, base of the Fauna module, docs/modulos/FAUNA_FLORA.md §1): after the Convergence any animal (of any
    mod) may awaken. It is a state, not a new animal: hediff CVG_SpiritBeast, level = severity 1-4.
    Awakening: at the Convergence (animals on the map) and when animals are generated afterwards; chance and level by
    combatPower (curves below) x the mod setting. Butchering adds spirit meat, beast blood and (level 3+) beast cores.
  -->
  <HediffDef>
    <defName>CVG_SpiritBeast</defName>
    <hediffClass>Convergence.Hediff_SpiritBeast</hediffClass>
    <label>spirit beast</label>
    <description>Qi has awakened this animal. It is stronger, faster and tougher than its kin, and its flesh and blood carry spiritual power that body cultivators need.</description>
    <defaultLabelColor>(0.75, 0.85, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <minSeverity>1</minSeverity>
    <maxSeverity>4</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>level 1</label>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
          <MeleeDamageFactor>1.3</MeleeDamageFactor>
          <IncomingDamageFactor>0.9</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>level 2</label>
        <statFactors>
          <MoveSpeed>1.2</MoveSpeed>
          <MeleeDamageFactor>1.7</MeleeDamageFactor>
          <IncomingDamageFactor>0.75</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>level 3</label>
        <statFactors>
          <MoveSpeed>1.3</MoveSpeed>
          <MeleeDamageFactor>2.2</MeleeDamageFactor>
          <IncomingDamageFactor>0.6</IncomingDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>level 4</label>
        <statFactors>
          <MoveSpeed>1.45</MoveSpeed>
          <MeleeDamageFactor>3</MeleeDamageFactor>
          <IncomingDamageFactor>0.45</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpiritBeast">
        <leatherDef>CVG_SpiritLeather</leatherDef>
        <!-- combatPower -> chance to awaken (wild; tamed x0.5). Squirrel ~30, boar ~70, bear ~200, thrumbo ~500. -->
        <awakenChanceCurve>
          <points>
            <li>(0, 0.01)</li>
            <li>(30, 0.03)</li>
            <li>(70, 0.08)</li>
            <li>(120, 0.15)</li>
            <li>(200, 0.3)</li>
            <li>(350, 0.6)</li>
            <li>(500, 0.85)</li>
            <li>(1000, 0.95)</li>
          </points>
        </awakenChanceCurve>
        <tameChanceFactor>0.5</tameChanceFactor>
        <!-- combatPower -> mean level (a little randomness is added). -->
        <levelCurve>
          <points>
            <li>(0, 1)</li>
            <li>(90, 1)</li>
            <li>(160, 1.6)</li>
            <li>(260, 2.3)</li>
            <li>(400, 3)</li>
            <li>(700, 3.6)</li>
          </points>
        </levelCurve>
        <healthScaleByLevel>
          <li>1.3</li>
          <li>1.8</li>
          <li>2.5</li>
          <li>3.5</li>
        </healthScaleByLevel>
        <meatPerBodySize>8</meatPerBodySize>
        <bloodPerBodySize>2</bloodPerBodySize>
        <coreMinLevel>3</coreMinLevel>
      </li>
    </modExtensions>
  </HediffDef>

  <!-- ================= Products ================= -->
  <!-- Own category so ordinary meals do not eat the spirit meat. -->
  <ThingCategoryDef>
    <defName>CVG_SpiritBeastProducts</defName>
    <label>spirit beast products</label>
    <parent>ResourcesRaw</parent>
  </ThingCategoryDef>

  <ThingDef ParentName="OrganicProductBase">
    <defName>CVG_SpiritMeat</defName>
    <label>spirit meat</label>
    <description>Raw meat of an awakened spirit beast, faintly warm and heavy with qi. Eating it starts the path of the body for those without a spirit root and gives blood qi (much more if cooked into spirit soup).</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_SpiritMeat</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MarketValue>8</MarketValue>
      <Mass>0.03</Mass>
      <Nutrition>0.05</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>3</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>RawBad</preferability>
      <foodType>Meat</foodType>
      <tasteThought>AteRawFood</tasteThought>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainCultivationResource">
          <path>CVG_Path_Body</path>
          <amount>2</amount>
        </li>
      </outcomeDoers>
    </ingestible>
    <thingCategories>
      <li>CVG_SpiritBeastProducts</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="OrganicProductBase">
    <defName>CVG_BeastBlood</defName>
    <label>spirit beast blood</label>
    <description>Thick, dark blood of a spirit beast, still pulsing with qi. A body cultivator drinks it for blood qi; breaking through to Flesh Tempering and Bone Forging requires a dose during the retreat.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_BeastBlood</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>20</MarketValue>
      <Mass>0.1</Mass>
      <Nutrition>0.02</Nutrition>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>6</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>Fluid</foodType>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Ingest_Beer</ingestSound>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainCultivationResource">
          <path>CVG_Path_Body</path>
          <amount>25</amount>
        </li>
      </outcomeDoers>
    </ingestible>
    <thingCategories>
      <li>CVG_SpiritBeastProducts</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_BeastCore</defName>
    <label>beast core</label>
    <description>The crystallized qi of a high-level spirit beast (兽核). Absorbing it floods every path the cultivator follows (and starts the body path for those without a root); breaking through to Marrow Cleansing and beyond requires one.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/CVG_BeastCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>250</MarketValue>
      <Mass>0.3</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>Processed</foodType>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <ingestCommandString>Absorb {0}</ingestCommandString>
      <ingestReportString>Absorbing {0}.</ingestReportString>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainCultivationResource">
          <amount>80</amount>
          <daoComprehension>1</daoComprehension>
        </li>
      </outcomeDoers>
    </ingestible>
    <thingCategories>
      <li>CVG_SpiritBeastProducts</li>
    </thingCategories>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>

  <!-- ================= Spirit soup ================= -->
  <ThingDef ParentName="MealCooked">
    <defName>CVG_SpiritSoup</defName>
    <label>spirit soup</label>
    <description>A broth of spirit meat simmered for hours. Gives blood qi (and starts the body path for those without a root), and helps any cultivator a little for a day.</description>
    <graphicData>
      <texPath>Things/Item/Meal/CVG_SpiritSoup</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>30</MarketValue>
      <WorkToMake>600</WorkToMake>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <tasteThought>AteFineMeal</tasteThought>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetFeedingAnimals>-75</optimalityOffsetFeedingAnimals>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainCultivationResource">
          <path>CVG_Path_Body</path>
          <amount>30</amount>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>CVG_SpiritNourished</hediffDef>
          <severity>1</severity>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <RecipeDef ParentName="CookMealBase">
    <defName>CVG_CookSpiritSoup</defName>
    <label>cook spirit soup</label>
    <description>Simmer spirit meat into a soup that body cultivators thrive on.</description>
    <jobString>Cooking spirit soup.</jobString>
    <workAmount>600</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>CVG_SpiritMeat</li>
          </thingDefs>
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>CVG_SpiritMeat</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <CVG_SpiritSoup>1</CVG_SpiritSoup>
    </products>
    <workSkill>Cooking</workSkill>
    <displayPriority>90</displayPriority>
    <recipeUsers>
      <li>Campfire</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
  </RecipeDef>

  <HediffDef>
    <defName>CVG_SpiritNourished</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>spirit nourished</label>
    <description>A spirit soup warms the meridians: cultivation and body tempering go a little faster for a day. Sect kitchens simmer spirit meat and herbs for a whole night to make it. Disciples swear by it before a long retreat.</description>
    <defaultLabelColor>(0.55, 0.8, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <CVG_CultivationSpeed>1.1</CVG_CultivationSpeed>
          <CVG_BodyTemperingSpeed>1.15</CVG_BodyTemperingSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
