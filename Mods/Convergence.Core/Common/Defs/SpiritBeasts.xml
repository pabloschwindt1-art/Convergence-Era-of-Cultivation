<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Spirit beasts (M4b, base of the Fauna module, docs/modulos/FAUNA_FLORA.md §1): after the Convergence any animal (of any
    mod) may awaken. It is a state, not a new animal: hediff CVG_SpiritBeast, rank = severity 1-6, aligned with the six realms
    (a rank 4 beast fights and endures like a cultivator of the fourth realm; realm suppression applies both ways).
    Integration plan (2026-10-23): about half of the world awakens, or the Convergence is an anecdote and body cultivators
    never advance. The rank belongs to the SPECIES (vanilla combatPower: a chicken is rank 1, a bear rank 4, a thrumbo rank 5), with a small
    chance of an elite one rank higher, so any modded creature is ranked the moment it has a combatPower.
    Death drops spirit stones by rank; butchering adds spirit meat, beast blood, spirit leather and (rank 3+) beast cores.
    Species of combatPower 600+ awaken as beast sovereigns (CVG_BeastSovereign): bosses with an aura of pressure.
  -->
  <HediffDef>
    <defName>CVG_SpiritBeast</defName>
    <hediffClass>Convergence.Hediff_SpiritBeast</hediffClass>
    <label>spirit beast</label>
    <description>Qi has awakened this animal. It is stronger, faster and tougher than its kin, and its flesh and blood carry spiritual power that body cultivators need.</description>
    <defaultLabelColor>(0.75, 0.85, 0.45)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <minSeverity>1</minSeverity>
    <maxSeverity>6</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>rank 1</label>
        <statFactors>
          <MoveSpeed>1.05</MoveSpeed>
          <MeleeDamageFactor>1.1</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>rank 2</label>
        <statFactors>
          <MoveSpeed>1.1</MoveSpeed>
          <MeleeDamageFactor>1.25</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>rank 3</label>
        <statFactors>
          <MoveSpeed>1.15</MoveSpeed>
          <MeleeDamageFactor>1.45</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>rank 4</label>
        <statFactors>
          <MoveSpeed>1.2</MoveSpeed>
          <MeleeDamageFactor>1.7</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>5</minSeverity>
        <label>rank 5</label>
        <statFactors>
          <MoveSpeed>1.25</MoveSpeed>
          <MeleeDamageFactor>2.0</MeleeDamageFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>6</minSeverity>
        <label>rank 6</label>
        <statFactors>
          <MoveSpeed>1.3</MoveSpeed>
          <MeleeDamageFactor>2.5</MeleeDamageFactor>
        </statFactors>
      </li>
    </stages>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpiritBeast">
        <leatherDef>CVG_SpiritLeather</leatherDef>
        <!-- combatPower -> chance to awaken (wild; tamed x0.5): about half of the world. Squirrel ~30, boar ~70, bear ~200,
             thrumbo ~500. Mod setting multiplies it. -->
        <awakenChanceCurve>
          <points>
            <li>(0, 0.35)</li>
            <li>(35, 0.42)</li>
            <li>(80, 0.5)</li>
            <li>(150, 0.58)</li>
            <li>(300, 0.75)</li>
            <li>(600, 1)</li>
          </points>
        </awakenChanceCurve>
        <tameChanceFactor>0.5</tameChanceFactor>
        <!-- combatPower -> rank of the species (steps; an elite is one rank higher). Calibrated on vanilla and Alpha Animals:
             chicken 1, boar 2, muffalo 3, bear 4, elephant/thrumbo 5-6, the great beasts of 600+ are 6. -->
        <levelCurve>
          <points>
            <li>(0, 1)</li>
            <li>(34, 1)</li>
            <li>(35, 2)</li>
            <li>(79, 2)</li>
            <li>(80, 3)</li>
            <li>(149, 3)</li>
            <li>(150, 4)</li>
            <li>(299, 4)</li>
            <li>(300, 5)</li>
            <li>(599, 5)</li>
            <li>(600, 6)</li>
          </points>
        </levelCurve>
        <eliteChance>0.15</eliteChance>
        <sovereignMinCombatPower>600</sovereignMinCombatPower>
        <sovereignHediff>CVG_BeastSovereign</sovereignHediff>
        <!-- Spirit stones that condense from the qi of a dead beast, by rank (index 0 = rank 1). -->
        <deathStonesByLevel>
          <li>1</li>
          <li>2</li>
          <li>4</li>
          <li>7</li>
          <li>11</li>
          <li>16</li>
        </deathStonesByLevel>
        <healthScaleByLevel>
          <li>1.1</li>
          <li>1.25</li>
          <li>1.45</li>
          <li>1.7</li>
          <li>2.0</li>
          <li>2.5</li>
        </healthScaleByLevel>
        <!-- Rebalance (playtest 2026-10-24): spirit beasts now also have realm suppression (rank 2-3 = realm 1, 4-5 = realm 2,
             6 = realm 3), so health and damage multipliers are milder, and the world awakens gradually after the Convergence. -->
        <realmByLevel><li>0</li><li>1</li><li>1</li><li>2</li><li>2</li><li>3</li></realmByLevel>
        <awakenRampStart>0.3</awakenRampStart>
        <awakenRampDays>60</awakenRampDays>
        <rankCapStart>2</rankCapStart>
        <rankCapDaysPerRank>15</rankCapDaysPerRank>
        <meatPerBodySize>8</meatPerBodySize>
        <bloodPerBodySize>2</bloodPerBodySize>
        <coreMinLevel>3</coreMinLevel>
      </li>
    </modExtensions>
  </HediffDef>

  <!-- Beast sovereign: the boss form of the great beasts (combatPower 600+). Pain does not stop it, wounds close fast, and its
       aura presses on every enemy of lower realm nearby (CVG_BeastPressure). A letter announces it when it reaches the colony. -->
  <HediffDef>
    <defName>CVG_BeastSovereign</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>beast sovereign</label>
    <description>The great beasts did not just wake with the Convergence: they remembered what they were in Jiuxiao, when sects paid tribute to them and named mountains after them. A sovereign does not feel pain, its wounds close as you watch, and the air around it is so heavy with its qi that weaker hearts falter. The old bestiaries say: do not hunt a sovereign, negotiate with it.</description>
    <defaultLabelColor>(1, 0.65, 0.25)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <painFactor>0</painFactor>
        <statFactors>
          <InjuryHealingFactor>4</InjuryHealingFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="Convergence.HediffCompProperties_BeastPressure">
        <radius>9.9</radius>
        <hediff>CVG_BeastPressure</hediff>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>CVG_BeastPressure</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>beast pressure</label>
    <description>The aura of a beast sovereign weighs on this person: the legs go heavy and the mind slow, the way a mouse freezes under the gaze of a hawk. Only a cultivator of a realm as high as the beast's stands straight under it.</description>
    <defaultLabelColor>(0.9, 0.5, 0.3)</defaultLabelColor>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>600</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- ================= Products ================= -->
  <!-- Own category so ordinary meals do not eat the spirit meat (it is not under MeatRaw), but under raw food so it is stored,
       hauled and spoils like food (integration plan, 2026-10-23). Cores, feathers, fangs and shells are beast parts. -->
  <ThingCategoryDef>
    <defName>CVG_SpiritBeastProducts</defName>
    <label>spirit beast meat and blood</label>
    <parent>FoodRaw</parent>
  </ThingCategoryDef>

  <ThingCategoryDef>
    <defName>CVG_SpiritBeastParts</defName>
    <label>spirit beast parts</label>
    <parent>ResourcesRaw</parent>
  </ThingCategoryDef>

  <ThingDef ParentName="OrganicProductBase">
    <defName>CVG_SpiritMeat</defName>
    <label>spirit meat</label>
    <description>Raw meat of an awakened spirit beast, faintly warm and heavy with qi. Eating it starts the path of the body for those without a spirit root and gives blood qi (much more if cooked into spirit soup).</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_SpiritMeat</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MarketValue>8</MarketValue>
      <Mass>0.03</Mass>
      <Nutrition>0.05</Nutrition>
      <FoodPoisonChanceFixedHuman>0.02</FoodPoisonChanceFixedHuman>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>3</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>RawBad</preferability>
      <foodType>Meat</foodType>
      <tasteThought>AteRawFood</tasteThought>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>RawMeat_Eat</ingestSound>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainCultivationResource">
          <path>CVG_Path_Body</path>
          <amount>2</amount>
        </li>
      </outcomeDoers>
    </ingestible>
    <thingCategories>
      <li>CVG_SpiritBeastProducts</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="OrganicProductBase">
    <defName>CVG_BeastBlood</defName>
    <label>spirit beast blood</label>
    <description>Thick, dark blood of a spirit beast, still pulsing with qi. A body cultivator drinks it for blood qi; breaking through to Flesh Tempering and Bone Forging requires a dose during the retreat.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_BeastBlood</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>20</MarketValue>
      <Mass>0.1</Mass>
      <Nutrition>0.02</Nutrition>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>6</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
    </comps>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>Fluid</foodType>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Ingest_Beer</ingestSound>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainCultivationResource">
          <path>CVG_Path_Body</path>
          <amount>25</amount>
        </li>
      </outcomeDoers>
    </ingestible>
    <thingCategories>
      <li>CVG_SpiritBeastProducts</li>
    </thingCategories>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_BeastCore</defName>
    <label>beast core</label>
    <description>The crystallized qi of a high-level spirit beast (兽核). Absorbing it floods every path the cultivator follows (and starts the body path for those without a root); breaking through to Marrow Cleansing and beyond requires one.</description>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/CVG_BeastCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <statBases>
      <MarketValue>250</MarketValue>
      <Mass>0.3</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>Processed</foodType>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <ingestCommandString>Absorb {0}</ingestCommandString>
      <ingestReportString>Absorbing {0}.</ingestReportString>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainCultivationResource">
          <amount>80</amount>
          <daoComprehension>1</daoComprehension>
        </li>
      </outcomeDoers>
    </ingestible>
    <thingCategories>
      <li>CVG_SpiritBeastParts</li>
    </thingCategories>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>

  <!-- ================= Spirit soup ================= -->
  <ThingDef ParentName="MealCooked">
    <defName>CVG_SpiritSoup</defName>
    <label>spirit soup</label>
    <description>A broth of spirit meat simmered for hours. Gives blood qi (and starts the body path for those without a root), and helps any cultivator a little for a day.</description>
    <graphicData>
      <texPath>Things/Item/Meal/CVG_SpiritSoup</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>30</MarketValue>
      <WorkToMake>600</WorkToMake>
      <Nutrition>0.9</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <tasteThought>AteFineMeal</tasteThought>
      <ingestEffect>EatMeat</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetFeedingAnimals>-75</optimalityOffsetFeedingAnimals>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainCultivationResource">
          <path>CVG_Path_Body</path>
          <amount>30</amount>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>CVG_SpiritNourished</hediffDef>
          <severity>1</severity>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <RecipeDef ParentName="CookMealBase">
    <defName>CVG_CookSpiritSoup</defName>
    <label>cook spirit soup</label>
    <description>Simmer spirit meat into a soup that body cultivators thrive on.</description>
    <jobString>Cooking spirit soup.</jobString>
    <workAmount>600</workAmount>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <requiredGiverWorkType>Cooking</requiredGiverWorkType>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <allowMixingIngredients>true</allowMixingIngredients>
    <ingredientValueGetterClass>IngredientValueGetter_Nutrition</ingredientValueGetterClass>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>CVG_SpiritMeat</li>
          </thingDefs>
        </filter>
        <count>0.5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>CVG_SpiritMeat</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <CVG_SpiritSoup>1</CVG_SpiritSoup>
    </products>
    <workSkill>Cooking</workSkill>
    <displayPriority>90</displayPriority>
    <recipeUsers>
      <li>Campfire</li>
      <li>FueledStove</li>
      <li>ElectricStove</li>
    </recipeUsers>
  </RecipeDef>

  <HediffDef>
    <defName>CVG_SpiritNourished</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>spirit nourished</label>
    <description>A spirit soup warms the meridians: cultivation and body tempering go a little faster for a day. Sect kitchens simmer spirit meat and herbs for a whole night to make it. Disciples swear by it before a long retreat.</description>
    <defaultLabelColor>(0.55, 0.8, 1)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <maxSeverity>1</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000~60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <CVG_CultivationSpeed>1.1</CVG_CultivationSpeed>
          <CVG_BodyTemperingSpeed>1.15</CVG_BodyTemperingSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
