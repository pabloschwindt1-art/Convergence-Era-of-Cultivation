<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Passive techniques (docs/DISENO.md §8, round 3): unlocking one gives a permanent hediff (no button) whose severity
    is the power of the technique (realm x mastery x affinity), so its stages grow by themselves; it gains mastery a
    little every day. Only active techniques are equipped in the 3-4 slots of the Techniques tab.
  -->
  <AbilityDef Name="CVG_TechniquePassiveBase" ParentName="CVG_TechniqueSelfBase" Abstract="True">
    <aiCanUse>false</aiCanUse>
  </AbilityDef>

  <HediffDef Name="CVG_TechniquePassiveHediffBase" Abstract="True">
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>10</maxSeverity>
    <keepOnBodyPartRestoration>True</keepOnBodyPartRestoration>
    <comps>
      <li Class="Convergence.HediffCompProperties_PassiveTechnique" />
    </comps>
  </HediffDef>
  <AbilityDef ParentName="CVG_TechniquePassiveBase">
    <defName>CVG_Tech_GoldenBellSkin</defName>
    <label>golden bell skin</label>
    <description>The first lesson of the Golden Edge Scripture: let metal qi settle under the skin like the bronze of a temple bell. Shaolin monks of the old world called it Jin Zhong Zhao and trained it by being struck with staves for years; the scripture does it with qi in months.\n\nPassive: sharp armor +6% (more with realm and mastery).</description>
    <!-- Provisional icon of the path; own art: UI/Techniques/<defName>.png is picked up automatically. -->
    <iconPath>UI/Icons/Genes/CVG_RootElement_Metal</iconPath>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_GoldenEdge</manual>
        <tier>1</tier>
        <order>1</order>
        <minRealm>CVG_Realm_QiRefining</minRealm>
        <passiveHediff>CVG_Passive_GoldenBellSkin</passiveHediff>
      </li>
    </modExtensions>
  </AbilityDef>
