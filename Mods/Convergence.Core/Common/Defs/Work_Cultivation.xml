<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Breakthrough retreat: ordered from the "Attempt breakthrough" button. -->
  <JobDef>
    <defName>CVG_Breakthrough</defName>
    <driverClass>Convergence.JobDriver_Breakthrough</driverClass>
    <reportString>attempting a breakthrough.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <suspendable>false</suspendable>
  </JobDef>

  <!-- Witness of a tribulation: the colony gathers at a safe distance, like at a birth. -->
  <JobDef>
    <defName>CVG_WatchTribulation</defName>
    <driverClass>Convergence.JobDriver_WatchTribulation</driverClass>
    <reportString>watching TargetA's tribulation.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>
</Defs>
