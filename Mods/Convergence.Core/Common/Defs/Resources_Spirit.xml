<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Fundamental spirit resources of the Core (docs/modulos/RECURSOS.md). Their veins only exist after the Convergence. -->

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_SpiritStone</defName>
    <label>spirit stone</label>
    <description>A stone soaked in condensed qi since the Convergence. Cultivators trade with it, burn it to feed formations and forges, and absorb it to cultivate.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_SpiritStone</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>12</MarketValue>
      <Mass>0.4</Mass>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <deepCommonality>0</deepCommonality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>0.05</qi>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_SpiritJade</defName>
    <label>spirit jade</label>
    <description>Jade that drank qi during the Convergence. It glows faintly and holds what is carved into it: technique tablets, talismans and artifacts are made of it. It is also a beautiful building stone.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_SpiritJade</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>9</MarketValue>
      <Mass>0.5</Mass>
      <StuffPower_Armor_Sharp>0.95</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.5</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.6</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <BluntDamageMultiplier>1.6</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <deepCommonality>0</deepCommonality>
    <stuffProps>
      <categories>
        <li>Stony</li>
      </categories>
      <commonality>0.02</commonality>
      <color>(95,175,140)</color>
      <constructEffect>ConstructMetal</constructEffect>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <statOffsets>
        <Beauty>12</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>0.7</MaxHitPoints>
        <WorkToMake>1.4</WorkToMake>
        <WorkToBuild>4.0</WorkToBuild>
        <Beauty>3</Beauty>
        <Flammability>0</Flammability>
        <MeleeWeapon_CooldownMultiplier>1.2</MeleeWeapon_CooldownMultiplier>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <!-- Feng shui by material: walls, columns and furniture of spirit jade add qi to the room. -->
    <modExtensions>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>0.05</qi>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RockBase">
    <defName>CVG_MineableSpiritStone</defName>
    <label>spirit stone vein</label>
    <description>Rock veined with spirit stones that condensed when qi returned to the world. Before the Convergence these seams were plain rock; miners swear they can hear the stone breathing now.</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(92,100,120)</color>
      <colorTwo>(120,205,255)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>3500</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>CVG_SpiritStone</mineableThing>
      <mineableYield>25</mineableYield>
      <mineableScatterCommonality>0.05</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>2~8</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
    <modExtensions>
      <li Class="Convergence.DefModExtension_ConvergenceMineable">
        <eventLumps>3~5</eventLumps>
        <eventLumpSize>3~7</eventLumpSize>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RockBase">
    <defName>CVG_MineableSpiritJade</defName>
    <label>spirit jade</label>
    <description>Jade that drank qi during the Convergence. It glows faintly in the dark.</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(68,90,80)</color>
      <colorTwo>(110,255,190)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>2500</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>CVG_SpiritJade</mineableThing>
      <mineableYield>30</mineableYield>
      <mineableScatterCommonality>0.03</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>2~6</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
    <modExtensions>
      <li Class="Convergence.DefModExtension_ConvergenceMineable">
        <convertFrom>MineableJade</convertFrom>
        <convertFraction>0.5</convertFraction>
      </li>
    </modExtensions>
  </ThingDef>

  <!--
    Primordial crystal: spirit stones pressed into a stable lattice. A shared Core material for any module that needs qi in a solid,
    measurable form (first user: the spirit resonator of Qi-Tech). Made from spirit stones, so it only exists after the Convergence.
    Art is provisional (vanilla jade); final art: Things/Item/Resource/CVG_PrimordialCrystal (Graphic_StackCount).
  -->
  <ThingDef ParentName="ResourceBase">
    <defName>CVG_PrimordialCrystal</defName>
    <label>primordial crystal</label>
    <description>Ten spirit stones ground, pressed and cut until their qi settles into a single clear lattice that no longer leaks. Sect artisans call it "primordial" because, unlike a raw stone, it holds the same amount of qi from one day to the next, as the world supposedly did before the Calamity. Engineers of the Edge value it for a plainer reason: it is the first thing touched by qi that gives the same reading twice.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Jade</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>150</MarketValue>
      <Mass>0.5</Mass>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <deepCommonality>0</deepCommonality>
    <modExtensions>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>0.3</qi>
      </li>
    </modExtensions>
  </ThingDef>

  <RecipeDef>
    <defName>CVG_MakePrimordialCrystal</defName>
    <label>make primordial crystal</label>
    <description>Grind and press ten spirit stones into one primordial crystal.</description>
    <jobString>Making primordial crystal.</jobString>
    <workAmount>2000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <requiredGiverWorkType>Crafting</requiredGiverWorkType>
    <workSkill>Crafting</workSkill>
    <effectWorking>CutStone</effectWorking>
    <soundWorking>Recipe_MakeStoneBlocks</soundWorking>
    <ingredients>
      <li>
        <filter><thingDefs><li>CVG_SpiritStone</li></thingDefs></filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>CVG_SpiritStone</li></thingDefs></fixedIngredientFilter>
    <products>
      <CVG_PrimordialCrystal>1</CVG_PrimordialCrystal>
    </products>
    <recipeUsers>
      <li>TableStonecutter</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
