<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Cojín de cultivo: madera, sin electricidad. Gráfico: generado con ComfyUI (art/generated/comfy/CultivationCushion, candidato 1). -->
  <ThingDef ParentName="FurnitureBase">
    <defName>CVG_CultivationCushion</defName>
    <label>cultivation cushion</label>
    <description>A round padded cushion on a low wooden base, where a cultivator sits cross-legged to gather qi. It raises the qi concentration of the room a little. Colonists with an awakened spirit root use it for the Cultivate work type.</description>
    <graphicData>
      <texPath>Things/Building/CVG/CultivationCushion</texPath>
      <graphicClass>Graphic_Single</graphicClass><drawRotated>false</drawRotated>
      <drawSize>(0.9, 0.9)</drawSize>
      <shadowData>
        <volume>(0.18, 0.23, 0.18)</volume>
      </shadowData>
    </graphicData>
    <designationCategory>CVG_Cultivation</designationCategory>
    <researchPrerequisites>
      <li>CVG_Research_QiBreathing</li>
    </researchPrerequisites>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Mass>3</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>1</Beauty>
      <Comfort>0.5</Comfort>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <pathCost>30</pathCost>
    <fillPercent>0.20</fillPercent>
    <socialPropernessMatters>true</socialPropernessMatters>
    <building>
      <isSittable>true</isSittable>
    </building>
    <uiIconOffset>(0, -0.05)</uiIconOffset>
    <uiOrder>2450</uiOrder>
    <comps>
      <li Class="CompProperties_AssignableToPawn">
        <drawUnownedAssignmentOverlay>false</drawUnownedAssignmentOverlay>
        <maxAssignedPawnsCount>1</maxAssignedPawnsCount>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivationSpot">
        <qiRegenFactor>5</qiRegenFactor>
        <sessionTicks>2500</sessionTicks>
      </li>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>2</qi>
        <element>CVG_Element_Wood</element>
      </li>
    </modExtensions>
  </ThingDef>
  <!-- Cultivation spot: free, like the meditation spot of Royalty; the first thing to mark the day of the Convergence.
       Final art: Things/Building/CVG/CultivationSpot (today the vanilla party spot, tinted). -->
  <ThingDef ParentName="BuildingBase">
    <defName>CVG_CultivationSpot</defName>
    <label>cultivation spot</label>
    <description>A circle of pebbles on bare ground where a cultivator sits to gather qi. It costs nothing, and it is how every sect began: the founder of the Formless Sword Sect cultivated thirty years on a flat rock before anyone built him a hall. A cushion or a platform gathers qi better.</description>
    <graphicData>
      <texPath>Things/Building/CVG/CultivationSpot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <statBases>
      <WorkToBuild>0</WorkToBuild>
    </statBases>
    <rotatable>false</rotatable>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <useHitPoints>False</useHitPoints>
    <designationCategory>CVG_Cultivation</designationCategory>
    <uiOrder>2440</uiOrder>
    <passability>Standable</passability>
    <drawGUIOverlay>true</drawGUIOverlay>
    <building>
      <isSittable>true</isSittable>
      <sowTag>SupportPlantsOnly</sowTag>
      <canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
      <ai_chillDestination>false</ai_chillDestination>
      <wakeDormantPawnsOnConstruction>false</wakeDormantPawnsOnConstruction>
    </building>
    <comps>
      <li Class="CompProperties_AssignableToPawn">
        <drawUnownedAssignmentOverlay>false</drawUnownedAssignmentOverlay>
        <maxAssignedPawnsCount>1</maxAssignedPawnsCount>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivationSpot">
        <qiRegenFactor>3</qiRegenFactor>
        <sessionTicks>2500</sessionTicks>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Meditation platform: stone, with quality; the best spot. Final art: Things/Building/CVG/MeditationPlatform
       (today the cushion texture, tinted grey). -->
  <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>CVG_MeditationPlatform</defName>
    <label>meditation platform</label>
    <description>A raised stone dais with a carved lotus on top, built where the qi of the room gathers. Its quality decides how well it holds the qi of the cultivator. The mountain temples of Jiuxiao have one hundred and eight of them on their terraces, one for each of the worldly troubles a monk must let go.</description>
    <graphicData>
      <texPath>Things/Building/CVG/MeditationPlatform</texPath>
      <graphicClass>Graphic_Single</graphicClass><drawRotated>false</drawRotated>
      <drawSize>(1.1, 1.1)</drawSize>
      <shadowData>
        <volume>(0.3, 0.3, 0.3)</volume>
      </shadowData>
    </graphicData>
    <designationCategory>CVG_Cultivation</designationCategory>
    <researchPrerequisites>
      <li>CVG_Research_QiBreathing</li>
    </researchPrerequisites>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0</Flammability>
      <Beauty>4</Beauty>
      <Comfort>0.6</Comfort>
    </statBases>
    <stuffCategories>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <costList>
      <CVG_SpiritStone>2</CVG_SpiritStone>
    </costList>
    <pathCost>30</pathCost>
    <fillPercent>0.25</fillPercent>
    <socialPropernessMatters>true</socialPropernessMatters>
    <building>
      <isSittable>true</isSittable>
    </building>
    <uiOrder>2460</uiOrder>
    <comps>
      <li Class="CompProperties_AssignableToPawn">
        <drawUnownedAssignmentOverlay>false</drawUnownedAssignmentOverlay>
        <maxAssignedPawnsCount>1</maxAssignedPawnsCount>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.DefModExtension_CultivationSpot">
        <qiRegenFactor>7</qiRegenFactor>
        <sessionTicks>2500</sessionTicks>
      </li>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>3</qi>
        <element>CVG_Element_Earth</element>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
