  </ThingDef>

  <AbilityDef ParentName="CVG_TechniqueBoltBase">
    <defName>CVG_Tech_FlyingSword</defName>
    <label>flying sword</label>
    <description>Send a sliver of sword qi flying like a blade on the wind. The disciples of the Sword Peak fought this way from a hundred paces, and the old stories of Shushan are full of swords that flew home to their masters.\n\nProjectile: 16 sharp damage (armor penetration 30%), scaled by realm and mastery.</description>
    <!-- Provisional icon of the path; own art: UI/Techniques/<defName>.png is picked up automatically. -->
    <iconPath>UI/Techniques/CVG_Tech_SwordQiSweep</iconPath>
    <verbProperties>
      <soundCast>Shot_NeedleGun</soundCast>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>10</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityTechniqueProjectile">
        <projectileDef>CVG_Projectile_FlyingSword</projectileDef>
        <castFleck>SparkFlash</castFleck>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_SwordHeart</manual>
        <tier>2</tier>
        <prerequisites>
          <li>CVG_Tech_EdgeOfTheHeart</li>
        </prerequisites>
        <minRealm>CVG_Realm_QiRefining</minRealm>
      </li>
    </modExtensions>
  </AbilityDef>
  <AbilityDef ParentName="CVG_TechniquePassiveBase">
    <defName>CVG_Tech_UnbreakableEdge</defName>
    <label>golden core of metal</label>
    <description>With a Golden Core, metal qi condenses into the body itself: skin rings like a struck blade and fire slides off it. The elders of the Golden Edge said a true master could be thrown into a forge and walk out tempered.\n\nPassive: sharp and heat armor +6% (more with realm and mastery).</description>
    <!-- Provisional icon of the path; own art: UI/Techniques/<defName>.png is picked up automatically. -->
    <iconPath>UI/Icons/Genes/CVG_RootElement_Metal</iconPath>
    <modExtensions>
