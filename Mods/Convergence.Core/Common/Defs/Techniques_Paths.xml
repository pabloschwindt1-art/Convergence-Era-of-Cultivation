          <li>CVG_Tech_SwordQiSweep</li>
        </prerequisites>
        <unlockCost>2</unlockCost>
        <passiveHediff>CVG_Passive_UnbreakableEdge</passiveHediff>
      </li>
    </modExtensions>
  </AbilityDef>
