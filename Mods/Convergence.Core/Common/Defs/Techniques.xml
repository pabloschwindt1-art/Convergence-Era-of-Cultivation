<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Cultivation techniques (M5). A technique is a vanilla AbilityDef with:
      - Convergence.TechniqueExtension (modExtensions): manual, tier (row), order, minRealm, prerequisites (ANY of them),
        requiresElement, unlockCost, masteryXpPerUse and optional realmPowerCurve / masteryPowerCurve.
      - Convergence.CompProperties_AbilityResourceCost: cost in the resource of the manual's path (qi).
      - Generic effect comps: TechniqueProjectile, TechniqueHediff, Cone (Convergence) or any vanilla comp.
    Power = realm x mastery x element affinity; it scales damage, shields and durations.
    Icons: provisional = the element icon of the root genes. Own art goes in UI/Techniques/<defName>.png and is picked up
    automatically (see docs/ARTE.md).
  -->

  <AbilityCategoryDef>
    <defName>CVG_Technique</defName>
    <displayOrder>310</displayOrder>
  </AbilityCategoryDef>

