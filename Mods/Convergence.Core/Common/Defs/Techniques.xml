  </Convergence.TechniqueManualDef>

  <!-- ================= Bases ================= -->
  <AbilityDef Name="CVG_TechniqueBase" Abstract="True">
    <category>CVG_Technique</category>
    <gizmoClass>Convergence.Command_Technique</gizmoClass>
    <writeCombatLog>true</writeCombatLog>
    <showPsycastEffects>false</showPsycastEffects>
    <stunTargetWhileCasting>false</stunTargetWhileCasting>
    <sendMessageOnCooldownComplete>false</sendMessageOnCooldownComplete>
  </AbilityDef>

  <!-- Elemental bolt: a projectile at a target. -->
  <AbilityDef Name="CVG_TechniqueBoltBase" ParentName="CVG_TechniqueBase" Abstract="True">
    <!-- Balance from VPE (ice spike / flameball): 12 neural heat at ~0.54/s = ~22 s; psyfocus 0.02-0.04 = 8-16 qi. -->
    <cooldownTicksRange>1330</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <comps>
      <!-- AI: not point-blank (melee is better there). -->
      <li Class="Convergence.CompProperties_AbilityAIConditions">
        <minDistance>2</minDistance>
      </li>
    </comps>
    <ai_IsIncendiary>false</ai_IsIncendiary>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>22.9</range>
      <warmupTime>0.5</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <soundCast>Shot_ChargeBlaster</soundCast>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <!-- Self cast (shields, buffs). -->
  <AbilityDef Name="CVG_TechniqueSelfBase" ParentName="CVG_TechniqueBase" Abstract="True">
    <targetRequired>false</targetRequired>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <aiCanUse>true</aiCanUse>
    <ai_IsOffensive>false</ai_IsOffensive>
    <ai_IsIncendiary>false</ai_IsIncendiary>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>0.9</range>
      <warmupTime>0.4</warmupTime>
      <requireLineOfSight>false</requireLineOfSight>
      <drawAimPie>false</drawAimPie>
      <targetParams>
        <canTargetSelf>true</canTargetSelf>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <!-- Cone (breath) from the caster. -->
  <AbilityDef Name="CVG_TechniqueConeBase" ParentName="CVG_TechniqueBase" Abstract="True">
    <!-- Balance from VPE (breathe flame / ice breath): psyfocus 0.08 = 32 qi, 26-36 heat = ~57 s, range 9.9-12.9. -->
    <cooldownTicksRange>3450</cooldownTicksRange>
    <aiCanUse>true</aiCanUse>
    <comps>
      <!-- AI: only worth its long cooldown against a group (or when desperate). -->
      <li Class="Convergence.CompProperties_AbilityAIConditions">
        <maxDistance>9.5</maxDistance>
        <minEnemies>2</minEnemies>
        <enemyRadius>3.5</enemyRadius>
        <desperateHealth>0.4</desperateHealth>
      </li>
    </comps>
    <ai_IsIncendiary>false</ai_IsIncendiary>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <range>9.9</range>
      <warmupTime>1</warmupTime>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>true</canTargetPawns>
        <canTargetBuildings>true</canTargetBuildings>
      </targetParams>
    </verbProperties>
  </AbilityDef>

  <!-- ================= Metal: Golden Edge Scripture ================= -->
  <AbilityDef ParentName="CVG_TechniqueBoltBase">
    <defName>CVG_Tech_MetalNeedle</defName>
    <label>golden needle</label>
    <description>Compress metal qi into a needle and shoot it. It pierces armor well.\n\nProjectile: 11 piercing damage (armor penetration 45%), scaled by realm and mastery.</description>
    <iconPath>UI/Techniques/CVG_Tech_MetalNeedle</iconPath>
    <verbProperties>
      <soundCast>Shot_NeedleGun</soundCast>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>10</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityTechniqueProjectile">
        <projectileDef>CVG_Projectile_MetalNeedle</projectileDef>
        <castFleck>SparkFlash</castFleck>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_GoldenEdge</manual>
        <tier>1</tier>
        <minRealm>CVG_Realm_QiRefining</minRealm>
      </li>
    </modExtensions>
  </AbilityDef>

  <AbilityDef ParentName="CVG_TechniqueSelfBase">
    <defName>CVG_Tech_QiShield</defName>
    <label>golden bell shield</label>
    <description>Spread qi around the body like a bronze bell. It absorbs damage until it breaks or fades.\n\nQi shield: absorbs 40 damage (scaled by realm and mastery) for about 30 seconds. It stops blows before armor does.</description>
    <iconPath>UI/Techniques/CVG_Tech_QiShield</iconPath>
    <verbProperties>
      <soundCast>EnergyShield_Reset</soundCast>
    </verbProperties>
    <cooldownTicksRange>2780</cooldownTicksRange>
    <comps>
      <li Class="Convergence.CompProperties_AbilityAIConditions">
        <!-- AI: raise it when enemies are close and it is not already up -->
        <minEnemies>1</minEnemies>
        <enemyRadius>15</enemyRadius>
        <skipIfHediff>CVG_QiShield</skipIfHediff>
      </li>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>8</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityTechniqueHediff">
        <hediffDef>CVG_QiShield</hediffDef>
        <onCaster>true</onCaster>
        <durationPowerExponent>0</durationPowerExponent>
        <fleckDef>PsycastAreaEffect</fleckDef>
        <fleckScale>1.5</fleckScale>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_GoldenEdge</manual>
        <tier>2</tier>
        <minRealm>CVG_Realm_QiRefining</minRealm>
        <prerequisites>
          <li>CVG_Tech_MetalNeedle</li>
        </prerequisites>
      </li>
    </modExtensions>
  </AbilityDef>

  <AbilityDef ParentName="CVG_TechniqueConeBase">
    <defName>CVG_Tech_SwordQiSweep</defName>
    <label>sword qi sweep</label>
    <description>Release a crescent of sword qi in front of you that cuts everything in its path.\n\nCone of 10 cells: 18 cutting damage, scaled by realm and mastery. Requires Foundation Establishment and a metal root.</description>
    <iconPath>UI/Techniques/CVG_Tech_SwordQiSweep</iconPath>
    <verbProperties>
      <soundCast>MeleeHit_Metal_Sharp</soundCast>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>32</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityCone">
        <range>9.9</range>
        <lineWidthEnd>4</lineWidthEnd>
        <damageDef>Cut</damageDef>
        <damAmount>18</damAmount>
        <armorPenetration>0.35</armorPenetration>
        <fleckDef>SparkFlash</fleckDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_GoldenEdge</manual>
        <tier>3</tier>
        <minRealm>CVG_Realm_Foundation</minRealm>
        <requiresElement>true</requiresElement>
        <unlockCost>2</unlockCost>
        <prerequisites>
          <li>CVG_Tech_MetalNeedle</li>
        </prerequisites>
      </li>
    </modExtensions>
  </AbilityDef>

  <!-- ================= Wood: Evergreen Sutra ================= -->
  <AbilityDef ParentName="CVG_TechniqueBoltBase">
    <defName>CVG_Tech_ThornBolt</defName>
    <label>venom thorn</label>
    <description>Grow a thorn of wood qi and fling it. Its sap is toxic.\n\nProjectile: 9 damage plus a toxic sting, scaled by realm and mastery.</description>
    <iconPath>UI/Techniques/CVG_Tech_ThornBolt</iconPath>
    <verbProperties>
      <soundCast>Bow_Small</soundCast>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>10</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityTechniqueProjectile">
        <projectileDef>CVG_Projectile_Thorn</projectileDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_EvergreenSutra</manual>
        <tier>1</tier>
        <minRealm>CVG_Realm_QiRefining</minRealm>
      </li>
    </modExtensions>
  </AbilityDef>

  <AbilityDef ParentName="CVG_TechniquePassiveBase">
    <defName>CVG_Tech_SpringRejuvenation</defName>
    <label>spring rejuvenation</label>
    <description>Living wood qi circulates through the body without pause, closing wounds as spring closes the scars of winter. In the old world, the Evergreen hermits healed by being near; here the body heals itself.\n\nPassive: injury healing +40% (more with realm and mastery).</description>
    <iconPath>UI/Techniques/CVG_Tech_SpringRejuvenation</iconPath>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_EvergreenSutra</manual>
        <tier>2</tier>
        <minRealm>CVG_Realm_QiRefining</minRealm>
        <prerequisites>
          <li>CVG_Tech_ThornBolt</li>
          <li>CVG_Tech_EvergreenBreath</li>
        </prerequisites>
        <passiveHediff>CVG_Passive_SpringRejuvenation</passiveHediff>
      </li>
    </modExtensions>
  </AbilityDef>

  <AbilityDef ParentName="CVG_TechniqueConeBase">
    <defName>CVG_Tech_ThornStorm</defName>
    <label>thorn storm</label>
    <description>A gust of poisoned thorns that sweeps the area in front of you.\n\nCone of 10 cells: 10 damage plus a toxic sting, scaled by realm and mastery. Requires Foundation Establishment and a wood root.</description>
    <iconPath>UI/Techniques/CVG_Tech_ThornStorm</iconPath>
    <verbProperties>
      <soundCast>Shot_Shotgun</soundCast>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>32</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityCone">
        <range>9.9</range>
        <lineWidthEnd>5</lineWidthEnd>
        <damageDef>ToxicBite</damageDef>
        <damAmount>10</damAmount>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_EvergreenSutra</manual>
        <tier>3</tier>
        <minRealm>CVG_Realm_Foundation</minRealm>
        <requiresElement>true</requiresElement>
        <unlockCost>2</unlockCost>
        <prerequisites>
          <li>CVG_Tech_ThornBolt</li>
        </prerequisites>
      </li>
    </modExtensions>
  </AbilityDef>

  <!-- ================= Water: Flowing Cloud Manual ================= -->
  <AbilityDef ParentName="CVG_TechniqueBoltBase">
    <defName>CVG_Tech_FrostShard</defName>
    <label>frost shard</label>
    <description>Freeze water qi into a shard of ice. It chills flesh to the bone.\n\nProjectile: 8 frostbite plus 4 blunt damage, scaled by realm and mastery.</description>
    <iconPath>UI/Techniques/CVG_Tech_FrostShard</iconPath>
    <verbProperties>
      <soundCast>Explosion_Stun</soundCast>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>10</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityTechniqueProjectile">
        <projectileDef>CVG_Projectile_FrostShard</projectileDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_FlowingCloud</manual>
        <tier>1</tier>
        <minRealm>CVG_Realm_QiRefining</minRealm>
      </li>
    </modExtensions>
  </AbilityDef>

  <!-- Swift step: vanilla jump (Verb_CastAbilityJump + PawnFlyer, both in Core). -->
  <AbilityDef ParentName="CVG_TechniqueBase">
    <defName>CVG_Tech_SwiftStep</defName>
    <label>swift cloud step</label>
    <description>Ride a wisp of qi and land up to 12 cells away in a heartbeat. The Wandering Path teaches it first, because a cultivator who cannot leave a fight never lives to choose one.</description>
    <iconPath>UI/Techniques/CVG_Tech_SwiftStep</iconPath>
    <cooldownTicksRange>900</cooldownTicksRange>
    <hostile>false</hostile>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted>
    <jobDef>CastJump</jobDef>
    <verbProperties>
      <soundCast>Longjump_Jump</soundCast>
      <verbClass>Verb_CastAbilityJump</verbClass>
      <label>swift step</label>
      <violent>false</violent>
      <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
      <warmupTime>0.2</warmupTime>
      <range>12.9</range>
      <requireLineOfSight>true</requireLineOfSight>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>8</cost>
      </li>
      <li Class="CompProperties_AbilityFleckOnTarget">
        <fleckDef>PsycastSkipFlashEntry</fleckDef>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_FlowingCloud</manual>
        <tier>2</tier>
        <minRealm>CVG_Realm_QiRefining</minRealm>
        <prerequisites>
          <li>CVG_Tech_FrostShard</li>
        </prerequisites>
      </li>
    </modExtensions>
  </AbilityDef>

  <AbilityDef ParentName="CVG_TechniqueConeBase">
    <defName>CVG_Tech_FrostBreath</defName>
    <label>frost breath</label>
    <description>Exhale a freezing mist. Those caught in it may freeze in place, and fires go out.\n\nCone of 10 cells: 12 frostbite damage and 40% chance to stun, scaled by realm and mastery. Requires Foundation Establishment and a water root.</description>
    <iconPath>UI/Techniques/CVG_Tech_FrostBreath</iconPath>
    <verbProperties>
      <soundCast>Explosion_Stun</soundCast>
    </verbProperties>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>32</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityCone">
        <range>9.9</range>
        <lineWidthEnd>5</lineWidthEnd>
        <damageDef>Frostbite</damageDef>
        <damAmount>12</damAmount>
        <stunChance>0.4</stunChance>
        <stunTicks>150</stunTicks>
        <extinguishFire>true</extinguishFire>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_FlowingCloud</manual>
        <tier>3</tier>
        <minRealm>CVG_Realm_Foundation</minRealm>
        <requiresElement>true</requiresElement>
        <unlockCost>2</unlockCost>
        <prerequisites>
          <li>CVG_Tech_FrostShard</li>
        </prerequisites>
      </li>
    </modExtensions>
  </AbilityDef>

  <!-- ================= Fire: Blazing Sun Art ================= -->
  <AbilityDef ParentName="CVG_TechniqueBoltBase">
    <defName>CVG_Tech_Fireball</defName>
    <label>fireball</label>
    <description>Condense fire qi into a ball that bursts on impact and sets things alight.\n\nBurst of radius 1.5: 10 burn damage, scaled by realm and mastery. Every fire disciple's first lesson, and the reason the Azure Peak keeps its practice yards far from the library.</description>
    <iconPath>UI/Techniques/CVG_Tech_Fireball</iconPath>
    <verbProperties>
      <soundCast>Shot_IncendiaryLauncher</soundCast>
    </verbProperties>
    <ai_IsIncendiary>true</ai_IsIncendiary>
    <comps>
      <li Class="Convergence.CompProperties_AbilityResourceCost">
        <cost>10</cost>
      </li>
      <li Class="Convergence.CompProperties_AbilityTechniqueProjectile">
        <projectileDef>CVG_Projectile_Fireball</projectileDef>
        <castFleck>FireGlow</castFleck>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.TechniqueExtension">
        <manual>CVG_Manual_BlazingSun</manual>
        <tier>1</tier>
        <minRealm>CVG_Realm_QiRefining</minRealm>
      </li>
    </modExtensions>
  </AbilityDef>

  <AbilityDef ParentName="CVG_TechniquePassiveBase">
    <defName>CVG_Tech_BlazingMeridians</defName>
    <label>blazing meridians</label>
    <description>Fire qi runs hot in the meridians at all times: the body strikes harder and moves faster than a mortal's. Zhurong, god of fire, was said to have veins of flame; the Blazing Sun Art lights a small copy of them.\n\nPassive: melee damage +8% and move speed +3% (more with realm and mastery).</description>
