  <!-- ================= Manuals (one per element) ================= -->
  <Convergence.TechniqueManualDef>
    <defName>CVG_Manual_GoldenEdge</defName>
    <label>Golden Edge Scripture</label>
    <description>A sword sect's foundation manual. It teaches to compress metal qi into needles as sharp as a blade and to wrap the body in a bell of qi that turns blows aside.</description>
    <path>CVG_Path_Qi</path>
    <requiredResearch>CVG_Research_TechniqueManuals</requiredResearch>
    <element>CVG_Element_Metal</element>
    <order>1</order>
    <openedByRoot>true</openedByRoot>
    <fromJadeSlips>false</fromJadeSlips>
    <cardTexPath>UI/Paths/CVG_Path_Metal</cardTexPath>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Metal</iconPath>
  </Convergence.TechniqueManualDef>
  <Convergence.TechniqueManualDef>
    <defName>CVG_Manual_EvergreenSutra</defName>
    <label>Evergreen Sutra</label>
    <description>A healer's sutra. Wood qi grows thorns that poison the enemy and springs of life that close wounds.</description>
    <path>CVG_Path_Qi</path>
    <requiredResearch>CVG_Research_TechniqueManuals</requiredResearch>
    <element>CVG_Element_Wood</element>
    <order>2</order>
    <openedByRoot>true</openedByRoot>
    <fromJadeSlips>false</fromJadeSlips>
    <cardTexPath>UI/Paths/CVG_Path_Wood</cardTexPath>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Wood</iconPath>
  </Convergence.TechniqueManualDef>
  <Convergence.TechniqueManualDef>
    <defName>CVG_Manual_FlowingCloud</defName>
    <label>Flowing Cloud Manual</label>
    <description>Water qi is patient and never where the enemy strikes. Frost shards, freezing breath and the light step that crosses a battlefield in a heartbeat.</description>
    <path>CVG_Path_Qi</path>
    <requiredResearch>CVG_Research_TechniqueManuals</requiredResearch>
    <element>CVG_Element_Water</element>
    <order>3</order>
    <openedByRoot>true</openedByRoot>
    <fromJadeSlips>false</fromJadeSlips>
    <cardTexPath>UI/Paths/CVG_Path_Water</cardTexPath>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Water</iconPath>
  </Convergence.TechniqueManualDef>
  <Convergence.TechniqueManualDef>
    <defName>CVG_Manual_BlazingSun</defName>
    <label>Blazing Sun Art</label>
    <description>Fire qi devours. Fireballs, burning meridians that drive the body beyond its limits and, for those born of fire, a sea of flames.</description>
    <path>CVG_Path_Qi</path>
    <requiredResearch>CVG_Research_TechniqueManuals</requiredResearch>
    <element>CVG_Element_Fire</element>
    <order>4</order>
    <openedByRoot>true</openedByRoot>
    <fromJadeSlips>false</fromJadeSlips>
    <cardTexPath>UI/Paths/CVG_Path_Fire</cardTexPath>
    <iconPath>UI/Icons/Genes/CVG_RootElement_Fire</iconPath>
  </Convergence.TechniqueManualDef>
  <Convergence.TechniqueManualDef>
    <defName>CVG_Manual_MountainHeart</defName>
    <label>Mountain Heart Method</label>
    <description>Earth qi is heavy and patient as a mountain. Stones that stun, a body hard as rock and the tremor that knocks a whole line down.</description>
    <path>CVG_Path_Qi</path>
    <requiredResearch>CVG_Research_TechniqueManuals</requiredResearch>
    <element>CVG_Element_Earth</element>
    <order>5</order>
    <openedByRoot>true</openedByRoot>
    <fromJadeSlips>false</fromJadeSlips>
