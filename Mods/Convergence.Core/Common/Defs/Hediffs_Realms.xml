        </statOffsets>
        <statFactors>
          <MoveSpeed>1.367</MoveSpeed>
          <MeleeDamageFactor>1.9</MeleeDamageFactor>
          <IncomingDamageFactor>0.617</IncomingDamageFactor>
          <LifespanFactor>2.0</LifespanFactor>
          <InjuryHealingFactor>1.5</InjuryHealingFactor>
          <ImmunityGainSpeed>1.3</ImmunityGainSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
