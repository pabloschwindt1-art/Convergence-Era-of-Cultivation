<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef Name="CVG_RealmHediffBase" Abstract="True">
    <hediffClass>Convergence.Hediff_CultivationRealm</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <minSeverity>1</minSeverity>
    <maxSeverity>4</maxSeverity>
    <defaultLabelColor>(0.55, 0.8, 1)</defaultLabelColor>
    <keepOnBodyPartRestoration>true</keepOnBodyPartRestoration>
  </HediffDef>

  <!--
    Severity = realm stage (1-4); RealmTracker sets it. Each realm MULTIPLIES power (speed, melee damage, damage taken,
    lifespan, armor): a Golden Core is several times stronger than a mortal. The foundation quality of the tracker
    scales every value (Hediff_CultivationRealm). Max qi / regen are offsets on top of the stat base (100 / 4 per hour).
  -->
  <HediffDef ParentName="CVG_RealmHediffBase">
    <defName>CVG_Hediff_QiRefining</defName>
    <label>Qi Refining</label>
    <description>This cultivator is in the Qi Refining realm: qi flows through the opened meridians and slowly strengthens the body.</description>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>stage 1</label>
        <statOffsets>
          <CVG_EnvironmentResistance>0.04</CVG_EnvironmentResistance>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.05</MoveSpeed>
          <MeleeDamageFactor>1.1</MeleeDamageFactor>
          <IncomingDamageFactor>0.95</IncomingDamageFactor>
          <LifespanFactor>1.2</LifespanFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>stage 2</label>
        <statOffsets>
          <CVG_EnvironmentResistance>0.06</CVG_EnvironmentResistance>
          <CVG_QiMax>20</CVG_QiMax>
          <CVG_QiRegen>1</CVG_QiRegen>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.083</MoveSpeed>
          <MeleeDamageFactor>1.167</MeleeDamageFactor>
          <IncomingDamageFactor>0.917</IncomingDamageFactor>
          <LifespanFactor>1.2</LifespanFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>stage 3</label>
        <statOffsets>
          <CVG_EnvironmentResistance>0.08</CVG_EnvironmentResistance>
          <CVG_QiMax>40</CVG_QiMax>
          <CVG_QiRegen>2</CVG_QiRegen>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.117</MoveSpeed>
          <MeleeDamageFactor>1.233</MeleeDamageFactor>
          <IncomingDamageFactor>0.883</IncomingDamageFactor>
          <LifespanFactor>1.2</LifespanFactor>
        </statFactors>
      </li>
      <li>
        <minSeverity>4</minSeverity>
        <label>stage 4</label>
        <statOffsets>
          <CVG_EnvironmentResistance>0.1</CVG_EnvironmentResistance>
          <CVG_QiMax>60</CVG_QiMax>
          <CVG_QiRegen>3</CVG_QiRegen>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.15</MoveSpeed>
          <MeleeDamageFactor>1.3</MeleeDamageFactor>
          <IncomingDamageFactor>0.85</IncomingDamageFactor>
          <LifespanFactor>1.2</LifespanFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef ParentName="CVG_RealmHediffBase">
