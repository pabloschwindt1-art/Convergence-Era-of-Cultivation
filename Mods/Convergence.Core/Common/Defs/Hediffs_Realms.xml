    <!-- Bigu (辟谷): from Foundation on, the body feeds more on qi and less on grain. -->
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <hungerRateFactor>0.9</hungerRateFactor>
        <label>stage 1</label>
        <statOffsets>
          <CVG_EnvironmentResistance>0.15</CVG_EnvironmentResistance>
          <CVG_QiMax>200</CVG_QiMax>
          <CVG_QiRegen>8</CVG_QiRegen>
          <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
          <PainShockThreshold>0.15</PainShockThreshold>
        </statOffsets>
        <statFactors>
          <MoveSpeed>1.3</MoveSpeed>
          <MeleeDamageFactor>1.7</MeleeDamageFactor>
          <IncomingDamageFactor>0.65</IncomingDamageFactor>
          <LifespanFactor>2.0</LifespanFactor>
          <InjuryHealingFactor>1.5</InjuryHealingFactor>
          <ImmunityGainSpeed>1.3</ImmunityGainSpeed>
