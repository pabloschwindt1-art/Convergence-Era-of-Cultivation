<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Raíz espiritual (sin Biotech). El grado se mapea a SpiritRootGradeDef.traitDegree. -->
  <TraitDef>
    <defName>CVG_SpiritRoot</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>inferior spirit root</label>
        <description>{PAWN_nameDef} carries a weak, muddy spirit root. It sleeps for now; when qi flows, the path will be slow but open.</description>
      </li>
      <li>
        <degree>2</degree>
        <label>common spirit root</label>
        <description>{PAWN_nameDef} carries an ordinary spirit root, like most sect disciples. It sleeps until qi flows.</description>
      </li>
      <li>
        <degree>3</degree>
        <label>superior spirit root</label>
        <description>{PAWN_nameDef} carries a bright, clear spirit root. Sects would fight over {PAWN_objective} once qi flows.</description>
      </li>
      <li>
        <degree>4</degree>
        <label>heavenly spirit root</label>
        <description>{PAWN_nameDef} carries a spirit root seen once in a generation. Heaven itself will watch {PAWN_objective} once qi flows.</description>
      </li>
    </degreeDatas>
  </TraitDef>

  <!-- Cuerpos especiales (体质). Latentes hasta la Convergencia. -->
  <TraitDef>
    <defName>CVG_Body_PureYin</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>pure yin body</label>
        <description>{PAWN_nameDef}'s body is steeped in pure yin. Once qi flows, {PAWN_pronoun} will cultivate far better at night and resonate with water and frost.</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.01</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_PureYang</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>pure yang body</label>
        <description>{PAWN_nameDef}'s body burns with pure yang. Once qi flows, {PAWN_pronoun} will cultivate far better by day and resonate with fire.</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>NightOwl</trait></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.01</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_NineYang</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>nine yang body</label>
        <description>Nine suns seem to burn inside {PAWN_nameDef}. A rare body of extreme fire: immense power, but the heat must be released through cultivation.</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>NightOwl</trait></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.003</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_CelestialSword</defName>
    <!-- Legacy: merged into CVG_Body_Sword degree 3 (celestial jade). No longer born; old saves convert on load (SwordBodyMigration). -->
    <forcedPassions>
      <li>Melee</li>
    </forcedPassions>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>celestial sword body</label>
        <description>{PAWN_nameDef} was born to wield the sword. Once qi flows, sword techniques will come to {PAWN_objective} as easily as breathing.</description>
        <skillGains>
          <Melee>3</Melee>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>Brawler</trait></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Immortal</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>immortal jade body</label>
        <description>{PAWN_nameDef}'s flesh is dense like jade. A body made for tempering: it endures wounds and heals quickly.</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li MayRequire="Ludeon.RimWorld.Biotech"><trait>Delicate</trait></li>
          <li><trait>Wimp</trait></li>
          <li><trait>Immunity</trait><degree>-1</degree></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.004</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Chaos</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>chaos body</label>
        <description>The rarest of bodies. {PAWN_nameDef} can draw on every element at once, but each step on the path is slower.</description>
        <skillGains>
          <Intellectual>2</Intellectual>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.001</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Venom</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>venom body</label>
        <description>Poison does not harm {PAWN_nameDef}; it feeds {PAWN_objective}. Others instinctively keep their distance.</description>
        <skillGains>
          <Medicine>2</Medicine>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>Immunity</trait><degree>-1</degree></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.004</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_InnateSpirit</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>innate spirit body</label>
        <description>{PAWN_nameDef} has no spirit root, yet the body itself breathes the world. {PAWN_pronoun} can walk the path of the body far beyond other mortals.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.6</CVG_BodyTemperingSpeed>
        </statFactors>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.01</chance>
        <rootlessOnly>true</rootlessOnly>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Steel</defName>
    <forcedPassions>
      <li>Melee</li>
    </forcedPassions>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>steel body</label>
        <description>{PAWN_nameDef}'s skin and bones are hard as metal. {PAWN_pronoun} cannot gather qi, but {PAWN_possessive} body can be tempered into a weapon.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.3</CVG_BodyTemperingSpeed>
        </statFactors>
        <skillGains>
          <Melee>2</Melee>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li MayRequire="Ludeon.RimWorld.Biotech"><trait>Delicate</trait></li>
          <li><trait>Wimp</trait></li>
          <li><trait>Immunity</trait><degree>-1</degree></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.015</chance>
        <rootlessOnly>true</rootlessOnly>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Tribulation</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>tribulation body</label>
        <description>Heavenly lightning does not destroy {PAWN_nameDef}; it forges {PAWN_objective}. {PAWN_pronoun} cannot gather qi, but tribulations make {PAWN_objective} stronger.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.2</CVG_BodyTemperingSpeed>
        </statFactors>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.005</chance>
        <rootlessOnly>true</rootlessOnly>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Sword</defName>
    <!-- Sword Body (Formless Sword Sect): one progressive constitution, valid with or without a spirit root. Degrees 0-3 are symbolic
         stages of refinement, not implanted materials: iron, cold steel, star-iron, celestial jade. Born only at degree 0 (iron); the
         higher grades come from the sect's tempering ritual. Saves keep working: the old single-degree sword body was degree 0. -->
    <forcedPassions>
      <li>Melee</li>
    </forcedPassions>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>iron sword body</label>
        <degree>0</degree>
        <description>{PAWN_nameDef}'s body has the temper of rough iron: bones that hold a stance, hands that do not shake on the hilt. The Formless Sword calls it the first refinement, the one every disciple must earn before the blade will listen.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.2</CVG_BodyTemperingSpeed>
        </statFactors>
        <statOffsets>
          <CVG_ProjectileDeflectChance>0.06</CVG_ProjectileDeflectChance>
        </statOffsets>
        <skillGains>
          <Melee>2</Melee>
        </skillGains>
      </li>
      <li>
        <label>cold steel sword body</label>
        <degree>1</degree>
        <description>The iron in {PAWN_nameDef} has been quenched: {PAWN_pronoun} is calm when the blood runs hot, and the cut comes before the anger. The elders say cold steel does not hate its enemy; it simply does not miss.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.25</CVG_BodyTemperingSpeed>
        </statFactors>
        <statOffsets>
          <CVG_ProjectileDeflectChance>0.10</CVG_ProjectileDeflectChance>
          <MeleeHitChance>2</MeleeHitChance>
        </statOffsets>
        <skillGains>
          <Melee>3</Melee>
        </skillGains>
      </li>
      <li>
        <label>star-iron sword body</label>
        <degree>2</degree>
        <description>Star-iron is the metal that falls burning from the sky and does not melt. {PAWN_nameDef}'s body has reached that grade: {PAWN_pronoun} feels a strike before it lands, as the Sword Saint Qing Feng felt the mountain before he split it.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.3</CVG_BodyTemperingSpeed>
        </statFactors>
        <statOffsets>
          <CVG_ProjectileDeflectChance>0.15</CVG_ProjectileDeflectChance>
          <MeleeHitChance>3</MeleeHitChance>
          <MeleeDodgeChance>2</MeleeDodgeChance>
        </statOffsets>
        <skillGains>
          <Melee>4</Melee>
        </skillGains>
      </li>
      <li>
        <label>celestial jade sword body</label>
        <degree>3</degree>
        <description>Jade is the stone that keeps the memory of heaven. In {PAWN_nameDef} the blade and the body have become one intent: the Formless Sword records perhaps one such disciple in a generation, and its masters bow to them as to a living sword.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.4</CVG_BodyTemperingSpeed>
        </statFactors>
        <statOffsets>
          <CVG_ProjectileDeflectChance>0.20</CVG_ProjectileDeflectChance>
          <MeleeHitChance>4</MeleeHitChance>
          <MeleeDodgeChance>4</MeleeDodgeChance>
        </statOffsets>
        <skillGains>
          <Melee>5</Melee>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>Brawler</trait></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.008</chance>
      </li>
    </modExtensions>
  </TraitDef>

</Defs>
