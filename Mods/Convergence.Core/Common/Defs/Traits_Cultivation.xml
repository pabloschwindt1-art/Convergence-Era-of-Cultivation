<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Raíz espiritual (sin Biotech). El grado se mapea a SpiritRootGradeDef.traitDegree. -->
  <TraitDef>
    <defName>CVG_SpiritRoot</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <degree>1</degree>
        <label>inferior spirit root</label>
        <description>{PAWN_nameDef} carries a weak, muddy spirit root. It sleeps for now; when qi flows, the path will be slow but open.</description>
      </li>
      <li>
        <degree>2</degree>
        <label>common spirit root</label>
        <description>{PAWN_nameDef} carries an ordinary spirit root, like most sect disciples. It sleeps until qi flows.</description>
      </li>
      <li>
        <degree>3</degree>
        <label>superior spirit root</label>
        <description>{PAWN_nameDef} carries a bright, clear spirit root. Sects would fight over {PAWN_objective} once qi flows.</description>
      </li>
      <li>
        <degree>4</degree>
        <label>heavenly spirit root</label>
        <description>{PAWN_nameDef} carries a spirit root seen once in a generation. Heaven itself will watch {PAWN_objective} once qi flows.</description>
      </li>
    </degreeDatas>
  </TraitDef>

  <!-- Cuerpos especiales (体质). Latentes hasta la Convergencia. -->
  <TraitDef>
    <defName>CVG_Body_PureYin</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>pure yin body</label>
        <description>{PAWN_nameDef}'s body is steeped in pure yin. Once qi flows, {PAWN_pronoun} will cultivate far better at night and resonate with water and frost.</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.01</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_PureYang</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>pure yang body</label>
        <description>{PAWN_nameDef}'s body burns with pure yang. Once qi flows, {PAWN_pronoun} will cultivate far better by day and resonate with fire.</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>NightOwl</trait></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.01</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_NineYang</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>nine yang body</label>
        <description>Nine suns seem to burn inside {PAWN_nameDef}. A rare body of extreme fire: immense power, but the heat must be released through cultivation.</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>NightOwl</trait></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.003</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_CelestialSword</defName>
    <forcedPassions>
      <li>Melee</li>
    </forcedPassions>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>celestial sword body</label>
        <description>{PAWN_nameDef} was born to wield the sword. Once qi flows, sword techniques will come to {PAWN_objective} as easily as breathing.</description>
        <skillGains>
          <Melee>3</Melee>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>Brawler</trait></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.004</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Immortal</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>immortal jade body</label>
        <description>{PAWN_nameDef}'s flesh is dense like jade. A body made for tempering: it endures wounds and heals quickly.</description>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li MayRequire="Ludeon.RimWorld.Biotech"><trait>Delicate</trait></li>
          <li><trait>Wimp</trait></li>
          <li><trait>Immunity</trait><degree>-1</degree></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.004</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Chaos</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>chaos body</label>
        <description>The rarest of bodies. {PAWN_nameDef} can draw on every element at once, but each step on the path is slower.</description>
        <skillGains>
          <Intellectual>2</Intellectual>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.001</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Venom</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>venom body</label>
        <description>Poison does not harm {PAWN_nameDef}; it feeds {PAWN_objective}. Others instinctively keep their distance.</description>
        <skillGains>
          <Medicine>2</Medicine>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>Immunity</trait><degree>-1</degree></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.004</chance>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_InnateSpirit</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>innate spirit body</label>
        <description>{PAWN_nameDef} has no spirit root, yet the body itself breathes the world. {PAWN_pronoun} can walk the path of the body far beyond other mortals.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.6</CVG_BodyTemperingSpeed>
        </statFactors>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.01</chance>
        <rootlessOnly>true</rootlessOnly>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Steel</defName>
    <forcedPassions>
      <li>Melee</li>
    </forcedPassions>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>steel body</label>
        <description>{PAWN_nameDef}'s skin and bones are hard as metal. {PAWN_pronoun} cannot gather qi, but {PAWN_possessive} body can be tempered into a weapon.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.3</CVG_BodyTemperingSpeed>
        </statFactors>
        <skillGains>
          <Melee>2</Melee>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li MayRequire="Ludeon.RimWorld.Biotech"><trait>Delicate</trait></li>
          <li><trait>Wimp</trait></li>
          <li><trait>Immunity</trait><degree>-1</degree></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.015</chance>
        <rootlessOnly>true</rootlessOnly>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Tribulation</defName>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>tribulation body</label>
        <description>Heavenly lightning does not destroy {PAWN_nameDef}; it forges {PAWN_objective}. {PAWN_pronoun} cannot gather qi, but tribulations make {PAWN_objective} stronger.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.2</CVG_BodyTemperingSpeed>
        </statFactors>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.005</chance>
        <rootlessOnly>true</rootlessOnly>
      </li>
    </modExtensions>
  </TraitDef>
  <TraitDef>
    <defName>CVG_Body_Sword</defName>
    <forcedPassions>
      <li>Melee</li>
    </forcedPassions>
    <commonality>0</commonality>
    <exclusionTags>
      <li>CVG_SpecialBody</li>
    </exclusionTags>
    <degreeDatas>
      <li>
        <label>sword body</label>
        <description>{PAWN_nameDef}'s body is the blade. {PAWN_pronoun} cannot gather qi, but every strike cuts like a tempered sword.</description>
        <statFactors>
          <CVG_BodyTemperingSpeed>1.3</CVG_BodyTemperingSpeed>
        </statFactors>
        <skillGains>
          <Melee>3</Melee>
        </skillGains>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="Convergence.DefModExtension_TraitConflicts">
        <conflicts>
          <li><trait>Brawler</trait></li>
        </conflicts>
      </li>
      <li Class="Convergence.DefModExtension_SpecialBody">
        <chance>0.008</chance>
        <rootlessOnly>true</rootlessOnly>
      </li>
    </modExtensions>
  </TraitDef>

</Defs>
