  <!-- Las comunes (tier 1) también para los colonos iniciales: el filtro vanilla de PlayerColony solo pide Offworld y casi
       ninguna tier 1 la tiene; se suma CVG_Cultivation (solo la llevan las tier 1) a ese filtro. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/FactionDef[defName="PlayerColony"]/backstoryFilters/li[categories/li="Offworld"]/categories</xpath>
    <value>
      <li>CVG_Cultivation</li>
    </value>
  </Operation>
</Patch>
