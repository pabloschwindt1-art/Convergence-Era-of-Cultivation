<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Weapon tag CVG_Sword on every sword (vanilla and Convergence): sword sects arm themselves with it (PawnKindDef weaponTags) and
       projectile deflection needs it in hand (StatPart_RequiresMeleeWeapon). Each block does nothing if its weapon does not exist. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="MeleeWeapon_Gladius"]</xpath>
    <match Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="MeleeWeapon_Gladius"]/weaponTags</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="MeleeWeapon_Gladius"]/weaponTags</xpath>
        <value><li>CVG_Sword</li></value>
      </match>
      <nomatch Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="MeleeWeapon_Gladius"]</xpath>
        <value><weaponTags><li>CVG_Sword</li></weaponTags></value>
      </nomatch>
    </match>
  </Operation>
