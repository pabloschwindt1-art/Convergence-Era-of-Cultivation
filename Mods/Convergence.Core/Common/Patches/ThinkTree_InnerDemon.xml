    <xpath>Defs/ThinkTreeDef[defName="MentalStateNonCritical"]//li[@Class="ThinkNode_ConditionalMentalStates"][states/li="Wander_Psychotic"]/states</xpath>
    <value>
      <li>CVG_InnerDemon</li>
    </value>
  </Operation>
</Patch>
