    <xpath>Defs/HediffDef[defName="CVG_Hediff_Foundation"]/stages/li[1]/statFactors</xpath>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/HediffDef[defName="CVG_Hediff_Foundation"]/stages/li[1]</xpath><value><statFactors /></value></nomatch>
