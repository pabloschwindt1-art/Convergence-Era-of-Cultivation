    <iconPath>UI/Icons/Genes/CVG_RootGrade_Common</iconPath>
    <displayOrderInCategory>2</displayOrderInCategory>
    <biostatCpx>2</biostatCpx>
    <exclusionTags>
      <li>CVG_RootGrade</li>
    </exclusionTags>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpiritRoot">
        <grade>CVG_RootGrade_Common</grade>
      </li>
    </modExtensions>
  </GeneDef>
