<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <GeneCategoryDef>
    <defName>CVG_Cultivation</defName>
    <label>cultivation</label>
    <displayPriorityInXenotype>50</displayPriorityInXenotype>
  </GeneCategoryDef>

  <GeneDef Name="CVG_GeneBase" Abstract="True">
    <displayCategory>CVG_Cultivation</displayCategory>
    <biostatCpx>1</biostatCpx>
  </GeneDef>

  <!-- Calidad de la raíz: solo una (exclusionTag). -->
  <GeneDef ParentName="CVG_GeneBase">
    <defName>CVG_Gene_RootGrade_Inferior</defName>
    <label>inferior root</label>
    <description>A weak, muddy spirit root, carried in the blood. Dormant until qi flows.</description>
    <iconPath>UI/Icons/Genes/CVG_RootGrade_Inferior</iconPath>
    <displayOrderInCategory>1</displayOrderInCategory>
    <biostatCpx>1</biostatCpx>
    <exclusionTags>
      <li>CVG_RootGrade</li>
    </exclusionTags>
    <modExtensions>
      <li Class="Convergence.DefModExtension_SpiritRoot">
        <grade>CVG_RootGrade_Inferior</grade>
      </li>
    </modExtensions>
  </GeneDef>
  <GeneDef ParentName="CVG_GeneBase">
    <defName>CVG_Gene_RootGrade_Common</defName>
    <label>common root</label>
