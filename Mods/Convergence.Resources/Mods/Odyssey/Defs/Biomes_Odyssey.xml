<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Odyssey biome materials: lava field, glowforest and scarlands. -->

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_FireCrystal</defName>
    <tradeability>Sellable</tradeability>
    <label>fire spirit crystal</label>
    <description>Crystal grown in rivers of lava. Barely conducts heat; armor and walls of it shrug off fire. The refining furnace burns it as fuel. Anything built from it raises the qi concentration around it a little.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_FireCrystal</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>18</MarketValue>
      <Mass>0.5</Mass>
      <StuffPower_Armor_Sharp>0.7</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.35</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>1.6</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <BluntDamageMultiplier>1.4</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <deepCommonality>0</deepCommonality>
    <stuffProps>
      <categories>
        <li>Stony</li>
      </categories>
      <commonality>0.01</commonality>
      <color>(235,120,60)</color>
      <constructEffect>ConstructMetal</constructEffect>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <statOffsets>
        <Beauty>8</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>0.8</MaxHitPoints>
        <Beauty>3</Beauty>
        <Flammability>0</Flammability>
        <WorkToBuild>3</WorkToBuild>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <modExtensions>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>0.04</qi>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RockBase">
    <defName>CVG_MineableFireCrystal</defName>
    <label>fire crystal vein</label>
    <description>Crystal veins born of lava, found only in lava fields. They stay warm for years after they are cut, and forges of the south keep one in the hearth to wake the fire.</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(70,50,45)</color>
      <colorTwo>(255,130,60)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>3000</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>CVG_FireCrystal</mineableThing>
      <mineableYield>20</mineableYield>
      <mineableScatterCommonality>0.05</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>2~6</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
    <modExtensions>
      <li Class="Convergence.DefModExtension_ConvergenceMineable">
        <eventLumps>2~3</eventLumps>
        <eventLumpSize>2~6</eventLumpSize>
        <allowedBiomes>
          <li>LavaField</li>
        </allowedBiomes>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_MoonJade</defName>
    <tradeability>Sellable</tradeability>
    <label>moon jade</label>
    <description>Pale blue jade from the glowing forests; it shines softly at night. Beautiful, and said to calm the restless dead. Anything built from it raises the qi concentration around it a little.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_MoonJade</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>12</MarketValue>
      <Mass>0.5</Mass>
      <StuffPower_Armor_Sharp>0.9</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.45</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.6</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <BluntDamageMultiplier>1.4</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <deepCommonality>0</deepCommonality>
    <stuffProps>
      <categories>
        <li>Stony</li>
      </categories>
      <commonality>0.01</commonality>
      <color>(150,190,220)</color>
      <constructEffect>ConstructMetal</constructEffect>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <statOffsets>
        <Beauty>14</Beauty>
      </statOffsets>
      <statFactors>
        <MaxHitPoints>0.7</MaxHitPoints>
        <Beauty>3.5</Beauty>
        <WorkToBuild>4</WorkToBuild>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <modExtensions>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>0.05</qi>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RockBase">
    <defName>CVG_MineableMoonJade</defName>
    <label>moon jade vein</label>
    <description>Jade that glows like the moon, found only in glowforests. It is said to grow wherever moonlight fell on the same stone for a thousand nights.</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(60,70,90)</color>
      <colorTwo>(170,220,255)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>2500</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>CVG_MoonJade</mineableThing>
      <mineableYield>25</mineableYield>
      <mineableScatterCommonality>0.05</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>2~6</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
    <modExtensions>
      <li Class="Convergence.DefModExtension_ConvergenceMineable">
        <eventLumps>2~3</eventLumps>
        <eventLumpSize>2~6</eventLumpSize>
        <allowedBiomes>
          <li>Glowforest</li>
        </allowedBiomes>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_BloodJade</defName>
    <tradeability>Sellable</tradeability>
    <label>blood jade</label>
    <description>Red jade from the scarred lands, veined like flesh. The demonic path treasures it; walls of it feel uneasy. Anything built from it raises the qi concentration around it a little.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_BloodJade</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>ChunkRock_Drop</soundInteract>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>14</MarketValue>
      <Mass>0.5</Mass>
      <StuffPower_Armor_Sharp>0.95</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.5</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.6</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <BluntDamageMultiplier>1.4</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>false</smeltable>
    <deepCommonality>0</deepCommonality>
    <stuffProps>
      <categories>
        <li>Stony</li>
      </categories>
      <commonality>0.01</commonality>
      <color>(150,40,45)</color>
      <constructEffect>ConstructMetal</constructEffect>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <statFactors>
        <MaxHitPoints>0.8</MaxHitPoints>
