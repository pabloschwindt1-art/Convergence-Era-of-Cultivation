  <ThingDef ParentName="RockBase">
    <defName>CVG_MineableSpiritCrystal</defName>
    <label>spirit crystal vein</label>
    <description>Rock threaded with spirit crystal that grew when qi returned. Miners of Jiuxiao leave an offering of rice before breaking a seam, so the crystal does not remember who took it.</description>
    <graphicData>
      <texPath>Things/Building/Linked/RockFlecked_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <color>(90,100,110)</color>
      <colorTwo>(170,240,255)</colorTwo>
    </graphicData>
    <statBases>
      <MaxHitPoints>2000</MaxHitPoints>
    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>CVG_SpiritCrystal</mineableThing>
      <mineableYield>30</mineableYield>
      <mineableScatterCommonality>0.02</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>2~5</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
    <modExtensions>
      <li Class="Convergence.DefModExtension_ConvergenceMineable">
        <eventLumps>1~2</eventLumps>
        <eventLumpSize>2~5</eventLumpSize>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="RockBase">
