<Defs>
  <!-- Spirit materials (docs/modulos/RECURSOS.md). Stuff: walls, doors, furniture and weapons can be made of them. -->

  <ThingDef ParentName="ResourceBase">
    <defName>CVG_SpiritSteel</defName>
    <label>spirit steel</label>
    <description>Steel tempered with spirit stones in a refining furnace. Stronger and lighter than steel, and it carries qi well: the metal of choice for sect weapons and gates.</description>
    <graphicData>
      <texPath>Things/Item/Resource/CVG_SpiritSteel</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <soundInteract>Metal_Drop</soundInteract>
    <soundDrop>Metal_Drop</soundDrop>
    <useHitPoints>false</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <statBases>
      <MarketValue>6</MarketValue>
      <Mass>0.4</Mass>
      <StuffPower_Armor_Sharp>1.1</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.55</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>0.75</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
      <SharpDamageMultiplier>1.2</SharpDamageMultiplier>
      <BluntDamageMultiplier>1.1</BluntDamageMultiplier>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <burnableByRecipe>false</burnableByRecipe>
    <smeltable>true</smeltable>
    <deepCommonality>0</deepCommonality>
    <stuffProps>
      <categories>
        <li>Metallic</li>
      </categories>
      <appearance>Metal</appearance>
      <commonality>0.02</commonality>
      <constructEffect>ConstructMetal</constructEffect>
      <isAirtight>true</isAirtight>
      <color>(120,150,175)</color>
      <soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
      <statFactors>
        <MaxHitPoints>1.6</MaxHitPoints>
        <Beauty>1.5</Beauty>
        <Flammability>0.2</Flammability>
        <WorkToMake>1.3</WorkToMake>
        <WorkToBuild>1.3</WorkToBuild>
        <MeleeWeapon_CooldownMultiplier>0.9</MeleeWeapon_CooldownMultiplier>
      </statFactors>
    </stuffProps>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
  </ThingDef>

