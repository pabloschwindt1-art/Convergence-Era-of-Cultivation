    </statBases>
    <building>
      <isResourceRock>true</isResourceRock>
      <mineableThing>CVG_ColdIron</mineableThing>
      <mineableYield>30</mineableYield>
      <mineableScatterCommonality>0.01</mineableScatterCommonality>
      <mineableScatterLumpSizeRange>2~4</mineableScatterLumpSizeRange>
      <veinMineable>true</veinMineable>
    </building>
    <modExtensions>
      <li Class="Convergence.DefModExtension_ConvergenceMineable">
        <eventLumps>1~1</eventLumps>
        <eventLumpSize>2~4</eventLumpSize>
        <maxTileTemperature>0</maxTileTemperature>
        <allowedBiomes>
          <li>Tundra</li>
          <li>IceSheet</li>
          <li>SeaIce</li>
          <li>BorealForest</li>
          <li>ColdBog</li>
        </allowedBiomes>
      </li>
    </modExtensions>
