<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Wuxia natural rocks (structure copied from vanilla Granite/Marble: rock, smoothed rock, chunk, blocks, cut recipe, tile).
       Rough/hewn/smooth terrains are generated by the game. DefModExtension_WuxiaRock: the "Wuxia world" setting prefers them.
       DefModExtension_FengShui on the blocks: walls, columns and furniture of this stone add qi to the room (Core). -->

  <ThingDef ParentName="UglyRockBase" Name="CVG_TribulationRockBase">
    <defName>CVG_TribulationRock</defName>
    <label>ten tribulations rock</label>
    <description>Black rock scarred by ancient lightning. Extremely hard; walls of it shrug off almost anything.</description>
    <graphicData>
      <color>(58,60,72)</color>
    </graphicData>
    <statBases>
      <MaxHitPoints>1300</MaxHitPoints>
      <Beauty>-1</Beauty>
    </statBases>
    <building>
      <mineableThing>CVG_ChunkTribulationRock</mineableThing>
      <mineableDropChance>0.25</mineableDropChance>
      <smoothedThing>CVG_SmoothedTribulationRock</smoothedThing>
    </building>
    <modExtensions>
      <li Class="Convergence.DefModExtension_WuxiaRock" />
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="CVG_TribulationRockBase">
    <defName>CVG_SmoothedTribulationRock</defName>
    <label>smoothed ten tribulations rock</label>
    <description>Black rock scarred by ancient lightning. Extremely hard; walls of it shrug off almost anything. Polished to a flat, smooth surface.</description>
    <uiIconPath>Things/Building/Linked/WallSmooth_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Linked/RockSmooth_Atlas</texPath>
    </graphicData>
    <statBases>
      <Beauty>1</Beauty>
      <MarketValue>7</MarketValue>
    </statBases>
    <building>
      <isNaturalRock>false</isNaturalRock>
      <canBuildNonEdificesUnder>true</canBuildNonEdificesUnder>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <paintable>true</paintable>
      <smoothedThing />
    </building>
    <saveCompressible>false</saveCompressible>
    <repairEffect>Repair</repairEffect>
  </ThingDef>

  <ThingDef ParentName="ChunkRockBase">
    <defName>CVG_ChunkTribulationRock</defName>
    <label>ten tribulations rock chunk</label>
    <graphicData>
      <color>(58,60,72)</color>
    </graphicData>
    <statBases>
      <Mass>30</Mass>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <butcherProducts>
      <CVG_BlocksTribulationRock>20</CVG_BlocksTribulationRock>
    </butcherProducts>
  </ThingDef>

  <ThingDef ParentName="StoneBlocksBase">
    <defName>CVG_BlocksTribulationRock</defName>
    <label>ten tribulations rock blocks</label>
    <description>Blocks of ten tribulations rock. Black rock scarred by ancient lightning. Extremely hard; walls of it shrug off almost anything.</description>
    <graphicData>
      <color>(58,60,72)</color>
    </graphicData>
    <statBases>
      <Mass>1.5</Mass>
      <SharpDamageMultiplier>0.7</SharpDamageMultiplier>
      <MarketValue>1.3</MarketValue>
    </statBases>
    <stuffProps>
      <color>(58,60,72)</color>
      <soundImpactBullet>BulletImpact_Ground</soundImpactBullet>
      <soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
      <soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
      <soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Stone</soundImpactMelee>
      <stuffAdjective>ten tribulations rock</stuffAdjective>
      <statFactors>
        <MaxHitPoints>2.3</MaxHitPoints>
        <WorkToBuild>7.5</WorkToBuild>
        <WorkToMake>1.4</WorkToMake>
        <Beauty>1.0</Beauty>
      </statFactors>
      <canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
    </stuffProps>
    <modExtensions>
      <li Class="Convergence.DefModExtension_FengShui">
        <qi>0.03</qi>
      </li>
    </modExtensions>
  </ThingDef>

  <RecipeDef ParentName="MakeStoneBlocksBase">
    <defName>CVG_Make_StoneBlocksTribulationRock</defName>
    <label>make ten tribulations rock blocks</label>
    <description>Cuts ten tribulations rock chunks into usable blocks.</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>CVG_ChunkTribulationRock</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>CVG_ChunkTribulationRock</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <CVG_BlocksTribulationRock>20</CVG_BlocksTribulationRock>
    </products>
  </RecipeDef>

