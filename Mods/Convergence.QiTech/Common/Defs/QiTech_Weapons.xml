<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Qi-Tech v0.2: induction weapons (docs/modulos/QITECH.md). The spirit grade goes on the WEAPON, not on the bullet:
    Core SpiritGradeUtility.AttackGrade reads DamageInfo.Weapon (the equipped gun or the turretGunDef).
    No spirit root needed: any colonist with the research and the crafting skill makes and fires them.
    weaponTags/tradeTags are our own (Inherit="False") so no vanilla pawnkind or trader picks them up: raids and early game stay as they were.
    Art by the user: Things/Item/Equipment/CVG/QiTech/<Name> (weapons) and Things/Projectile/CVG/QiTech/<Name> (bolts, pointing north).
  -->

  <ThingDef ParentName="BaseBullet">
    <defName>CVG_QT_InductionBolt</defName>
    <label>induction bolt</label>
    <graphicData>
      <texPath>Things/Projectile/CVG/QiTech/InductionBolt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <armorPenetrationBase>0.18</armorPenetrationBase>
      <speed>80</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>CVG_QT_FocusedBolt</defName>
    <label>concentrated induction bolt</label>
    <graphicData>
      <texPath>Things/Projectile/CVG/QiTech/ConcentratedBolt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>24</damageAmountBase>
      <armorPenetrationBase>0.38</armorPenetrationBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>100</speed>
    </projectile>
  </ThingDef>

  <!-- ================= Induction rifle (grade 1) ================= -->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>CVG_QT_InductionRifle</defName>
    <label>qi induction rifle</label>
    <description>An assault rifle whose barrel is wound with spirit-silver coils that drink a breath of qi from a spirit stone cell and wrap it around each round. The shot carries just enough qi to bite through the faint aura of a Qi Refining cultivator. The engineers of the Rim built the first ones after watching their bullets slide off a barefoot girl who had been meditating for three months; they called it a calibration problem.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <!-- Two variants (_a plain, _b ornate): each rifle picks one at random and keeps it. -->
      <texPath>Things/Item/Equipment/CVG/QiTech/InductionRifle</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <!-- No random tilt on the ground: it wraps the graphic in Graphic_RandomRotated, and Character Editor
           (TextureTool.GetGraphicForRandom) expects a bare Graphic_Random and throws every frame. -->
      <onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>40000</WorkToMake>
      <Mass>3.8</Mass>
      <AccuracyTouch>0.60</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.55</AccuracyLong>
      <RangedWeapon_Cooldown>1.70</RangedWeapon_Cooldown>
    </statBases>
    <equippedStatOffsets>
      <CVG_ChaosResistance>0.05</CVG_ChaosResistance>
    </equippedStatOffsets>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>7</ComponentIndustrial>
      <CVG_SpiritStone>10</CVG_SpiritStone>
    </costList>
    <recipeMaker>
      <researchPrerequisite>CVG_Research_QiWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>500</displayPriority>
    </recipeMaker>
    <weaponTags Inherit="False">
      <li>CVG_QiTechGun</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>CVG_QiTechWeapon</li>
    </tradeTags>
    <weaponClasses>
      <li>RangedLight</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CVG_QT_InductionBolt</defaultProjectile>
        <warmupTime>1.1</warmupTime>
        <range>30.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <comps>
      <li Class="Convergence.CompProperties_SpiritGrade">
        <grade>1</grade>
      </li>
    </comps>
  </ThingDef>

  <!-- ================= Focused rifle (grade 2) ================= -->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>CVG_QT_FocusedRifle</defName>
    <label>concentrated qi rifle</label>
    <description>A long precision rifle that shapes an induced qi field into a needle around a high-velocity slug. It hits as hard as a spirit weapon forged in a sect furnace, and it is fired by people who have never felt their own dantian. The Heavenly Cauldron Pavilion bought the first crate at auction and sold the second to a sect elder who wanted to know what was killing his disciples.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/CVG/QiTech/FocusedRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Rifle</soundInteract>
    <statBases>
      <WorkToMake>50000</WorkToMake>
      <Mass>6</Mass>
      <AccuracyTouch>0.50</AccuracyTouch>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.86</AccuracyMedium>
      <AccuracyLong>0.88</AccuracyLong>
      <RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
    </statBases>
    <equippedStatOffsets>
      <CVG_ChaosResistance>0.05</CVG_ChaosResistance>
    </equippedStatOffsets>
    <costList>
      <Plasteel>45</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
      <CVG_SpiritStone>22</CVG_SpiritStone>
    </costList>
    <recipeMaker>
      <researchPrerequisite>CVG_Research_QiWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>501</displayPriority>
    </recipeMaker>
    <weaponTags Inherit="False">
      <li>CVG_QiTechGun</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>CVG_QiTechWeapon</li>
    </tradeTags>
    <weaponClasses>
      <li>LongShots</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CVG_QT_FocusedBolt</defaultProjectile>
        <warmupTime>3.2</warmupTime>
        <range>44.9</range>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <comps>
      <li Class="Convergence.CompProperties_SpiritGrade">
        <grade>2</grade>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>CVG_QT_CompressedBolt</defName>
    <label>compressed qi bolt</label>
    <graphicData>
      <texPath>Things/Projectile/CVG/QiTech/CompressedBolt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.0</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>30</damageAmountBase>
      <armorPenetrationBase>0.5</armorPenetrationBase>
      <stoppingPower>2</stoppingPower>
      <speed>110</speed>
    </projectile>
  </ThingDef>
  <!-- ================= Compression cannon (grade 3) ================= -->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>CVG_QT_CompressionCannon</defName>
    <label>qi compression cannon</label>
    <description>A heavy handheld cannon that crushes a full spirit stone's worth of qi into a single bolt, as dense as the core a cultivator spends a century condensing. It is rare, expensive and hard to keep cool, and every shot rings in the sky like a small tribulation. The sects call it "the stolen core"; the engineers who made it prefer not to say what they measured to get it right.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/CVG/QiTech/CompressionCannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <statBases>
      <WorkToMake>70000</WorkToMake>
      <Mass>9</Mass>
      <AccuracyTouch>0.60</AccuracyTouch>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.80</AccuracyMedium>
      <AccuracyLong>0.70</AccuracyLong>
      <RangedWeapon_Cooldown>3.2</RangedWeapon_Cooldown>
    </statBases>
    <equippedStatOffsets>
      <CVG_ChaosResistance>0.05</CVG_ChaosResistance>
      <MoveSpeed>-0.25</MoveSpeed>
    </equippedStatOffsets>
    <costList>
      <Plasteel>110</Plasteel>
      <ComponentSpacer>6</ComponentSpacer>
      <CVG_SpiritStone>48</CVG_SpiritStone>
    </costList>
    <recipeMaker>
      <researchPrerequisite>CVG_Research_QiAdvancedMilitary</researchPrerequisite>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>FabricationBench</li>
      </recipeUsers>
      <displayPriority>502</displayPriority>
    </recipeMaker>
    <weaponTags Inherit="False">
      <li>CVG_QiTechGun</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>CVG_QiTechWeapon</li>
    </tradeTags>
    <weaponClasses>
      <li>RangedHeavy</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CVG_QT_CompressedBolt</defaultProjectile>
        <warmupTime>2.4</warmupTime>
        <range>34.9</range>
        <soundCast>ChargeLance_Fire</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
      </li>
    </verbs>
    <comps>
      <li Class="Convergence.CompProperties_SpiritGrade">
        <grade>3</grade>
      </li>
    </comps>
  </ThingDef>

  <!-- ================= Qi shotgun and qi pistol (grade 1, plan de fusion 2026-10-23) =================
       The vanilla pump shotgun and autopistol with part of the steel swapped for spirit stones and jade. Made at the qi forge
       right after qi forging (they have to arrive before the first cultivator raids), and tempered there to higher grades. -->
  <ThingDef ParentName="BaseBullet">
    <defName>CVG_QT_QiShot</defName>
    <label>qi shot</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Shotgun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(120,240,230)</color>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <stoppingPower>3</stoppingPower>
      <armorPenetrationBase>0.16</armorPenetrationBase>
      <speed>60</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>CVG_QT_QiShotgun</defName>
    <label>qi shotgun</label>
    <description>A pump shotgun whose shells are packed around a sliver of spirit stone, so every pellet leaves the barrel wrapped in a thread of qi. Close up it hits a Qi Refining cultivator like any mortal, which is to say very hard. Colonists on the Rim started calling it "the doorkeeper" after the first sect disciple who tried to walk through one.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/CVG/QiTech/QiShotgun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <soundInteract>Interact_Shotgun</soundInteract>
    <statBases>
      <WorkToMake>14000</WorkToMake>
      <Mass>3.4</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.87</AccuracyShort>
      <AccuracyMedium>0.77</AccuracyMedium>
      <AccuracyLong>0.64</AccuracyLong>
      <RangedWeapon_Cooldown>1.25</RangedWeapon_Cooldown>
    </statBases>
    <equippedStatOffsets>
      <CVG_ChaosResistance>0.05</CVG_ChaosResistance>
    </equippedStatOffsets>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <CVG_SpiritStone>8</CVG_SpiritStone>
      <Jade>4</Jade>
    </costList>
    <recipeMaker>
      <researchPrerequisites>
        <li>CVG_Research_QiForging</li>
        <li>Gunsmithing</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>CVG_QiForge</li>
      </recipeUsers>
      <displayPriority>200</displayPriority>
    </recipeMaker>
    <weaponTags Inherit="False">
      <li>CVG_QiTechGun</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>CVG_QiTechWeapon</li>
    </tradeTags>
    <weaponClasses>
      <li>Ranged</li>
      <li>ShortShots</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CVG_QT_QiShot</defaultProjectile>
        <warmupTime>0.9</warmupTime>
        <range>15.9</range>
        <soundCast>Shot_Shotgun</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <comps>
      <li Class="Convergence.CompProperties_SpiritGrade">
        <grade>1</grade>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>CVG_QT_QiPistolBullet</defName>
    <label>qi pistol bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(120,240,230)</color>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>11</damageAmountBase>
      <speed>60</speed>
    </projectile>
  </ThingDef>

  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>CVG_QT_QiPistol</defName>
    <label>qi pistol</label>
    <description>A blowback pistol with a qi coil around the barrel and a spirit stone chip in the grip. It is the first weapon most mortals of the Rim ever held that could make a cultivator bleed, and it is cheap enough that some settlements hand them out at weddings. Sect disciples sneer at it until the third shot.</description>
    <techLevel>Industrial</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/CVG/QiTech/QiPistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <soundInteract>Interact_Autopistol</soundInteract>
    <statBases>
      <WorkToMake>6000</WorkToMake>
      <Mass>1.2</Mass>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.42</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
    </statBases>
    <equippedStatOffsets>
      <CVG_ChaosResistance>0.05</CVG_ChaosResistance>
    </equippedStatOffsets>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
      <CVG_SpiritStone>5</CVG_SpiritStone>
      <Jade>2</Jade>
    </costList>
    <recipeMaker>
      <researchPrerequisites>
        <li>CVG_Research_QiForging</li>
        <li>BlowbackOperation</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>CVG_QiForge</li>
      </recipeUsers>
      <displayPriority>201</displayPriority>
    </recipeMaker>
    <weaponTags Inherit="False">
      <li>CVG_QiTechGun</li>
    </weaponTags>
    <tradeTags Inherit="False">
      <li>CVG_QiTechWeapon</li>
    </tradeTags>
    <weaponClasses>
      <li>Ranged</li>
      <li>RangedLight</li>
    </weaponClasses>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>CVG_QT_QiPistolBullet</defaultProjectile>
        <warmupTime>0.3</warmupTime>
        <range>25.9</range>
        <soundCast>Shot_Autopistol</soundCast>
        <soundCastTail>GunTail_Light</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <comps>
      <li Class="Convergence.CompProperties_SpiritGrade">
        <grade>1</grade>
      </li>
    </comps>
  </ThingDef>
</Defs>
