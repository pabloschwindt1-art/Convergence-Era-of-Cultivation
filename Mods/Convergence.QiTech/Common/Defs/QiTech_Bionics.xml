  <HediffDef ParentName="AddedBodyPartBase">
    <defName>CVG_QiBionicEye</defName>
    <label>qi bionic eye</label>
    <labelNoun>a qi bionic eye</labelNoun>
    <description>An installed qi bionic eye. A bionic eye whose lens is cut from spirit jade, so it sees a little better than the mortal model and catches the faint glow of qi in the air. Engineers of the Rim insist it reads light, not qi; the people who wear one stop arguing after their first night watch.</description>
    <descriptionHyperlinks>
      <ThingDef>CVG_QiBionicEye</ThingDef>
    </descriptionHyperlinks>
    <spawnThingOnRemoved>CVG_QiBionicEye</spawnThingOnRemoved>
    <addedPartProps>
      <solid>true</solid>
      <partEfficiency>1.375</partEfficiency>
      <betterThanNatural>true</betterThanNatural>
    </addedPartProps>
    <stages>
      <li>
        <statOffsets>
          <CVG_CelestialDissonance>0.25</CVG_CelestialDissonance>
        </statOffsets>
      </li>
    </stages>
    <renderNodeProperties>
      <li Class="PawnRenderNodeProperties_Eye">
        <workerClass>PawnRenderNodeWorker_HediffEye</workerClass>
        <texPath>Things/Pawn/Wounds/BionicEye</texPath>
        <parentTagDef>Head</parentTagDef>
        <drawSize>0.15</drawSize>
        <color>(120,240,230)</color>
        <drawData>
          <defaultData>
            <layer>56</layer>
            <offset>(0, 0, -0.25)</offset>
          </defaultData>
          <dataWest>
            <flip>true</flip>
          </dataWest>
        </drawData>
      </li>
    </renderNodeProperties>
  </HediffDef>

