<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Qi-Tech v0.2: qi turrets (docs/modulos/QITECH.md). Wuxia version of the vanilla autocannon turret (same abstract parent, AutocannonTurret):
    Building_TurretGun + grid power (CompPowerTrader, flickable, breakdowns) + spirit stones as fuel per shot (consumeFuelPerShot, the
    Formations pattern: fuelConsumptionRate 0 + consumeFuelOnlyWhenUsed). Vanilla stops firing without power (Active), switched off
    (FlickedOff -> PowerOn false) or without fuel for one shot (Verb.Available). The spirit grade is on the turret gun (turretGunDef).
    Art: Things/Building/CVG/QiTech/<Name> (base), <Name>_Top (points east, centred on its pivot), <Name>_MenuIcon; made by tools/art/recorte/turret_sheet.py.
  -->

  <!-- ================= Qi induction turret (grade 2) ================= -->
  <ThingDef ParentName="BaseWeaponTurret">
    <defName>CVG_QT_Gun_InductionTurret</defName>
    <label>qi induction turret emitter</label>
    <description>The emitter of a qi induction turret: three coils that fold the qi of a spirit stone around each bolt. The coils are wound by hand with silver wire, the way a talisman master draws a seal, and no two turrets sound quite the same when they fire.</description>
    <graphicData>
      <!-- Points east like Ludeon _Top art (TurretTop.ArtworkRotation -90); centred on its pivot (the qi core) by tools/art/recorte/turret_sheet.py -->
      <texPath>Things/Building/CVG/QiTech/QiInductionTurret_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.50</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
      <RangedWeapon_Cooldown>3.0</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>10</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>CVG_QT_InductionBolt</defaultProjectile>
        <warmupTime>0</warmupTime>
        <range>30.9</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
        <soundCast>Shot_ChargeRifle</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>0</muzzleFlashScale>
        <consumeFuelPerShot>0.1</consumeFuelPerShot>
      </li>
    </verbs>
    <comps>
      <li Class="Convergence.CompProperties_SpiritGrade">
        <grade>2</grade>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="AutocannonTurret">
    <defName>CVG_QT_InductionTurret</defName>
    <designationCategory>CVG_QiTech</designationCategory>
    <label>qi induction turret</label>
    <description>A heavy automatic turret that runs on two things at once: current from the grid and qi from the spirit stones in its capacitor. Each burst spends a little stone, and without either the coils go cold. No cultivator is needed to man it. The first ones guarded the warehouses where the Rim stored the spirit stones it bought from the sects, which the sects considered a joke in poor taste.</description>
    <uiIconPath>Things/Building/CVG/QiTech/QiInductionTurret_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/CVG/QiTech/QiInductionTurret</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.96,1.96)</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
      <damageData><rect>(0.2,0.2,1.6,1.6)</rect></damageData>
    </graphicData>
    <statBases>
      <MaxHitPoints>320</MaxHitPoints>
      <WorkToBuild>12000</WorkToBuild>
      <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
    </statBases>
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <CVG_SpiritStone>20</CVG_SpiritStone>
    </costList>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>450</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0</fuelConsumptionRate>
        <fuelCapacity>12</fuelCapacity>
        <fuelFilter><thingDefs><li>CVG_SpiritStone</li></thingDefs></fuelFilter>
        <initialFuelPercent>0</initialFuelPercent>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
        <autoRefuelPercent>0.4</autoRefuelPercent>
        <fuelLabel>Spirit stones</fuelLabel>
        <fuelGizmoLabel>Spirit stones</fuelGizmoLabel>
      </li>
    </comps>
    <building>
      <combatPower>90</combatPower>
      <turretGunDef>CVG_QT_Gun_InductionTurret</turretGunDef>
      <turretTopOffset>(0,0)</turretTopOffset>
      <turretBurstCooldownTime>3.0</turretBurstCooldownTime>
    </building>
    <uiOrder>2560</uiOrder>
    <modExtensions>
      <!-- Projectile and flash leave from the tip of the barrel, not from the centre of the base (Convergence.QiTech.TurretMuzzle). -->
      <li Class="Convergence.QiTech.DefModExtension_TurretMuzzle">
        <muzzleDistance>1.15</muzzleDistance>
        <flashScale>9</flashScale>
      </li>
    </modExtensions>
    <researchPrerequisites><li>CVG_Research_QiDefense</li></researchPrerequisites>
  </ThingDef>

</Defs>
