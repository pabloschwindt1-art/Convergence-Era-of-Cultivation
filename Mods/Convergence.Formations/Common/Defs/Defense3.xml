<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Daily defense (docs/modulos/DIA_A_DIA.md, part 5): the wuxia version of the barricade, sandbags and spike trap. Art provisional
       (tinted vanilla); final art Things/Building/CVG/Defense/<Name>. No electricity, no research. -->

  <ThingDef ParentName="BuildingBase">
    <defName>CVG_BambooPalisade</defName>
    <label>bamboo palisade</label>
    <description>A row of sharpened bamboo stakes lashed to a crossbar and driven into the ground at a slant. It stops animals and slows raiders, gives low cover, and burns like a torch. The frontier outposts of the Wandering Path put one up in an afternoon and take it down in a morning, which is the whole point.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <replaceTags><li>Barricade</li></replaceTags>
    <graphicData>
      <texPath>Things/Building/CVG/Defense/BambooPalisade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <linkType>Basic</linkType>
      <linkFlags><li>Barricades</li></linkFlags>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Barricade_MenuIcon</uiIconPath>
    <uiIconScale>1.2</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>42</pathCost>
    <pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.55</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <uiOrder>11</uiOrder>
    <statBases>
      <MaxHitPoints>240</MaxHitPoints>
      <Beauty>-1</Beauty>
      <WorkToBuild>200</WorkToBuild>
      <Flammability>1.3</Flammability>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <isFence>true</isFence>
      <isPlaceOverableWall>true</isPlaceOverableWall>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Barricade_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
      <paintable>true</paintable>
    </building>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <stuffCategories><li>Woody</li></stuffCategories>
    <defaultStuff MayRequire="prospero1088.convergence.resources">CVG_Bamboo</defaultStuff>
    <costStuffCount>4</costStuffCount>
    <filthLeaving>Filth_RubbleBuilding</filthLeaving>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>CVG_Formations</designationCategory>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <modExtensions><li Class="Convergence.DefModExtension_NoStuffTint" /></modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>CVG_LowStoneWall</defName>
    <label>low stone wall</label>
    <description>A knee-to-waist wall of fitted stones without mortar, the kind that divides terraced fields and, when it must, defenders from attackers. Tougher than a palisade and impossible to burn. The old sect walls were all low walls once; they grew taller only after the Iron Calamity taught everyone what a low wall cannot stop.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <replaceTags><li>Barricade</li></replaceTags>
    <graphicData>
      <texPath>Things/Building/CVG/Defense/LowStoneWall</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <linkType>Basic</linkType>
      <linkFlags><li>Barricades</li></linkFlags>
    </graphicData>
    <uiIconPath>Things/Building/Linked/Barricade_MenuIcon</uiIconPath>
    <uiIconScale>1.2</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <pathCost>42</pathCost>
    <pathCostIgnoreRepeat>true</pathCostIgnoreRepeat>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.6</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <uiOrder>12</uiOrder>
    <statBases>
      <MaxHitPoints>420</MaxHitPoints>
      <Beauty>1</Beauty>
      <WorkToBuild>450</WorkToBuild>
      <Flammability>0</Flammability>
    </statBases>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <isInert>true</isInert>
      <isFence>true</isFence>
      <isPlaceOverableWall>true</isPlaceOverableWall>
      <blueprintGraphicData>
        <texPath>Things/Building/Linked/Barricade_Blueprint_Atlas</texPath>
      </blueprintGraphicData>
    </building>
    <drawStyleCategory>Defenses</drawStyleCategory>
    <stuffCategories><li>Stony</li></stuffCategories>
    <costStuffCount>6</costStuffCount>
    <filthLeaving>Filth_RubbleRock</filthLeaving>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>CVG_Formations</designationCategory>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <modExtensions><li Class="Convergence.DefModExtension_NoStuffTint" /></modExtensions>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>CVG_QiSpikeTrap</defName>
    <label>qi spike trap</label>
    <description>A fragment of a killing formation cut into a stone slab and buried under a sprinkling of earth. When anyone who does not carry the sect's mark steps on it, spikes of hardened qi rise from the ground. It cannot be placed next to another trap, and it does not need to be reset: the formation remembers.</description>
    <thingClass>Building_TrapDamager</thingClass>
    <graphicData>
      <texPath>Things/Building/CVG/Defense/QiSpikeTrap</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <damageData><rect>(0,0,1,0.15)</rect></damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <stealable>false</stealable>
    <minifiedDef>MinifiedThing</minifiedDef>
    <uiOrder>31</uiOrder>
    <thingCategories><li>BuildingsSecurity</li></thingCategories>
    <statBases>
      <Mass>3</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <WorkToBuild>3000</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-6</Beauty>
      <Cleanliness>-2</Cleanliness>
      <TrapMeleeDamage>110</TrapMeleeDamage>
      <TrapSpringChance>1.0</TrapSpringChance>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>30</costStuffCount>
    <costList>
      <CVG_SpiritStone>2</CVG_SpiritStone>
    </costList>
    <designationCategory>CVG_Formations</designationCategory>
    <building>
      <isTrap>true</isTrap>
      <trapDestroyOnSpring>false</trapDestroyOnSpring>
      <trapDamageCategory>Sharp</trapDamageCategory>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_NeverAdjacentTrap</li>
    </placeWorkers>
  </ThingDef>
</Defs>
