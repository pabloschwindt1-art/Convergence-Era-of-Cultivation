    <altitudeLayer>Building</altitudeLayer>
    <stealable>false</stealable>
    <rotatable>false</rotatable>
    <statBases>
      <MaxHitPoints>160</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <WorkToBuild>3500</WorkToBuild>
      <Mass>40</Mass>
      <Beauty>3</Beauty>
