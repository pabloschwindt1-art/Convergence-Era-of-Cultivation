  <ThingDef ParentName="BaseWeaponTurret">
    <defName>CVG_Gun_RuneCrossbow</defName>
    <label>rune crossbow</label>
    <description>A crossbow whose bolts are carved with runes. Rune-carved bolts were first used by wandering cultivators who could not afford a flying sword.</description>
    <graphicData>
      <texPath>Things/Building/CVG/Formations/RuneCrossbowTurret_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.6</AccuracyMedium>
      <AccuracyLong>0.45</AccuracyLong>
      <RangedWeapon_Cooldown>3.2</RangedWeapon_Cooldown>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>5</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>Arrow_Recurve</defaultProjectile>
        <warmupTime>0.8</warmupTime>
        <range>30.9</range>
        <soundCast>Bow_Recurve</soundCast>
        <muzzleFlashScale>0</muzzleFlashScale>
        <consumeFuelPerShot>0.1</consumeFuelPerShot>
      </li>
    </verbs>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>CVG_RuneCrossbowTurret</defName>
    <label>rune crossbow turret</label>
    <description>A classic fixed defense: a big crossbow with rune-carved bolts. Needs no power; it uses a little spirit stone for the runes. Border villages of Jiuxiao raised these crossbows on towers long before any sect offered them protection. Each bolt carries the rune of a family that has long since died, and the runes still remember how to fly straight.</description>
    <thingClass>Building_TurretGun</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <drawHighlight>true</drawHighlight>
    <drawHighlightOnlyForHostile>true</drawHighlightOnlyForHostile>
    <uiIconPath>Things/Building/CVG/Formations/RuneCrossbowTurret_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/CVG/Formations/RuneCrossbowTurret</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <drawSize>(1.131,1.131)</drawSize>
      <damageData><rect>(0.2,0.2,0.6,0.6)</rect></damageData>
