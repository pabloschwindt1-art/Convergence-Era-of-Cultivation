<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Spirit fish join the freshwater/saltwater tables of every biome that has them. -->
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/BiomeDef/fishTypes/freshwater_Uncommon</xpath>
    <value><CVG_Fish_GoldenCarp>0.25</CVG_Fish_GoldenCarp><CVG_Fish_JadeEel>0.2</CVG_Fish_JadeEel><CVG_Fish_ThunderFish>0.15</CVG_Fish_ThunderFish><CVG_Fish_SilkKoi>0.04</CVG_Fish_SilkKoi></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/BiomeDef/fishTypes/saltwater_Uncommon</xpath>
    <value><CVG_Fish_MoonFish>0.25</CVG_Fish_MoonFish><CVG_Fish_JadeEel>0.1</CVG_Fish_JadeEel></value>
  </Operation>
  <!-- Rare catches: spirit jade slips, jade and spirit stones (Resources adds its own spirit pearls). -->
  <Operation Class="PatchOperationAdd">
    <success>Always</success>
    <xpath>/Defs/ThingSetMakerDef[starts-with(defName, "RareFishingCatches")]/root/options</xpath>
    <value>
      <li>
        <weight>1.5</weight>
        <thingSetMaker Class="ThingSetMaker_Count">
          <fixedParams>
            <countRange>1~3</countRange>
            <qualityGenerator>Reward</qualityGenerator>
            <filter>
              <thingDefs>
                <li>Jade</li>
                <li>CVG_JadeSlip</li>
                <li>CVG_SpiritStone</li>
              </thingDefs>
            </filter>
          </fixedParams>
        </thingSetMaker>
      </li>
    </value>
  </Operation>
</Patch>
