<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Spirit weapons (docs/modulos/DEFENSA.md §1): made of spirit metal at the spirit forge, with spirit grade (CompSpiritGrade). -->

  <StuffCategoryDef>
    <defName>CVG_SpiritMetal</defName>
    <label>spirit metal</label>
  </StuffCategoryDef>

  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>CVG_SpiritSword</defName>
    <label>spirit sword</label>
    <description>A straight sword folded with qi in a spirit forge. The Formless Sword Sect teaches that every jian is a distant descendant of Ganjiang and Moye, the twin swords of legend, and that a sword without qi is only a long knife. Spirit grade 2: it cuts through the protection of cultivators of lower realms.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/CVG/SpiritSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>CVG_SpiritWeapon</li>
    </weaponTags>
    <costStuffCount>80</costStuffCount>
    <costList>
      <CVG_SpiritStone>5</CVG_SpiritStone>
    </costList>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>1.8</Mass>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <stuffCategories>
      <li>CVG_SpiritMetal</li>
    </stuffCategories>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>26</power>
        <cooldownTime>2.5</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>26</power>
        <cooldownTime>2.5</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>CVG_SpiritForge</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <displayPriority>400</displayPriority>
    </recipeMaker>
    <comps>
      <li Class="Convergence.CompProperties_SpiritGrade">
        <grade>2</grade>
      </li>
    </comps>
  </ThingDef>

