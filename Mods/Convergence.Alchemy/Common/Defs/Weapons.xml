<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Spirit weapons (docs/modulos/DEFENSA.md §1): made of spirit metal at the spirit forge, with spirit grade (CompSpiritGrade). -->

  <StuffCategoryDef>
    <defName>CVG_SpiritMetal</defName>
    <label>spirit metal</label>
  </StuffCategoryDef>

  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>CVG_FlyingSword</defName>
    <label>flying sword</label>
    <description>A treasure sword that answers its master's qi. In Jiuxiao the immortals rode such swords between the nine heavens, and the Formless Sword Sect says the art was lost in the Great Rupture. The art of riding it was lost in the Great Rupture; today it is wielded in hand. Spirit grade 3.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/CVG/FlyingSword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>CVG_SpiritWeapon</li>
    </weaponTags>
    <costStuffCount>80</costStuffCount>
    <costList>
      <CVG_SpiritStone>5</CVG_SpiritStone>
    </costList>
    <statBases>
      <WorkToMake>40000</WorkToMake>
      <Mass>1.8</Mass>
    </statBases>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <stuffCategories>
      <li>CVG_SpiritMetal</li>
    </stuffCategories>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>12</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>34</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>34</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>CVG_SpiritForge</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <displayPriority>400</displayPriority>
    </recipeMaker>
    <comps>
      <li Class="Convergence.CompProperties_SpiritGrade">
        <grade>3</grade>
      </li>
    </comps>
    <modExtensions>
      <li Class="Convergence.DefModExtension_RequiresWorkbenchLevel">
        <level>3</level>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
