<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Arena estelar (Resources): base delicada de la píldora de fundación, en lugar de la plata y la mitad de las hierbas. -->
  <RecipeDef>
    <defName>CVG_MakeFoundationPill_StarSand</defName>
    <label>refine foundation pill with star sand</label>
    <description>Refine a foundation pill on a base of star sand instead of silver, with half the spirit herbs. The alchemists of the Heavenly Cauldron Pavilion keep this recipe for their own disciples: the sand binds the herbs so tightly that nothing of their qi is lost in the fire.</description>
    <jobString>Refining a foundation pill with star sand.</jobString>
    <workAmount>1200</workAmount>
    <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
    <workSkill>Intellectual</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_CookMeal</soundWorking>
    <recipeUsers><li>CVG_AlchemyFurnace</li></recipeUsers>
    <ingredients>
      <li>
        <filter><thingDefs><li>CVG_StarSand</li></thingDefs></filter>
        <count>1</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_SpiritHerb</li></thingDefs></filter>
        <count>2</count>
      </li>
      <li>
        <filter><thingDefs><li>CVG_SpiritStone</li></thingDefs></filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>CVG_StarSand</li><li>CVG_SpiritHerb</li><li>CVG_SpiritStone</li></thingDefs></fixedIngredientFilter>
    <products><CVG_FoundationPill>1</CVG_FoundationPill></products>
    <displayPriority>2205</displayPriority>
  </RecipeDef>
</Defs>
