<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Pills with quality (CompQuality: alchemist skill + furnace level) and toxicity. -->

  <ThingDef ParentName="MakeableDrugPillBase">
    <defName>CVG_TemperingPill</defName>
    <label>tempering pill</label>
    <description>Beast blood and spirit herbs boiled down into a red pill. The body cultivators of the Sect of Nine Temperings swallow one before beating their flesh against stone, saying that the blood remembers what the bones forget. Restores blood qi for the path of the body (more with higher quality). Every pill leaves some toxicity.</description>
    <graphicData>
      <texPath>Things/Item/CVG/TemperingPill</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawRotated>false</drawRotated>
      <drawSize>0.7</drawSize>
    </graphicData>
    <rotatable>false</rotatable>
    <socialPropernessMatters>false</socialPropernessMatters>
    <stackLimit>25</stackLimit>
    <statBases>
      <WorkToMake>1500</WorkToMake>
      <MarketValue>30</MarketValue>
      <Mass>0.01</Mass>
      <Flammability>0.7</Flammability>
    </statBases>
    <techLevel>Neolithic</techLevel>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <outcomeDoers>
        <li Class="Convergence.IngestionOutcomeDoer_GainResourceByQuality">
          <path>CVG_Path_Body</path>
          <amount>40</amount>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>CVG_PillToxicity</hediffDef>
          <severity>0.12</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>CVG_AlchemyFurnace</li>
      </recipeUsers>
      <skillRequirements>
        <Intellectual>4</Intellectual>
      </skillRequirements>
      <displayPriority>2210</displayPriority>
      <bulkRecipeCount>4</bulkRecipeCount>
    </recipeMaker>
    <costList>
      <CVG_SpiritHerb>3</CVG_SpiritHerb>
      <CVG_BeastBlood>1</CVG_BeastBlood>
      <CVG_SpiritStone>1</CVG_SpiritStone>
    </costList>
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <!-- Drug policies and Ideology drug precepts (pattern: vanilla Penoxycyline). No addiction or overdose: CVG_PillToxicity is the brake. -->
      <li Class="CompProperties_Drug">
        <listOrder>1100</listOrder>
        <overdoseSeverityOffset>0~0</overdoseSeverityOffset>
      </li>
    </comps>
  </ThingDef>

