  <!-- Pill toxicity: every pill adds some; it fades slowly. Abusing pills stalls cultivation and sickens the body. -->
  <HediffDef>
    <defName>CVG_PillToxicity</defName>
    <label>pill toxicity</label>
    <description>Residue of medicinal power that the body has not yet cleansed. The alchemists of Jiuxiao call it pill poison and say that more cultivators were killed by greed for pills than by tribulations. A little is harmless; too many pills in a row clog the meridians.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7, 0.9, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <initialSeverity>0.1</initialSeverity>
    <maxSeverity>1.2</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.08</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>trace</label>
        <becomeVisible>false</becomeVisible>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>buildup</label>
        <statFactors>
          <CVG_CultivationSpeed>0.85</CVG_CultivationSpeed>
        </statFactors>
        <statOffsets>
          <MentalBreakThreshold>0.03</MentalBreakThreshold>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>poisoning</label>
        <painOffset>0.1</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
        <statFactors>
          <CVG_CultivationSpeed>0.6</CVG_CultivationSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>1.0</minSeverity>
        <label>severe poisoning</label>
        <painOffset>0.25</painOffset>
        <vomitMtbDays>0.5</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.35</offset>
          </li>
        </capMods>
        <statFactors>
          <CVG_CultivationSpeed>0.3</CVG_CultivationSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
